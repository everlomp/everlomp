#!/usr/bin/env python3
import ipaddress
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

AUTH_LOG = Path("/var/log/everlomp/phpmyadmin-auth.log")
KOPIA_AUTH_LOG = Path("/var/log/nginx/kopia-auth.log")
KOPIA_BAN_FILE = Path("/etc/nginx/everlomp-kopia-bans.conf")
STATE_FILE = Path("/home/everlomp/bruteforce-bans.json")
VHOST_CONF = Path("/usr/local/lsws/conf/vhosts/GPTCP1/vhconf.conf")

BEGIN_MARKER = "# BEGIN everlomp phpmyadmin brute-force guard"
END_MARKER = "# END everlomp phpmyadmin brute-force guard"

FAILURES_ALLOWED = 3
FAILURE_WINDOW = 10 * 60

INITIAL_BAN = 30 * 60
MAX_BAN = 4 * 60 * 60

POLL_INTERVAL = 2

# HTTP Basic browsers can replay one bad cached credential across several
# parallel SPA/API requests. Count that burst as one login event, not one
# human password attempt per request.
KOPIA_FAILURE_EVENT_GAP = 5

FAILURE_RE = re.compile(r"\buser denied: .*?\(mysql-denied\) from (?P<ip>\S+)\s*$")
# kopia-auth.log is written only by nginx locations that ran the internal
# root-controlled password auth_request. Its status field is the auth
# subrequest status, NOT the final browser response. Therefore only
# "401 + Authorization supplied" is a genuine failed Kopia password.
KOPIA_FAILURE_RE = re.compile(r"^(?P<ip>\S+)\s+401\s+1\s+(?P<uri>/kopia(?:/|\?|$)\S*)\s*$")


def log(message: str) -> None:
    print(f"[Everlomp Guard] {message}", flush=True)


def empty_state() -> dict:
    return {
        "failures": {},
        "offenses": {},
        "bans": {},
        "log_inode": None,
        "log_offset": 0,
        "kopia_failures": {},
        "kopia_offenses": {},
        "kopia_bans": {},
        "kopia_log_inode": None,
        "kopia_log_offset": 0,
    }


def load_state() -> dict:
    try:
        state = json.loads(STATE_FILE.read_text())
        if not isinstance(state, dict):
            return empty_state()
    except Exception:
        return empty_state()

    defaults = empty_state()
    for key, value in defaults.items():
        state.setdefault(key, value)

    return state


def save_state(state: dict) -> None:
    STATE_FILE.parent.mkdir(parents=True, exist_ok=True)

    tmp = STATE_FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps(state, indent=2, sort_keys=True) + "\n")
    os.chmod(tmp, 0o600)
    os.replace(tmp, STATE_FILE)


def normalize_ip(value: str):
    value = value.strip()

    if value.startswith("[") and value.endswith("]"):
        value = value[1:-1]

    value = value.rstrip(",;")

    try:
        return str(ipaddress.ip_address(value))
    except ValueError:
        return None


def active_bans(state: dict, now: float) -> list[str]:
    result = []

    for ip, expiry in list(state["bans"].items()):
        try:
            expiry = float(expiry)
        except (TypeError, ValueError):
            del state["bans"][ip]
            continue

        if expiry <= now:
            log(f"Ban expired for {ip}")
            del state["bans"][ip]
        else:
            result.append(ip)

    return sorted(result, key=lambda x: (ipaddress.ip_address(x).version, ipaddress.ip_address(x)))


def build_access_block(banned_ips: list[str]) -> str:
    lines = [
        BEGIN_MARKER,
        "    accessControl {",
        "        allow                   *",
    ]

    if banned_ips:
        lines.append("        deny                    " + ",".join(banned_ips))

    lines.extend([
        "    }",
        "    " + END_MARKER,
    ])

    return "\n".join(lines)


def update_ols_access_control(banned_ips: list[str]) -> bool:
    try:
        original = VHOST_CONF.read_text()
    except Exception as exc:
        log(f"ERROR reading {VHOST_CONF}: {exc}")
        return False

    pattern = re.compile(
        re.escape(BEGIN_MARKER) + r".*?" + re.escape(END_MARKER),
        re.S,
    )

    if not pattern.search(original):
        log("ERROR: phpMyAdmin brute-force marker block is missing from GPTCP1 vhconf.conf")
        return False

    replacement = build_access_block(banned_ips)
    updated = pattern.sub(replacement, original, count=1)

    if updated == original:
        return True

    backup = VHOST_CONF.with_suffix(".conf.everlomp-guard-backup")
    tmp = VHOST_CONF.with_suffix(".conf.everlomp-guard-tmp")

    try:
        backup.write_text(original)
        tmp.write_text(updated)
        os.replace(tmp, VHOST_CONF)

        test = subprocess.run(
            ["/usr/local/lsws/bin/openlitespeed", "-t"],
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            timeout=30,
        )

        test_output = test.stdout or ""

        if test_output.strip():
            log(test_output.strip())

        if re.search(
            r"\[(?:ERROR|FATAL)\]|syntax\s+error|configuration\s+error|"
            r"failed\s+to\s+(?:load|parse|read)\s+config",
            test_output,
            re.IGNORECASE,
        ):
            log("ERROR: OpenLiteSpeed reported a real guard configuration error; restoring previous config")
            VHOST_CONF.write_text(original)
            return False

        restart = subprocess.run(
            ["/usr/local/lsws/bin/lswsctrl", "restart"],
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            timeout=45,
        )

        if restart.stdout and restart.stdout.strip():
            log(restart.stdout.strip())

        if restart.returncode != 0:
            log("ERROR: OpenLiteSpeed graceful restart failed; restoring previous config")
            VHOST_CONF.write_text(original)
            subprocess.run(
                ["/usr/local/lsws/bin/lswsctrl", "restart"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=45,
            )
            return False

        time.sleep(2)

        status = subprocess.run(
            ["/usr/local/lsws/bin/lswsctrl", "status"],
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            timeout=30,
        )

        status_output = status.stdout or ""

        if status_output.strip():
            log(status_output.strip())

        if "litespeed is running with PID" not in status_output:
            log("ERROR: OpenLiteSpeed did not return healthy after applying guard config; restoring previous config")
            VHOST_CONF.write_text(original)
            subprocess.run(
                ["/usr/local/lsws/bin/lswsctrl", "restart"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=45,
            )
            return False

        if banned_ips:
            log("Applied phpMyAdmin deny list: " + ", ".join(banned_ips))
        else:
            log("phpMyAdmin deny list is empty")

        return True

    except Exception as exc:
        log(f"ERROR updating OpenLiteSpeed access control: {exc}")

        try:
            if backup.exists():
                VHOST_CONF.write_text(backup.read_text())
        except Exception:
            pass

        return False


def update_nginx_kopia_access_control(banned_ips: list[str]) -> bool:
    """Write Kopia-only nginx deny rules and reload nginx safely."""
    KOPIA_BAN_FILE.parent.mkdir(parents=True, exist_ok=True)

    lines = [
        "# Managed by Everlomp brute-force guard.",
        "# Included only inside Kopia nginx locations.",
    ]
    for ip in banned_ips:
        lines.append(f"deny {ip};")

    content = "\n".join(lines) + "\n"
    tmp = KOPIA_BAN_FILE.with_suffix(".tmp")

    try:
        tmp.write_text(content)
        os.chmod(tmp, 0o644)
        os.replace(tmp, KOPIA_BAN_FILE)

        test = subprocess.run(
            ["/usr/sbin/nginx", "-t"],
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            timeout=30,
        )

        if test.stdout and test.stdout.strip():
            log(test.stdout.strip())

        if test.returncode != 0:
            log("ERROR: nginx rejected the Kopia ban configuration")
            return False

        reload_nginx = subprocess.run(
            ["/usr/sbin/nginx", "-s", "reload"],
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            timeout=30,
        )

        if reload_nginx.stdout and reload_nginx.stdout.strip():
            log(reload_nginx.stdout.strip())

        if reload_nginx.returncode != 0:
            log("ERROR: nginx reload failed after updating Kopia bans")
            return False

        if banned_ips:
            log("Applied Kopia deny list: " + ", ".join(banned_ips))
        else:
            log("Kopia deny list is empty")

        return True

    except Exception as exc:
        log(f"ERROR updating nginx Kopia access control: {exc}")
        return False


def register_kopia_failure(state: dict, ip: str, now: float) -> bool:
    try:
        address = ipaddress.ip_address(ip)
    except ValueError:
        return False

    if not address.is_global:
        log(f"Ignoring non-public Kopia authentication source {ip}")
        state["kopia_failures"].pop(ip, None)
        return False

    expiry = float(state["kopia_bans"].get(ip, 0) or 0)
    if expiry > now:
        return False

    history = state["kopia_failures"].setdefault(ip, [])

    cutoff = now - FAILURE_WINDOW
    history[:] = [float(ts) for ts in history if float(ts) >= cutoff]

    # One browser password submission may fan out into several simultaneous
    # requests. A tight burst is one login event. Separate attempts outside
    # this small window still count normally toward the existing ban.
    if history and now - float(history[-1]) < KOPIA_FAILURE_EVENT_GAP:
        return False

    history.append(now)

    remaining = FAILURES_ALLOWED - len(history)
    if remaining > 0:
        log(f"Failed Kopia login from {ip}: {len(history)}/{FAILURES_ALLOWED}")
        return False

    offense = int(state["kopia_offenses"].get(ip, 0)) + 1
    state["kopia_offenses"][ip] = offense

    duration = min(
        INITIAL_BAN * (2 ** (offense - 1)),
        MAX_BAN,
    )

    state["kopia_bans"][ip] = now + duration
    state["kopia_failures"][ip] = []

    log(
        f"BANNED {ip} from Kopia for {duration // 60} minutes "
        f"after {FAILURES_ALLOWED} failed logins (offense #{offense})"
    )
    return True


def active_kopia_bans(state: dict, now: float) -> list[str]:
    result = []
    for ip, expiry in list(state["kopia_bans"].items()):
        try:
            expiry = float(expiry)
        except (TypeError, ValueError):
            del state["kopia_bans"][ip]
            continue

        if expiry <= now:
            log(f"Kopia ban expired for {ip}")
            del state["kopia_bans"][ip]
        else:
            result.append(ip)

    return sorted(
        result,
        key=lambda x: (ipaddress.ip_address(x).version, ipaddress.ip_address(x)),
    )


def read_new_kopia_failures(state: dict, now: float) -> bool:
    try:
        stat = KOPIA_AUTH_LOG.stat()
    except FileNotFoundError:
        return False
    except Exception as exc:
        log(f"ERROR reading Kopia auth log metadata: {exc}")
        return False

    inode = stat.st_ino
    saved_inode = state.get("kopia_log_inode")
    offset = int(state.get("kopia_log_offset", 0) or 0)

    if saved_inode != inode or offset > stat.st_size:
        offset = 0

    changed_bans = False

    try:
        with KOPIA_AUTH_LOG.open("r", errors="replace") as fh:
            fh.seek(offset)

            for line in fh:
                match = KOPIA_FAILURE_RE.search(line.strip())
                if not match:
                    continue

                ip = normalize_ip(match.group("ip"))
                if not ip:
                    continue

                if register_kopia_failure(state, ip, now):
                    changed_bans = True

            state["kopia_log_offset"] = fh.tell()
            state["kopia_log_inode"] = inode

    except Exception as exc:
        log(f"ERROR reading Kopia authentication log: {exc}")

    return changed_bans


def prune_kopia_failures(state: dict, now: float) -> None:
    cutoff = now - FAILURE_WINDOW

    for ip, timestamps in list(state["kopia_failures"].items()):
        cleaned = []
        for timestamp in timestamps:
            try:
                timestamp = float(timestamp)
            except (TypeError, ValueError):
                continue
            if timestamp >= cutoff:
                cleaned.append(timestamp)

        if cleaned:
            state["kopia_failures"][ip] = cleaned
        else:
            state["kopia_failures"].pop(ip, None)


def register_failure(state: dict, ip: str, now: float) -> bool:
    try:
        address = ipaddress.ip_address(ip)
    except ValueError:
        return False

    if not address.is_global:
        log(f"Ignoring non-public authentication source {ip}; real-IP forwarding is not active for this request")
        state["failures"].pop(ip, None)
        return False

    expiry = float(state["bans"].get(ip, 0) or 0)

    if expiry > now:
        return False

    history = state["failures"].setdefault(ip, [])
    history.append(now)

    cutoff = now - FAILURE_WINDOW
    history[:] = [
        float(ts)
        for ts in history
        if float(ts) >= cutoff
    ]

    remaining = FAILURES_ALLOWED - len(history)

    if remaining > 0:
        log(f"Failed phpMyAdmin login from {ip}: {len(history)}/{FAILURES_ALLOWED}")
        return False

    offense = int(state["offenses"].get(ip, 0)) + 1
    state["offenses"][ip] = offense

    duration = min(
        INITIAL_BAN * (2 ** (offense - 1)),
        MAX_BAN,
    )

    state["bans"][ip] = now + duration
    state["failures"][ip] = []

    log(
        f"BANNED {ip} for {duration // 60} minutes "
        f"after {FAILURES_ALLOWED} failed phpMyAdmin logins "
        f"(offense #{offense})"
    )

    return True


def read_new_failures(state: dict, now: float) -> bool:
    try:
        stat = AUTH_LOG.stat()
    except FileNotFoundError:
        return False
    except Exception as exc:
        log(f"ERROR reading auth log metadata: {exc}")
        return False

    inode = stat.st_ino
    saved_inode = state.get("log_inode")
    offset = int(state.get("log_offset", 0) or 0)

    if saved_inode != inode or offset > stat.st_size:
        offset = 0

    changed_bans = False

    try:
        with AUTH_LOG.open("r", errors="replace") as fh:
            fh.seek(offset)

            for line in fh:
                match = FAILURE_RE.search(line)

                if not match:
                    continue

                ip = normalize_ip(match.group("ip"))

                if not ip:
                    continue

                if register_failure(state, ip, now):
                    changed_bans = True

            state["log_offset"] = fh.tell()
            state["log_inode"] = inode

    except Exception as exc:
        log(f"ERROR reading authentication log: {exc}")

    return changed_bans


def prune_failures(state: dict, now: float) -> None:
    cutoff = now - FAILURE_WINDOW

    for ip, timestamps in list(state["failures"].items()):
        cleaned = []

        for timestamp in timestamps:
            try:
                timestamp = float(timestamp)
            except (TypeError, ValueError):
                continue

            if timestamp >= cutoff:
                cleaned.append(timestamp)

        if cleaned:
            state["failures"][ip] = cleaned
        else:
            state["failures"].pop(ip, None)


def main() -> int:
    log(
        "Starting brute-force protection: "
        f"{FAILURES_ALLOWED} failures/{FAILURE_WINDOW // 60}m, "
        f"ban {INITIAL_BAN // 60}m up to {MAX_BAN // 3600}h "
        "(phpMyAdmin + Kopia)"
    )

    state = load_state()

    previous_bans = None
    previous_kopia_bans = None

    while True:
        now = time.time()

        prune_failures(state, now)
        prune_kopia_failures(state, now)

        before = active_bans(state, now)
        changed_by_log = read_new_failures(state, now)
        after = active_bans(state, now)

        kopia_before = active_kopia_bans(state, now)
        changed_by_kopia_log = read_new_kopia_failures(state, now)
        kopia_after = active_kopia_bans(state, now)

        if previous_bans is None or before != after or changed_by_log:
            if update_ols_access_control(after):
                previous_bans = list(after)

        if (
            previous_kopia_bans is None
            or kopia_before != kopia_after
            or changed_by_kopia_log
        ):
            if update_nginx_kopia_access_control(kopia_after):
                previous_kopia_bans = list(kopia_after)

        save_state(state)
        time.sleep(POLL_INTERVAL)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        raise SystemExit(0)
