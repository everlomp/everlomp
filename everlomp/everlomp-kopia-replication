def find_replica(replica_id):
    st = load_state()
    r = next((x for x in st['replicas'] if x.get('id') == replica_id), None)
    if not r:
        raise KeyError('Replica not found.')
    return r


def sync_replica(replica_id, timeout=3600):
    r = find_replica(replica_id)
    try:
        result = _privileged_json('replica-sync', replica_id, timeout=max(120, timeout + 30))
        detail = str(result.get('detail') or 'Repository synchronized successfully.')
        update_result(replica_id, 'success', detail, seeded=True, destination_fp=r.get('destination_fingerprint'))
        return detail
    except Exception as exc:
        update_result(replica_id, 'failed', str(exc))
        raise



def test_payload(payload):
    replica_id = str(payload.get('id') or '').strip()
    existing = find_replica(replica_id) if replica_id else None
    normalized, new_secret = normalize_payload(payload, existing, for_test=True)
    normalized['id'] = replica_id or 'test'
    normalized['seeded'] = bool(existing.get('seeded', False)) if existing else False
    result = _privileged_json(
        'replica-test',
        payload={
            'replica': normalized,
            'existing_id': replica_id if existing else '',
            'secret': new_secret,
        },
        timeout=75,
    )
    return str(result.get('detail') or 'Connection test succeeded.')



def parse_iso(value):
    if not value:
        return None
    try:
        return dt.datetime.fromisoformat(value.replace('Z', '+00:00'))
    except Exception:
        return None


def is_due(r, now=None):
    if not r.get('enabled', True):
        return False
    schedule = r.get('schedule', 'manual')
    if schedule == 'manual':
        return False
    now = now or dt.datetime.now().astimezone()
    last = parse_iso(r.get('last_run'))
    if last:
        last = last.astimezone(now.tzinfo)
    else:
        last = dt.datetime.fromtimestamp(0, tz=now.tzinfo)
    age = (now - last).total_seconds()
    if schedule == 'hourly':
        return age >= 3600
    if schedule == 'every6h':
        return age >= 21600
    if schedule == 'every12h':
        return age >= 43200
    hh, mm = (int(x) for x in r.get('time', '03:30').split(':'))
    target = now.replace(hour=hh, minute=mm, second=0, microsecond=0)
    if schedule == 'daily':
        return now >= target and last.date() != now.date()
    if schedule == 'weekly':
        sunday_based = (now.weekday() + 1) % 7
        return sunday_based == int(r.get('weekday', 0)) and now >= target and age >= 6 * 86400
    return False


def run_due():
    if not source_status()['connected']:
        return 0
    count = 0
    for r in load_state()['replicas']:
        if is_due(r):
            try:
                sync_replica(r['id'])
            except Exception as e:
                print(f"[replication] {r.get('name', r['id'])}: {e}", file=sys.stderr)
            count += 1
    return count


def legacy_payload_to_replica(payload):
    if not isinstance(payload, dict) or not payload.get('enabled'):
        return None
    p = {'name': 'Initial replica', 'enabled': True, 'provider': payload.get('type', 'sftp'), 'schedule': payload.get('schedule', 'every6h'), 'time': payload.get('time', '03:30'), 'weekday': payload.get('weekday', 0), 'parallel': 1, 'config': {}, 'secret': {}}
    typ = p['provider']
    if typ == 'sftp':
        x = payload.get('sftp') or {}
        p['config'] = {k: x.get(k) for k in ('host', 'port', 'username', 'path', 'auth_mode')}
        p['secret'] = {k: x.get(k, '') for k in ('password', 'private_key', 'known_hosts')}
    elif typ == 'webdav':
        x = payload.get('webdav') or {}
        p['config'] = {'url': x.get('url'), 'username': x.get('username')}
        p['secret'] = {'password': x.get('password', '')}
    elif typ == 'filesystem':
        x = payload.get('filesystem') or {}
        p['config'] = {'path': x.get('path')}
    elif typ == 's3':
        x = payload.get('s3') or {}
        p['config'] = {k: x.get(k) for k in ('endpoint', 'bucket', 'region', 'prefix', 'disable_tls')}
        p['secret'] = {k: x.get(k, '') for k in ('access_key', 'secret_access_key', 'session_token')}
    elif typ == 'from-config':
        x = payload.get('from_config') or {}
        p['secret'] = {'token': x.get('token', '')}
    elif typ == 'rclone':
        x = payload.get('rclone') or {}
        p['config'] = {'remote_path': x.get('remote_path')}
        p['secret'] = {'rclone_config': x.get('config', '')}
    else:
        raise ValueError('Unsupported destination type.')
    return p


def validate_legacy_payload(payload):
    p = legacy_payload_to_replica(payload)
    if p is None:
        return True
    normalized, secrets = normalize_payload(p)
    validate_secrets(normalized, secrets)
    return True


def import_legacy_payload(payload):
    p = legacy_payload_to_replica(payload)
    if p is None:
        return ''
    return save_replica(p)['id']


def auth_ok(headers):
    actual = headers.get('Authorization', '')
    try:
        cp = _privileged('auth-check', input_data=actual.encode('utf-8'), capture_output=True, timeout=15)
        return cp.returncode == 0
    except Exception:
        return False



class Handler(BaseHTTPRequestHandler):
    server_version = 'EverlompKopiaReplication/1'

    def log_message(self, fmt, *args):
        sys.stderr.write('[replication-api] ' + (fmt % args) + '\n')

    def send_json(self, code, obj):
        body = json.dumps(obj).encode('utf-8')
        self.send_response(code)
        self.send_header('Content-Type', 'application/json')
        self.send_header('Cache-Control', 'no-store')
        self.send_header('Content-Length', str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def authorize(self, mutate=False):
        if not auth_ok(self.headers):
            self.send_response(401)
            self.send_header('WWW-Authenticate', 'Basic realm="Kopia"')
            self.end_headers()
            return False
        if mutate:
            if self.headers.get('Content-Type', '').split(';')[0].strip().lower() != 'application/json':
                self.send_json(415, {'error': 'JSON request required.'})
                return False
            # A non-simple custom header prevents cross-site form CSRF. Kopia's
            # HTMLUI already sets this header on axios requests.
            if not self.headers.get('X-Kopia-Csrf-Token'):
                self.send_json(403, {'error': 'Missing Kopia CSRF header.'})
                return False
        return True

    def read_json(self):
        n = int(self.headers.get('Content-Length', '0') or '0')
        if n > 1024 * 1024:
            raise ValueError('Request too large.')
        raw = self.rfile.read(n) if n else b'{}'
        data = json.loads(raw.decode('utf-8'))
        if not isinstance(data, dict):
            raise ValueError('JSON object required.')
        return data

    def do_GET(self):
        if not self.authorize(False):
            return
        path = urlparse(self.path).path.rstrip('/') or '/'
        try:
            if path == '/status':
                self.send_json(200, {'source': source_status(), 'replica_count': len(load_state()['replicas'])})
            elif path == '/replicas':
                self.send_json(200, {'replicas': list_replicas(), 'source': source_status()})
            else:
                self.send_json(404, {'error': 'Not found.'})
        except Exception as e:
            self.send_json(500, {'error': str(e)})

    def do_POST(self):
        if not self.authorize(True):
            return
        path = urlparse(self.path).path.rstrip('/') or '/'
        try:
            data = self.read_json()
            if path == '/replicas':
                self.send_json(200, {'replica': save_replica(data)})
                return
            if path == '/replicas/test':
                self.send_json(200, {'ok': True, 'detail': test_payload(data)})
                return
            if path == '/sftp-host-key':
                self.send_json(200, {'ok': True, 'known_hosts': fetch_sftp_known_hosts(data.get('host'), data.get('port', 22))})
                return
            if path == '/sftp-bootstrap':
                self.send_json(200, bootstrap_sftp_access(data))
                return
            if path == '/source-password':
                self.send_json(200, {'source': set_source_password(str(data.get('password') or ''))})
                return
            if path == '/source-password/change':
                self.send_json(200, {'source': change_source_password(str(data.get('new_password') or ''))})
                return
            m = re.fullmatch(r'/replicas/([A-Za-z0-9._-]{1,80})/sync', path)
            if m:
                self.send_json(200, {'ok': True, 'detail': sync_replica(m.group(1))})
                return
            self.send_json(404, {'error': 'Not found.'})
        except (ValueError, KeyError) as e:
            self.send_json(400, {'error': str(e).strip("'")})
        except subprocess.TimeoutExpired:
            self.send_json(504, {'error': 'Kopia operation timed out.'})
        except Exception as e:
            self.send_json(500, {'error': str(e)})

    def do_DELETE(self):
        if not self.authorize(True):
            return
        path = urlparse(self.path).path.rstrip('/')
        try:
            m = re.fullmatch(r'/replicas/([A-Za-z0-9._-]{1,80})', path)
            if not m:
                self.send_json(404, {'error': 'Not found.'})
                return
            delete_replica(m.group(1))
            self.send_json(200, {'ok': True})
        except KeyError as e:
            self.send_json(404, {'error': str(e).strip("'")})
        except Exception as e:
            self.send_json(500, {'error': str(e)})


def serve():
    ensure_dirs()
    httpd = ThreadingHTTPServer((API_HOST, API_PORT), Handler)
    httpd.daemon_threads = True
    print(f'[replication-api] listening on {API_HOST}:{API_PORT}', file=sys.stderr)
    httpd.serve_forever()


