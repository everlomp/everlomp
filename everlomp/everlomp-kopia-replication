def atomic_json(path: Path, data, mode=0o600):
    ensure_dirs()
    fd, tmp = tempfile.mkstemp(prefix='.' + path.name + '.', dir=str(path.parent))
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as f:
            json.dump(data, f, indent=2, sort_keys=True)
            f.write('\n')
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    finally:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(tmp)


@contextlib.contextmanager
def state_lock(exclusive=True):
    ensure_dirs()
    fd = os.open(str(LOCK), os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX if exclusive else fcntl.LOCK_SH)
        yield
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)


def load_state_unlocked():
    if not CONFIG.exists():
        return {'version': 1, 'replicas': []}
    try:
        data = json.loads(CONFIG.read_text(encoding='utf-8'))
    except Exception:
        return {'version': 1, 'replicas': []}
    if not isinstance(data, dict):
        return {'version': 1, 'replicas': []}
    if not isinstance(data.get('replicas'), list):
        data['replicas'] = []
    data['version'] = 1
    return data


def load_state():
    with state_lock(False):
        return load_state_unlocked()


def save_state(data):
    with state_lock(True):
        atomic_json(CONFIG, data)


def _privileged(*args, input_data=None, capture_output=False, timeout=120):
    return subprocess.run(
        [SUDO, '-n', PRIV_HELPER, *map(str, args)],
        input=input_data,
        capture_output=capture_output,
        timeout=timeout,
        check=False,
    )


def _privileged_json(*args, payload=None, timeout=120):
    if payload is None:
        raw = None
    elif isinstance(payload, bytes):
        raw = payload
    elif isinstance(payload, str):
        raw = payload.encode('utf-8')
    else:
        raw = json.dumps(payload, separators=(',', ':')).encode('utf-8')
    cp = _privileged(*args, input_data=raw, capture_output=True, timeout=timeout)
    if cp.returncode != 0:
        detail = (cp.stderr or cp.stdout or b'').decode(errors='replace').strip()
        raise RuntimeError(detail or 'Privileged Kopia operation failed.')
    try:
        data = json.loads((cp.stdout or b'{}').decode('utf-8'))
    except Exception as exc:
        raise RuntimeError('Privileged Kopia worker returned an invalid response.') from exc
    if not isinstance(data, dict):
        raise RuntimeError('Privileged Kopia worker returned an invalid response.')
    return data



