def clean_string(v, max_len, label, required=False):
    if v is None:
        v = ''
    if not isinstance(v, str):
        raise ValueError(f'{label} must be text.')
    v = v.strip()
    if required and not v:
        raise ValueError(f'{label} is required.')
    if len(v) > max_len or '\x00' in v or '\n' in v and label in {'Host', 'Endpoint'}:
        raise ValueError(f'{label} is invalid.')
    return v


def parse_int(v, lo, hi, label):
    try:
        n = int(v)
    except Exception:
        raise ValueError(f'{label} must be a number.')
    if n < lo or n > hi:
        raise ValueError(f'{label} must be between {lo} and {hi}.')
    return n




def fetch_sftp_known_hosts(host, port=22, timeout=8):
    host = clean_string(host, 255, 'Host', True)
    port = parse_int(port, 1, 65535, 'Port')
    if not Path(SSH_KEYSCAN).is_file() or not os.access(SSH_KEYSCAN, os.X_OK):
        raise ValueError('ssh-keyscan is not installed in this image.')
    try:
        cp = subprocess.run(
            [SSH_KEYSCAN, '-T', str(timeout), '-p', str(port), host],
            capture_output=True, text=True, timeout=timeout + 4,
        )
    except subprocess.TimeoutExpired:
        raise ValueError('Timed out while fetching the SSH host key.')
    lines = []
    for raw in (cp.stdout or '').splitlines():
        line = raw.strip()
        if not line or line.startswith('#'):
            continue
        parts = line.split()
        if len(parts) < 3:
            continue
        if not (parts[1].startswith('ssh-') or parts[1].startswith('ecdsa-') or parts[1].startswith('sk-')):
            continue
        if line not in lines:
            lines.append(line)
    if not lines:
        detail = (cp.stderr or '').strip().splitlines()
        suffix = f' ({detail[-1]})' if detail else ''
        raise ValueError('Could not fetch an SSH host key from the destination.' + suffix)
    return '\n'.join(lines)


def ensure_sftp_known_hosts(replica, secret):
    if replica.get('provider') != 'sftp' or secret.get('known_hosts'):
        return False
    cfg = replica.get('config') or {}
    secret['known_hosts'] = fetch_sftp_known_hosts(cfg.get('host'), cfg.get('port', 22))
    return True

def _redact(text, *secrets):
    text = str(text or '')
    for secret in secrets:
        if isinstance(secret, str) and secret:
            text = text.replace(secret, '[redacted]')
    return text


def _ssh_target(host, username):
    host = clean_string(host, 255, 'Host', True)
    username = clean_string(username, 255, 'Username', True)
    if host.startswith('-') or re.search(r'\s', host):
        raise ValueError('Invalid SSH host.')
    if not re.fullmatch(r'[A-Za-z0-9._-]+', username):
        raise ValueError('SSH username contains unsupported characters.')
    return host, username, f'{username}@{host}'


def _known_hosts_file(tmpdir, known_hosts):
    kh = Path(tmpdir) / 'known_hosts'
    kh.write_text(known_hosts + ('\n' if known_hosts and not known_hosts.endswith('\n') else ''), encoding='utf-8')
    os.chmod(kh, 0o600)
    return kh


def _ssh_common_args(host, port, username, known_hosts_file):
    host, username, target = _ssh_target(host, username)
    port = parse_int(port, 1, 65535, 'Port')
    return [
        '-p', str(port),
        '-o', 'ConnectTimeout=10',
        '-o', 'ConnectionAttempts=1',
        '-o', 'StrictHostKeyChecking=yes',
        '-o', f'UserKnownHostsFile={known_hosts_file}',
        '-o', 'GlobalKnownHostsFile=/dev/null',
        '-o', 'LogLevel=ERROR',
        target,
    ]


def _ssh_with_password(host, port, username, password, known_hosts_file, command, timeout=30):
    if not isinstance(password, str) or not password or len(password) > 4096 or any(c in password for c in ('\r', '\n', '\x00')):
        raise ValueError('Enter a valid current remote SSH password.')
    if not Path(SSH).is_file() or not os.access(SSH, os.X_OK):
        raise ValueError('OpenSSH client is not installed in this image.')

    args = _ssh_common_args(host, port, username, known_hosts_file)
    args[0:0] = [
        '-o', 'PreferredAuthentications=password,keyboard-interactive',
        '-o', 'PubkeyAuthentication=no',
        '-o', 'NumberOfPasswordPrompts=1',
    ]
    args.append(command)
    child = pexpect.spawn(SSH, args, encoding='utf-8', timeout=timeout)
    transcript = []
    try:
        idx = child.expect([r'(?i)password\s*:', pexpect.EOF, pexpect.TIMEOUT])
        transcript.append(child.before or '')
        if idx == 0:
            child.sendline(password)
            child.expect(pexpect.EOF)
            transcript.append(child.before or '')
        elif idx == 2:
            raise ValueError('Timed out connecting to the remote SSH account.')
        child.close()
        text = _redact(''.join(transcript).strip(), password)
        if child.exitstatus not in (0, None):
            detail = [x.strip() for x in text.splitlines() if x.strip()]
            raise ValueError(detail[-1] if detail else 'Remote SSH password authentication failed.')
        if 'Permission denied' in text:
            raise ValueError('Remote SSH password authentication failed.')
        return text
    finally:
        if child.isalive():
            child.close(force=True)


def _change_remote_password(host, port, username, current_password, new_password, known_hosts_file, timeout=45):
    if not isinstance(new_password, str) or len(new_password) < 12 or len(new_password) > 1024 or any(c in new_password for c in ('\r', '\n', '\x00')):
        raise ValueError('New remote SSH password must be 12-1024 characters and contain no line breaks.')
    args = _ssh_common_args(host, port, username, known_hosts_file)
    args[0:0] = [
        '-tt',
        '-o', 'PreferredAuthentications=password,keyboard-interactive',
        '-o', 'PubkeyAuthentication=no',
        '-o', 'NumberOfPasswordPrompts=1',
    ]
    args.append('LC_ALL=C passwd')
    child = pexpect.spawn(SSH, args, encoding='utf-8', timeout=timeout)
    transcript = []
    try:
        # Authenticate the SSH connection itself.
        idx = child.expect([r'(?i)password\s*:', pexpect.EOF, pexpect.TIMEOUT])
        transcript.append(child.before or '')
        if idx != 0:
            if idx == 2:
                raise ValueError('Timed out connecting to the remote SSH account.')
            raise ValueError('Remote SSH password authentication failed.')
        child.sendline(current_password)

        new_prompts = 0
        for _ in range(16):
            idx = child.expect([
                r'(?i)(?:current|old).*password[^:]*:',
                r'(?i)new.*password[^:]*:',
                r'(?i)(?:retype|repeat).*password[^:]*:',
                r'(?i)password[^:]*:',
                pexpect.EOF,
                pexpect.TIMEOUT,
            ])
            transcript.append(child.before or '')
            if idx == 0:
                child.sendline(current_password)
            elif idx == 1:
                child.sendline(new_password)
                new_prompts += 1
            elif idx == 2:
                child.sendline(new_password)
            elif idx == 3:
                # Some passwd/PAM variants use a generic Password: prompt.
                child.sendline(current_password if new_prompts == 0 else new_password)
            elif idx == 4:
                break
            else:
                raise ValueError('Timed out while changing the remote SSH password.')
        child.close()
        text = _redact(''.join(transcript).strip(), current_password, new_password)
        low = text.lower()
        if child.exitstatus not in (0, None) or any(x in low for x in (
            'password unchanged', 'authentication token manipulation error',
            'permission denied', 'passwd: failure', 'password change failed',
        )):
            detail = [x.strip() for x in text.splitlines() if x.strip()]
            raise ValueError(detail[-1] if detail else 'The remote server rejected the password change.')
    finally:
        if child.isalive():
            child.close(force=True)


def _ssh_with_key(host, port, username, keyfile, known_hosts_file, command='printf EVERLOMP_KEY_OK', timeout=25):
    args = _ssh_common_args(host, port, username, known_hosts_file)
    args[0:0] = [
        '-i', str(keyfile),
        '-o', 'BatchMode=yes',
        '-o', 'PreferredAuthentications=publickey',
        '-o', 'PasswordAuthentication=no',
    ]
    args.append(command)
    cp = subprocess.run([SSH, *args], capture_output=True, text=True, timeout=timeout)
    text = '\n'.join(x for x in [(cp.stdout or '').strip(), (cp.stderr or '').strip()] if x).strip()
    if cp.returncode != 0:
        lines = [x.strip() for x in text.splitlines() if x.strip()]
        raise ValueError(lines[-1] if lines else 'SSH key authentication failed after installing the public key.')
    return text


def bootstrap_sftp_access(payload):
    if not isinstance(payload, dict):
        raise ValueError('Invalid SSH setup request.')
    host = clean_string(payload.get('host'), 255, 'Host', True)
    port = parse_int(payload.get('port', 22), 1, 65535, 'Port')
    username = clean_string(payload.get('username'), 255, 'Username', True)
    current_password = str(payload.get('current_password') or '')
    known_hosts = str(payload.get('known_hosts') or '').strip()
    change_password = bool(payload.get('change_password', False))
    new_password = str(payload.get('new_password') or '')
    new_password_confirm = str(payload.get('new_password_confirm') or '')
    generate_keypair = bool(payload.get('generate_keypair', True))

    if not current_password or len(current_password) > 4096 or any(c in current_password for c in ('\r', '\n', '\x00')):
        raise ValueError('Enter a valid current remote SSH password.')
    if change_password:
        if new_password != new_password_confirm:
            raise ValueError('The new remote SSH passwords do not match.')
        if len(new_password) < 12 or len(new_password) > 1024 or any(c in new_password for c in ('\r', '\n', '\x00')):
            raise ValueError('New remote SSH password must be 12-1024 characters and contain no line breaks.')
    if not known_hosts:
        known_hosts = fetch_sftp_known_hosts(host, port)

    with tempfile.TemporaryDirectory(prefix='everlomp-sftp-bootstrap-', dir='/tmp') as td_raw:
        td = Path(td_raw)
        os.chmod(td, 0o700)
        kh = _known_hosts_file(td, known_hosts)

        # Verify the current password before making any change.
        _ssh_with_password(host, port, username, current_password, kh, 'printf EVERLOMP_PASSWORD_OK')
        effective_password = current_password
        password_changed = False

        if change_password:
            _change_remote_password(host, port, username, current_password, new_password, kh)
            effective_password = new_password
            # Verify the new password in a fresh SSH connection before moving on.
            _ssh_with_password(host, port, username, effective_password, kh, 'printf EVERLOMP_NEW_PASSWORD_OK')
            password_changed = True

        private_key = ''
        public_key = ''
        fingerprint = ''
        if generate_keypair:
            if not Path(SSH_KEYGEN).is_file() or not os.access(SSH_KEYGEN, os.X_OK):
                raise ValueError('ssh-keygen is not installed in this image.')
            keyfile = td / 'id_ed25519'
            cp = subprocess.run(
                [SSH_KEYGEN, '-q', '-t', 'ed25519', '-N', '', '-C', 'everlomp-kopia-backup', '-f', str(keyfile)],
                capture_output=True, text=True, timeout=20,
            )
            if cp.returncode != 0 or not keyfile.is_file() or not Path(str(keyfile) + '.pub').is_file():
                raise ValueError((cp.stderr or '').strip() or 'Could not generate the SSH keypair.')
            os.chmod(keyfile, 0o600)
            public_key = Path(str(keyfile) + '.pub').read_text(encoding='utf-8').strip()
            private_key = keyfile.read_text(encoding='utf-8').strip()

            quoted_key = shlex.quote(public_key)
            install_cmd = (
                'set -eu; umask 077; mkdir -p "$HOME/.ssh"; '
                'touch "$HOME/.ssh/authorized_keys"; chmod 700 "$HOME/.ssh"; '
                'chmod 600 "$HOME/.ssh/authorized_keys"; '
                f'key={quoted_key}; '
                'grep -qxF -- "$key" "$HOME/.ssh/authorized_keys" || '
                'printf "%s\\n" "$key" >> "$HOME/.ssh/authorized_keys"'
            )
            _ssh_with_password(host, port, username, effective_password, kh, install_cmd, timeout=35)
            _ssh_with_key(host, port, username, keyfile, kh)
            fp = subprocess.run([SSH_KEYGEN, '-lf', str(keyfile) + '.pub'], capture_output=True, text=True, timeout=10)
            fingerprint = (fp.stdout or '').strip()

    return {
        'ok': True,
        'known_hosts': known_hosts,
        'password_changed': password_changed,
        'keypair_generated': generate_keypair,
        'private_key': private_key,
        'public_key': public_key,
        'fingerprint': fingerprint,
        'detail': (
            'Remote password changed and SSH keypair generated, installed, and verified.' if password_changed and generate_keypair
            else 'Remote SSH keypair generated, installed, and verified.' if generate_keypair
            else 'Remote SSH password changed and verified.' if password_changed
            else 'Remote SSH password verified.'
        ),
    }



def test_sftp_auth(payload):
    """Test the selected SSH credential without requiring a connected Kopia source repo.

    The installer can run before Kopia has been built/connected. Once Kopia is
    available, the Replication page uses the native `repository sync-to ...
    --dry-run` path instead.
    """
    if not isinstance(payload, dict):
        raise ValueError('Invalid SFTP test request.')
    host = clean_string(payload.get('host'), 255, 'Host', True)
    port = parse_int(payload.get('port', 22), 1, 65535, 'Port')
    username = clean_string(payload.get('username'), 255, 'Username', True)
    auth_mode = str(payload.get('auth_mode') or 'key')
    if auth_mode not in {'key', 'password'}:
        raise ValueError('SFTP authentication must be key or password.')
    known_hosts = str(payload.get('known_hosts') or '').strip()
    if not known_hosts:
        known_hosts = fetch_sftp_known_hosts(host, port)

    with tempfile.TemporaryDirectory(prefix='everlomp-sftp-auth-test-', dir='/tmp') as td_raw:
        td = Path(td_raw)
        os.chmod(td, 0o700)
        kh = _known_hosts_file(td, known_hosts)
        if auth_mode == 'key':
            private_key = str(payload.get('private_key') or '')
            if not private_key:
                raise ValueError('Paste or generate an SSH private key first.')
            keyfile = td / 'id_test'
            keyfile.write_text(private_key + ('\n' if not private_key.endswith('\n') else ''), encoding='utf-8')
            os.chmod(keyfile, 0o600)
            _ssh_with_key(host, port, username, keyfile, kh, command='printf EVERLOMP_KEY_TEST_OK')
            detail = 'SSH key authentication succeeded. Kopia will use this key for SFTP replication.'
        else:
            password = str(payload.get('password') or '')
            _ssh_with_password(host, port, username, password, kh, 'printf EVERLOMP_PASSWORD_TEST_OK')
            detail = 'SSH password authentication succeeded. Kopia will use this account for SFTP replication.'

    return {'ok': True, 'detail': detail, 'known_hosts': known_hosts}

def normalize_payload(payload, existing=None, for_test=False):
    if not isinstance(payload, dict):
        raise ValueError('Invalid replica data.')
    existing = existing or {}
    provider = str(payload.get('provider') or existing.get('provider') or 'sftp')
    if provider not in VALID_PROVIDERS:
        raise ValueError('Unsupported destination type.')
    if provider in {'from-config', 'rclone'}:
        raise ValueError(
            'This destination type is disabled by the isolated replication worker because it can describe local/root-accessible storage. '
            'Use SFTP, WebDAV, S3/MinIO, or a mounted filesystem destination.'
        )
    schedule = str(payload.get('schedule') or existing.get('schedule') or 'manual')
    if schedule not in VALID_SCHEDULES:
        raise ValueError('Invalid replication schedule.')
    tm = str(payload.get('time') or existing.get('time') or '03:30')
    weekday = int(payload.get('weekday', existing.get('weekday', 0)) or 0)
    if schedule in {'daily', 'weekly'} and not re.fullmatch(r'(?:[01]\d|2[0-3]):[0-5]\d', tm):
        raise ValueError('Replication time must be HH:MM.')
    if schedule == 'weekly' and not 0 <= weekday <= 6:
        raise ValueError('Invalid weekday.')
    parallel = parse_int(payload.get('parallel', existing.get('parallel', 1)), 1, 32, 'Parallel transfers')
    name = clean_string(payload.get('name', existing.get('name', '')), 120, 'Name') or provider.upper()
    enabled = bool(payload.get('enabled', existing.get('enabled', True)))
    cfg_in = payload.get('config') or {}
    if not isinstance(cfg_in, dict):
        raise ValueError('Invalid provider configuration.')
    cfg = {}
    secret_in = payload.get('secret') or {}
    if not isinstance(secret_in, dict):
        raise ValueError('Invalid secret configuration.')
    secrets = {}

    if provider == 'filesystem':
        path = clean_string(cfg_in.get('path'), 2048, 'Destination path', True)
        if not path.startswith('/'):
            raise ValueError('Filesystem destination must be an absolute path inside the container.')
        cfg = {'path': path}

    elif provider == 'sftp':
        host = clean_string(cfg_in.get('host'), 255, 'Host', True)
        port = parse_int(cfg_in.get('port', 22), 1, 65535, 'Port')
        username = clean_string(cfg_in.get('username'), 255, 'Username', True)
        path = clean_string(cfg_in.get('path'), 1024, 'Remote path', True)
        auth_mode = str(cfg_in.get('auth_mode') or 'key')
        if auth_mode not in {'key', 'password'}:
            raise ValueError('SFTP authentication must be key or password.')
        cfg = {'host': host, 'port': port, 'username': username, 'path': path, 'auth_mode': auth_mode}
        for key in ('password', 'private_key', 'known_hosts'):
            val = secret_in.get(key)
            if isinstance(val, str) and val:
                secrets[key] = val

    elif provider == 'webdav':
        url = clean_string(cfg_in.get('url'), 2048, 'WebDAV URL', True)
        if not re.match(r'^https?://', url, re.I):
            raise ValueError('WebDAV URL must start with http:// or https://.')
        username = clean_string(cfg_in.get('username'), 512, 'Username', True)
        cfg = {'url': url, 'username': username}
        if isinstance(secret_in.get('password'), str) and secret_in.get('password'):
            secrets['password'] = secret_in['password']

    elif provider == 's3':
        endpoint = clean_string(cfg_in.get('endpoint'), 255, 'Endpoint', True)
        if '://' in endpoint or '/' in endpoint or re.search(r'\s', endpoint):
            raise ValueError('S3/MinIO endpoint must be host[:port] without http:// or https://.')
        bucket = clean_string(cfg_in.get('bucket'), 255, 'Bucket', True)
        region = clean_string(cfg_in.get('region'), 128, 'Region')
        prefix = clean_string(cfg_in.get('prefix'), 1024, 'Prefix')
        disable_tls = bool(cfg_in.get('disable_tls', False))
        cfg = {'endpoint': endpoint, 'bucket': bucket, 'region': region, 'prefix': prefix, 'disable_tls': disable_tls}
        for key in ('access_key', 'secret_access_key', 'session_token'):
            val = secret_in.get(key)
            if isinstance(val, str) and val:
                secrets[key] = val

    elif provider == 'from-config':
        cfg = {}
        if isinstance(secret_in.get('token'), str) and secret_in.get('token'):
            secrets['token'] = secret_in['token'].strip()

    elif provider == 'rclone':
        remote_path = clean_string(cfg_in.get('remote_path'), 2048, 'Rclone remote path', True)
        cfg = {'remote_path': remote_path}
        if isinstance(secret_in.get('rclone_config'), str) and secret_in.get('rclone_config'):
            secrets['rclone_config'] = secret_in['rclone_config']

    return {
        'name': name,
        'enabled': enabled,
        'provider': provider,
        'schedule': schedule,
        'time': tm,
        'weekday': weekday,
        'parallel': parallel,
        'config': cfg,
    }, secrets


def required_secret_keys(replica):
    p = replica['provider']
    cfg = replica.get('config', {})
    if p == 'sftp':
        return ['password'] if cfg.get('auth_mode') == 'password' else ['private_key']
    if p == 'webdav':
        return ['password']
    if p == 's3':
        return ['access_key', 'secret_access_key']
    if p == 'from-config':
        return ['token']
    if p == 'rclone':
        return ['rclone_config']
    return []


def validate_secrets(replica, secret):
    missing = [k for k in required_secret_keys(replica) if not secret.get(k)]
    if missing:
        pretty = ', '.join(x.replace('_', ' ') for x in missing)
        raise ValueError('Missing destination credential(s): ' + pretty + '.')


def destination_fingerprint(replica, destination_secret_sha256=''):
    """Stable identity for the actual replica destination, excluding schedule/UI settings."""
    provider = replica.get('provider') or ''
    cfg = replica.get('config') or {}
    identity = {'provider': provider, 'config': cfg}
    if provider in {'from-config', 'rclone'} and destination_secret_sha256:
        identity['destination_secret_sha256'] = destination_secret_sha256
    raw = json.dumps(identity, sort_keys=True, separators=(',', ':'), ensure_ascii=True)
    return hashlib.sha256(raw.encode('utf-8')).hexdigest()



def public_replica(replica):
    d = dict(replica)
    meta = _privileged_json('replica-secret-meta', replica['id'], timeout=20)
    d['secret_configured'] = meta.get('secret_configured') or {}
    return d



def list_replicas():
    st = load_state()
    return [public_replica(x) for x in st['replicas']]


def save_replica(payload):
    replica_id = str(payload.get('id') or '').strip()
    with state_lock(True):
        st = load_state_unlocked()
        existing = next((x for x in st['replicas'] if x.get('id') == replica_id), None) if replica_id else None
        normalized, new_secrets = normalize_payload(payload, existing)
        if not replica_id:
            replica_id = uuid.uuid4().hex[:16]
        normalized['id'] = replica_id

        if normalized.get('provider') == 'filesystem':
            # Filesystem replicas have no destination credentials to retain.
            with contextlib.suppress(Exception):
                _privileged_json('replica-secret-delete', replica_id, timeout=20)
            meta = {'secret_configured': {}, 'destination_secret_sha256': ''}
        else:
            meta = _privileged_json(
                'replica-secret-update', replica_id,
                payload={
                    'provider': normalized.get('provider'),
                    'config': normalized.get('config') or {},
                    'secret': new_secrets,
                },
                timeout=30,
            )

        new_destination = destination_fingerprint(normalized, meta.get('destination_secret_sha256', ''))
        old_destination = existing.get('destination_fingerprint') if existing else None
        normalized['destination_fingerprint'] = new_destination
        normalized['seeded'] = bool(existing and existing.get('seeded', False) and old_destination == new_destination)

        for k in ('last_run', 'last_status', 'last_detail'):
            if existing and k in existing:
                normalized[k] = existing[k]
        if existing:
            st['replicas'] = [normalized if x.get('id') == replica_id else x for x in st['replicas']]
        else:
            st['replicas'].append(normalized)
        atomic_json(CONFIG, st)
    return public_replica(normalized)



def delete_replica(replica_id):
    with state_lock(True):
        st = load_state_unlocked()
        old = len(st['replicas'])
        st['replicas'] = [x for x in st['replicas'] if x.get('id') != replica_id]
        if len(st['replicas']) == old:
            raise KeyError('Replica not found.')
        atomic_json(CONFIG, st)
    with contextlib.suppress(Exception):
        _privileged_json('replica-secret-delete', replica_id, timeout=20)



def update_result(replica_id, status, detail, seeded=None, destination_fp=None):
    with state_lock(True):
        st = load_state_unlocked()
        for r in st['replicas']:
            if r.get('id') == replica_id:
                r['last_run'] = now_iso()
                r['last_status'] = status
                r['last_detail'] = detail[:500]
                if seeded is not None:
                    r['seeded'] = bool(seeded)
                if destination_fp:
                    r['destination_fingerprint'] = destination_fp
                atomic_json(CONFIG, st)
                return


