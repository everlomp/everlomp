def _wait_kopia_port(timeout=35):
    # Kept for compatibility with older callers; password changes are now fully
    # executed by the root-only worker.
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        try:
            with socket.create_connection(('127.0.0.1', 51515), timeout=1):
                return
        except OSError:
            time.sleep(0.5)
    raise RuntimeError('Kopia did not become ready after restart.')



