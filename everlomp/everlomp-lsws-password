#!/bin/bash
set -euo pipefail

ACTION="${1:-}"

ADMIN_PHP="/usr/local/lsws/admin/fcgi-bin/admin_php"
HTPASSWD_PHP="/usr/local/lsws/admin/misc/htpasswd.php"
HTPASSWD_FILE="/usr/local/lsws/admin/conf/htpasswd"
STATE_DIR="/var/www/.everlomp"
CONFIGURED_FILE="$STATE_DIR/lsws-password.configured"
PERSISTED_HTPASSWD="/home/everlomp/secrets/lsws-htpasswd"
SECRET_HELPER="/usr/local/sbin/everlomp-secret"
ADMIN_USER="admin"

if [ "$ACTION" != "generate" ]; then
    echo "Usage: everlomp-lsws-password generate" >&2
    exit 64
fi

if [ -e "$CONFIGURED_FILE" ]; then
    echo "OpenLiteSpeed WebAdmin password has already been generated. Refusing to replace it." >&2
    exit 10
fi

if [ ! -x "$ADMIN_PHP" ]; then
    echo "OpenLiteSpeed WebAdmin PHP utility is unavailable: $ADMIN_PHP" >&2
    exit 2
fi

if [ ! -f "$HTPASSWD_PHP" ]; then
    echo "OpenLiteSpeed WebAdmin password hashing script is unavailable: $HTPASSWD_PHP" >&2
    exit 3
fi

mkdir -p "$(dirname "$HTPASSWD_FILE")"
install -d -o root -g nogroup -m 0750 "$STATE_DIR"
install -d -o root -g root -m 0700 /home/everlomp/secrets

PASSWORD="$(openssl rand -hex 16)"

if [ -z "$PASSWORD" ]; then
    echo "Could not generate a WebAdmin password." >&2
    exit 4
fi

PASSWORD_HASH="$(
    "$ADMIN_PHP" -q "$HTPASSWD_PHP" "$PASSWORD"
)"

if [ -z "$PASSWORD_HASH" ]; then
    echo "OpenLiteSpeed failed to hash the generated WebAdmin password." >&2
    exit 5
fi

BACKUP_FILE=""

if [ -f "$HTPASSWD_FILE" ]; then
    BACKUP_FILE="$(mktemp)"
    cp -p "$HTPASSWD_FILE" "$BACKUP_FILE"
fi

restore_backup() {
    if [ -n "$BACKUP_FILE" ] && [ -f "$BACKUP_FILE" ]; then
        cp -p "$BACKUP_FILE" "$HTPASSWD_FILE" || true
    fi
}

cleanup() {
    if [ -n "$BACKUP_FILE" ]; then
        rm -f "$BACKUP_FILE"
    fi
}

trap cleanup EXIT

if ! printf '%s:%s\n' "$ADMIN_USER" "$PASSWORD_HASH" > "$HTPASSWD_FILE"; then
    restore_backup
    echo "Could not write OpenLiteSpeed WebAdmin credentials." >&2
    exit 6
fi

if [ ! -s "$HTPASSWD_FILE" ] || ! grep -q "^${ADMIN_USER}:" "$HTPASSWD_FILE"; then
    restore_backup
    echo "OpenLiteSpeed WebAdmin credential verification failed." >&2
    exit 7
fi

chown lsadm:lsadm "$HTPASSWD_FILE"
chmod 0600 "$HTPASSWD_FILE"

"$SECRET_HELPER" write "$PERSISTED_HTPASSWD" < "$HTPASSWD_FILE"

printf 'configured\n' > "$CONFIGURED_FILE"
chmod 0644 "$CONFIGURED_FILE"

printf '{"username":"%s","password":"%s"}\n' \
    "$ADMIN_USER" \
    "$PASSWORD"
