def main() -> None:
    action = sys.argv[1] if len(sys.argv) > 1 else ''
 
    # Analysis only reads the temporary ZIP/SQL uploads created by the PHP
    # worker, so it intentionally runs without root/sudo.
    if action == 'analyze':
        payload = read_payload()
        token = validate_token(payload.get('token'))
        emit(analyze(token))
        return
 
    # Everything that mutates MariaDB, secrets, the web root, sudoers, or the
    # helper itself remains root-only.
    if os.geteuid() != 0:
        die('This WordPress migration action must run as root.', 77)
 
    if action == 'uninstall':
        emit(uninstall_feature()); return
 
    payload = read_payload()
    if action == 'migrate':
        emit(migrate(payload)); return
    if action == 'cleanup':
        token = validate_token(payload.get('token')); emit(cleanup_token(token)); return
    die('Usage: everlomp-wordpress-migrate {analyze|migrate|cleanup|uninstall}', 64)
 
 
if __name__ == '__main__':
    main()
