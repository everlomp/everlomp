def migrate(payload: dict[str, Any]) -> dict[str, Any]:
    token = validate_token(payload.get('token'))
    if PRIMARY_APP.exists() and PRIMARY_APP.read_text(errors='ignore').strip():
        die('A primary application is already registered; migration will not overwrite it.', 69)
    site_url, db_name, db_user, db_pass, replace_urls = validate_destination(payload)
    analysis = analyze(token)
    source_db, source_prefix, source_root = ensure_candidate(analysis, payload)
    if source_db != '__default__' and not bool(analysis['sql'].get('has_use_statements')) and len(analysis['sql'].get('databases_seen', [])) > 1:
        die('This multi-database dump has no USE statements, so Everlomp cannot safely isolate one database. Export the WordPress database alone or use a normal mysqldump --all-databases format.', 69)
    zip_path, sql_path = stage_files(token)
    work = stage_dir(token) / 'work'
    extracted = work / 'site'
    work.mkdir(parents=True, exist_ok=True)
    extract_selected_zip(zip_path, source_root, extracted)
 
    existing_tables = db_query(
        f"SELECT COUNT(*) FROM information_schema.tables WHERE table_schema={sql_literal(db_name)};"
    )
    if existing_tables and int(existing_tables) > 0:
        die(f'Destination database {db_name} already contains tables; migration refuses to overwrite it.', 74)
 
    # Create destination database/user before importing. Root socket auth is used,
    # so no MariaDB administrator password is written to disk.
    setup_sql = (
        f"CREATE DATABASE IF NOT EXISTS `{db_name}` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
        f"CREATE USER IF NOT EXISTS {sql_literal(db_user)}@'localhost' IDENTIFIED BY {sql_literal(db_pass)};"
        f"ALTER USER {sql_literal(db_user)}@'localhost' IDENTIFIED BY {sql_literal(db_pass)};"
        f"GRANT ALL PRIVILEGES ON `{db_name}`.* TO {sql_literal(db_user)}@'localhost'; FLUSH PRIVILEGES;"
    )
    db_query(setup_sql)
    import_sql(sql_path, source_db, db_name)
 
    if not SECRET_TOOL.is_file():
        die(f'Everlomp secret helper is unavailable: {SECRET_TOOL}', 75)
    run([str(SECRET_TOOL), 'write', str(SECRET_PATH)], input_bytes=db_pass.encode())
    RUNTIME_SECRET.parent.mkdir(parents=True, exist_ok=True)
    run([str(SECRET_TOOL), 'materialize-web', str(SECRET_PATH), str(RUNTIME_SECRET)])
 
    copy_site(extracted)
    rewrite_wp_config(WEB_ROOT / 'wp-config.php', db_name, db_user, source_prefix)
    set_permissions()
    test_wordpress_db(db_name, db_user)
 
    old_url = detect_old_url(db_name, source_prefix)
    replace_result = {'changed_cells': 0, 'skipped_tables_without_primary_key': 0}
    if replace_urls and old_url and old_url.rstrip('/') != site_url:
        replace_result = serialized_search_replace(db_name, db_user, source_prefix, old_url.rstrip('/'), site_url)
    force_home_siteurl(db_name, source_prefix, site_url)
 
    info = {
        'site_url': site_url,
        'database_name': db_name,
        'database_user': db_user,
        'database_host': 'localhost',
        'table_prefix': source_prefix,
        'migrated': True,
        'source_database': source_db,
        'source_zip_root': source_root,
        'old_site_url': old_url,
        'url_replacement': replace_result,
    }
    WORDPRESS_INFO.write_text(json.dumps(info, separators=(',', ':')) + '\n')
    os.chmod(WORDPRESS_INFO, 0o640)
    try:
        import grp
        os.chown(WORDPRESS_INFO, 0, grp.getgrnam('nogroup').gr_gid)
    except Exception:
        pass
    PRIMARY_APP.write_text('wordpress\n')
    os.chmod(PRIMARY_APP, 0o644)
 
    # Uploaded backups can contain credentials; remove them immediately after success.
    shutil.rmtree(stage_dir(token), ignore_errors=True)
    return {
        'ok': True,
        'site_url': site_url,
        'database_name': db_name,
        'database_user': db_user,
        'table_prefix': source_prefix,
        'old_site_url': old_url,
        'url_replacement': replace_result,
    }
 
 
