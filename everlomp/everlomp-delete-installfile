#!/bin/bash
set -Eeuo pipefail

WEB_ROOT="/var/www/html"
HOME_DIR="/home/everlomp"
STATE_DIR="/var/www/.everlomp"

PRIMARY_APP_FILE="${HOME_DIR}/primary-app"
INSTALL_FILE="${WEB_ROOT}/lompinstaller.php"
BOOTSTRAP_INDEX="${WEB_ROOT}/index.php"

WEB_SUDOERS="/etc/sudoers.d/everlomp-web"
DRUPAL_GIT_SUDOERS="/etc/sudoers.d/everlomp-drupal-git"

HOTPOCKET_HELPER="/usr/local/sbin/everlomp-hotpocket"
HOTPOCKET_SITE_INFO="${HOME_DIR}/hotpocket-site.json"

SELF="/usr/local/sbin/everlomp-delete-installfile"

fail() {
    local message="$1"
    local code="${2:-1}"

    echo "[Everlomp] ERROR: ${message}" >&2
    exit "$code"
}

if [ "${1:-}" != "delete" ]; then
    echo "Usage: everlomp-delete-installfile delete" >&2
    exit 1
fi

if [ "${EUID:-$(id -u)}" -ne 0 ]; then
    fail "This cleanup helper must run as root." 1
fi

read_primary_app() {
    if [ ! -f "$PRIMARY_APP_FILE" ]; then
        fail \
            "Refusing to remove Everlomp installer files before a primary application is installed." \
            2
    fi

    tr -d '\r\n' < "$PRIMARY_APP_FILE" 2>/dev/null || true
}

PRIMARY_APP="$(read_primary_app)"

#
# HotPocket folder/site mode stages the final OpenLiteSpeed document-root
# switch until installer cleanup.
#
# Finalize that BEFORE removing the installer/helper.
#
if [ "$PRIMARY_APP" = "hotpocket-folder" ]; then
    if [ ! -x "$HOTPOCKET_HELPER" ]; then
        fail \
            "HotPocket site finalization is pending, but ${HOTPOCKET_HELPER} is missing." \
            4
    fi

    if [ ! -f "$HOTPOCKET_SITE_INFO" ]; then
        fail \
            "HotPocket site finalization is pending, but ${HOTPOCKET_SITE_INFO} is missing." \
            4
    fi

    echo "[Everlomp] Finalizing staged HotPocket website root..."

    if ! "$HOTPOCKET_HELPER" finalize-site; then
        fail \
            "HotPocket website finalization failed. Installer files were left in place so the configuration can be repaired." \
            4
    fi

    PRIMARY_APP="$(read_primary_app)"
fi

case "$PRIMARY_APP" in
    wordpress|drupal|phpbb)
        ;;

    external:*)
        EXTERNAL_ID="${PRIMARY_APP#external:}"

        if [[ ! "$EXTERNAL_ID" =~ ^[a-z0-9][a-z0-9-]{0,63}$ ]]; then
            fail \
                "Refusing cleanup because the external primary application marker is invalid." \
                3
        fi
        ;;

    *)
        fail \
            "Refusing cleanup because the primary application marker is invalid: ${PRIMARY_APP:-<empty>}" \
            3
        ;;
esac

echo "[Everlomp] Primary application: $PRIMARY_APP"
echo "[Everlomp] Installer file: $INSTALL_FILE"

remove_installer_file() {
    if [ ! -e "$INSTALL_FILE" ] && [ ! -L "$INSTALL_FILE" ]; then
        echo "[Everlomp] Installer file is already absent."
        return 0
    fi

    echo "[Everlomp] Removing installer web interface: $INSTALL_FILE"

    rm -f -- "$INSTALL_FILE" 2>/dev/null || true

    if [ -e "$INSTALL_FILE" ] || [ -L "$INSTALL_FILE" ]; then
        echo "[Everlomp] Installer file still exists; forcing removal..."

        if command -v chattr >/dev/null 2>&1; then
            chattr -i -a -- "$INSTALL_FILE" 2>/dev/null || true
        fi

        chown root:root -- "$INSTALL_FILE" 2>/dev/null || true
        chmod u+rw -- "$INSTALL_FILE" 2>/dev/null || true
        rm -f -- "$INSTALL_FILE" 2>/dev/null || true
    fi

    if [ -e "$INSTALL_FILE" ] || [ -L "$INSTALL_FILE" ]; then
        echo \
            "[Everlomp] WARNING: $INSTALL_FILE still exists after removal attempts." \
            >&2
        return 1
    fi

    echo "[Everlomp] Verified: $INSTALL_FILE is gone."
    return 0
}

if ! remove_installer_file; then
    echo \
        "[Everlomp] WARNING: continuing cleanup even though $INSTALL_FILE remains." \
        >&2
fi

#
# Remove installer bootstrap index only when it is exactly the bootstrap
# redirect shipped by Everlomp.
#
if [ -f "$BOOTSTRAP_INDEX" ] && [ ! -L "$BOOTSTRAP_INDEX" ]; then
    EXPECTED_BOOTSTRAP="$(cat <<'PHP'
<?php
declare(strict_types=1);
header('Location: /lompinstaller.php', true, 302);
exit;
PHP
)"

    CURRENT_BOOTSTRAP="$(cat "$BOOTSTRAP_INDEX" 2>/dev/null || true)"

    if [ "$CURRENT_BOOTSTRAP" = "$EXPECTED_BOOTSTRAP" ]; then
        echo \
            "[Everlomp] Removing obsolete bootstrap redirect: $BOOTSTRAP_INDEX"

        rm -f -- "$BOOTSTRAP_INDEX" 2>/dev/null || true
    fi
fi

#
# Use Bash globs rather than find.
#
# nullglob ensures patterns with no matches disappear instead of becoming
# literal filenames.
#
shopt -s nullglob

echo "[Everlomp] Removing bundled installer archives and examples..."

INSTALLER_ARCHIVES=(
    "$HOME_DIR"/wordpress-*.zip
    "$HOME_DIR"/phpBB-*.zip
    "$HOME_DIR"/phpbb-*.zip
    "$HOME_DIR"/drupal-*.tar.gz
    "$HOME_DIR"/filegator_local.zip
    "$HOME_DIR"/external-installer-example.zip
)

if ((${#INSTALLER_ARCHIVES[@]} > 0)); then
    printf '[Everlomp] Removing archive: %s\n' \
        "${INSTALLER_ARCHIVES[@]}"

    rm -f -- "${INSTALLER_ARCHIVES[@]}"
else
    echo "[Everlomp] No bundled installer archives remain."
fi

#
# Installer-only package libraries / uploaded installation payloads.
#
# Runtime application data lives elsewhere.
#
echo "[Everlomp] Removing installer-only package libraries and uploads..."

rm -rf -- \
    "${HOME_DIR}/external-installs" \
    "${HOME_DIR}/wpaddons" \
    "${HOME_DIR}/hotpocket-contracts"

#
# Abandoned FileGator installation staging.
#
echo "[Everlomp] Removing abandoned installer staging files..."

FILEGATOR_STAGING=(
    "$HOME_DIR"/.filegator-stage.*
    "$HOME_DIR"/.filegator.json.*
)

if ((${#FILEGATOR_STAGING[@]} > 0)); then
    printf '[Everlomp] Removing staging item: %s\n' \
        "${FILEGATOR_STAGING[@]}"

    rm -rf -- "${FILEGATOR_STAGING[@]}"
else
    echo "[Everlomp] No abandoned FileGator staging files remain."
fi

#
# Installer state.
#
# These files are actually written under /var/www/.everlomp.
#
echo "[Everlomp] Removing installer state markers..."

rm -f -- \
    "${STATE_DIR}/database.configured" \
    "${STATE_DIR}/database-admin-user" \
    "${STATE_DIR}/lsws-password.configured"

#
# Remove legacy copies from older images as well.
#
rm -f -- \
    "${HOME_DIR}/database.configured" \
    "${HOME_DIR}/database-admin-user" \
    "${HOME_DIR}/lsws-password.configured"

#
# IMPORTANT:
#
# DO NOT remove these canonical runtime markers:
#
#   /var/www/.everlomp/hotpocket.enabled
#   /var/www/.everlomp/ssh.configured
#
# start.sh needs them after container restart/recreation.
#
# Only remove obsolete duplicate copies from /home/everlomp when a canonical
# state marker exists.
#
if [ -e "${STATE_DIR}/hotpocket.enabled" ]; then
    rm -f -- "${HOME_DIR}/hotpocket.enabled"
fi

if [ -e "${STATE_DIR}/ssh.configured" ]; then
    rm -f -- "${HOME_DIR}/ssh.configured"
fi

echo "[Everlomp] Removing installer metadata..."

rm -f -- \
    "${HOME_DIR}/wordpress.json" \
    "${HOME_DIR}/drupal.json" \
    "${HOME_DIR}/phpbb.json" \
    "${HOME_DIR}/filegator.json" \
    "${HOME_DIR}/realip-failed" \
    "${HOME_DIR}/hotpocket-site.json" \
    "${HOME_DIR}/terms.md"

#
# Remove the state directory only when it is genuinely empty.
#
# Runtime markers such as hotpocket.enabled or ssh.configured deliberately
# prevent this rmdir.
#
rmdir -- "$STATE_DIR" 2>/dev/null || true

echo "[Everlomp] Removing installer-only helper programs..."

INSTALLER_HELPERS=(
    /usr/local/sbin/everlomp-database
    /usr/local/sbin/everlomp-wordpress
    /usr/local/sbin/everlomp-phpbb
    /usr/local/sbin/everlomp-external-installer
    /usr/local/sbin/everlomp-filegator
    /usr/local/sbin/everlomp-phpmyadmin
    /usr/local/sbin/everlomp-realip
    /usr/local/sbin/everlomp-hotpocket
    /usr/local/sbin/everlomp-ssh
    /usr/local/sbin/everlomp-lsws-password
    /usr/local/sbin/everlomp-drupal
    /usr/local/sbin/everlomp-drupal-git
    /usr/local/lib/everlomp-drupal-runner.php
)

for helper in "${INSTALLER_HELPERS[@]}"; do
    if [ -e "$helper" ] || [ -L "$helper" ]; then
        echo "[Everlomp] Removing helper: $helper"
        rm -f -- "$helper"
    fi
done

#
# NOTE:
#
# /usr/local/sbin/everlomp-backup is intentionally NOT removed.
# Backups are runtime functionality, not installer-only functionality.
#
echo "[Everlomp] Keeping runtime backup helper."

echo "[Everlomp] Removing installer sudoers rules..."

rm -f -- \
    "$WEB_SUDOERS" \
    "$DRUPAL_GIT_SUDOERS"

#
# primary-app is only the installer completion marker.
#
rm -f -- "$PRIMARY_APP_FILE"

#
# Restore default shell glob behavior.
#
shopt -u nullglob

#
# Final verification.
#
if [ -e "$INSTALL_FILE" ] || [ -L "$INSTALL_FILE" ]; then
    echo \
        "[Everlomp] WARNING: Final verification: $INSTALL_FILE still exists." \
        >&2
else
    echo \
        "[Everlomp] Final verification passed: installer file is absent."
fi

#
# Keep deliberately:
#
# - installed primary application
# - EverAdmin
# - EverAdmin restart/recovery watcher
# - restart/recovery watcher sudoers
# - HotPocket runtime
# - HotPocket state
# - SSH runtime when enabled
# - OpenLiteSpeed
# - MariaDB
# - phpMyAdmin installation/runtime
# - Kopia
# - backup runtime/scheduling
# - everlomp-backup
# - FileGator installed runtime
# - WordPress migration runtime
# - application secrets/configuration
# - real-IP runtime configuration
# - brute-force guard
#
# Finally remove this cleanup helper itself.
#
rm -f -- "$SELF"

echo
echo "[Everlomp] Installer cleanup completed successfully."
echo "[Everlomp] Removed:"
echo "  - installer web UI"
echo "  - bootstrap redirect when applicable"
echo "  - bundled installation archives"
echo "  - Drupal fallback archive"
echo "  - installer package libraries"
echo "  - abandoned installer staging"
echo "  - installer metadata"
echo "  - installer-only helper programs"
echo "  - installer sudoers rules"
echo
echo "[Everlomp] Preserved:"
echo "  - installed applications"
echo "  - HotPocket runtime and persistent enable marker"
echo "  - EverAdmin recovery/restart watcher"
echo "  - SSH runtime and persistent configured marker"
echo "  - MariaDB / OpenLiteSpeed"
echo "  - phpMyAdmin runtime"
echo "  - Kopia and backup runtime"
echo "  - FileGator runtime"
echo "  - application secrets and configuration"
echo "  - real-IP runtime configuration"
