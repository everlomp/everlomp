#!/bin/bash
set -Eeuo pipefail

WEB_ROOT="/var/www/html"
HOME_DIR="/home/everlomp"
PRIMARY_APP_FILE="${HOME_DIR}/primary-app"
SUDOERS_FILE="/etc/sudoers.d/everlomp-web"
SELF="/usr/local/sbin/everlomp-delete-installfile"

fail() {
    local message="$1"
    local code="${2:-1}"
    echo "[Everlomp] ERROR: ${message}" >&2
    exit "$code"
}

if [ "${1:-}" != "delete" ]; then
    echo "Usage: everlomp-delete delete" >&2
    exit 1
fi

if [ "${EUID:-$(id -u)}" -ne 0 ]; then
    fail "This cleanup helper must run as root." 1
fi

if [ ! -f "$PRIMARY_APP_FILE" ]; then
    fail "Refusing to remove Everlomp installer files before a primary application is installed." 2
fi

PRIMARY_APP="$(tr -d '\r\n' < "$PRIMARY_APP_FILE" 2>/dev/null || true)"

case "$PRIMARY_APP" in
    wordpress|phpbb)
        ;;
    external:*)
        EXTERNAL_ID="${PRIMARY_APP#external:}"
        if [[ ! "$EXTERNAL_ID" =~ ^[a-z0-9][a-z0-9-]{0,63}$ ]]; then
            fail "Refusing cleanup because the external primary application marker is invalid." 3
        fi
        ;;
    *)
        fail "Refusing cleanup because the primary application marker is invalid." 3
        ;;
esac

INSTALL_FILE="${WEB_ROOT}/install.php"
BOOTSTRAP_INDEX="${WEB_ROOT}/index.php"

echo "[Everlomp] Primary application: $PRIMARY_APP"
echo "[Everlomp] Installer file: $INSTALL_FILE"

remove_installer_file() {
    if [ ! -e "$INSTALL_FILE" ] && [ ! -L "$INSTALL_FILE" ]; then
        echo "[Everlomp] Installer file is already absent."
        return 0
    fi

    echo "[Everlomp] Removing installer web interface: $INSTALL_FILE"

    rm -f -- "$INSTALL_FILE" 2>/dev/null || true

    if [ -e "$INSTALL_FILE" ] || [ -L "$INSTALL_FILE" ]; then
        echo "[Everlomp] Installer file still exists; forcing removal..."

        if command -v chattr >/dev/null 2>&1; then
            chattr -i -a -- "$INSTALL_FILE" 2>/dev/null || true
        fi

        chown root:root -- "$INSTALL_FILE" 2>/dev/null || true
        chmod u+rw -- "$INSTALL_FILE" 2>/dev/null || true
        rm -f -- "$INSTALL_FILE" 2>/dev/null || true
    fi

    if [ -e "$INSTALL_FILE" ] || [ -L "$INSTALL_FILE" ]; then
        echo "[Everlomp] WARNING: $INSTALL_FILE still exists after removal attempts." >&2
        return 1
    fi

    echo "[Everlomp] Verified: $INSTALL_FILE is gone."
    return 0
}

if ! remove_installer_file; then
    echo "[Everlomp] WARNING: continuing cleanup even though $INSTALL_FILE remains." >&2
fi

if [ -f "$BOOTSTRAP_INDEX" ] && [ ! -L "$BOOTSTRAP_INDEX" ]; then
    EXPECTED_BOOTSTRAP="$(cat <<'PHP'
<?php
declare(strict_types=1);

header('Location: /install.php', true, 302);
exit;
PHP
)"
    CURRENT_BOOTSTRAP="$(cat "$BOOTSTRAP_INDEX" 2>/dev/null || true)"

    if [ "$CURRENT_BOOTSTRAP" = "$EXPECTED_BOOTSTRAP" ]; then
        echo "[Everlomp] Removing obsolete bootstrap redirect: $BOOTSTRAP_INDEX"
        rm -f -- "$BOOTSTRAP_INDEX" 2>/dev/null || true
    fi
fi

echo "[Everlomp] Removing bundled application installer ZIP files..."
find "$HOME_DIR" -maxdepth 1 \
    \( -type f -o -type l \) \
    \( -name 'wordpress-*.zip' -o -name 'phpBB-*.zip' -o -name 'phpbb-*.zip' -o -name 'filegator_local.zip' -o -name 'external-installer-example.zip' \) \
    -delete

echo "[Everlomp] Removing uploaded external installer packages..."
rm -rf -- "${HOME_DIR}/external-installs"

echo "[Everlomp] Removing abandoned FileGator staging files..."
find "$HOME_DIR" -maxdepth 1 \
    \( -type f -o -type d -o -type l \) \
    \( -name '.filegator-stage.*' -o -name '.filegator.json.*' \) \
    -exec rm -rf -- {} + 2>/dev/null || true

echo "[Everlomp] Removing installer metadata..."
rm -f -- \
    "${HOME_DIR}/database.configured" \
    "${HOME_DIR}/database-admin-user" \
    "${HOME_DIR}/lsws-password.configured" \
    "${HOME_DIR}/wordpress.json" \
    "${HOME_DIR}/phpbb.json" \
    "${HOME_DIR}/filegator.json" \
    "${HOME_DIR}/realip-failed" \
    "${HOME_DIR}/hotpocket.enabled" \
    "${HOME_DIR}/ssh.configured" \
    "${HOME_DIR}/terms.md"

echo "[Everlomp] Removing installer helper programs..."
INSTALLER_HELPERS=(
    /usr/local/sbin/everlomp-database
    /usr/local/sbin/everlomp-wordpress
    /usr/local/sbin/everlomp-phpbb
    /usr/local/sbin/everlomp-external-installer
    /usr/local/sbin/everlomp-filegator
    /usr/local/sbin/everlomp-phpmyadmin
    /usr/local/sbin/everlomp-realip
    /usr/local/sbin/everlomp-hotpocket
    /usr/local/sbin/everlomp-ssh
    /usr/local/sbin/everlomp-lsws-password
    /usr/local/sbin/everlomp-backup
)

for helper in "${INSTALLER_HELPERS[@]}"; do
    rm -f -- "$helper"
done

echo "[Everlomp] Removing installer sudoers rule..."
rm -f -- "$SUDOERS_FILE"

rm -f -- "$PRIMARY_APP_FILE"

if [ -e "$INSTALL_FILE" ] || [ -L "$INSTALL_FILE" ]; then
    echo "[Everlomp] WARNING: Final verification: $INSTALL_FILE still exists." >&2
else
    echo "[Everlomp] Final verification passed: installer file is absent."
fi

rm -f -- "$SELF"

echo "[Everlomp] Installer cleanup completed successfully."
echo "[Everlomp] Removed the dedicated installer file: $INSTALL_FILE"
echo "[Everlomp] Removed the bootstrap redirect too if it was still unchanged."
echo "[Everlomp] Kept runtime components and data, including the installed primary application, FileGator, Kopia, SQL backup scheduling/runtime, phpMyAdmin, MariaDB, OpenLiteSpeed, HotPocket, SSH when enabled, application files, real-IP runtime configuration, and the brute-force guard."
