echo "[Everlomp] Removing installer metadata..."
rm -f -- \
    "${HOME_DIR}/wordpress.json" \
    "${HOME_DIR}/drupal.json" \
    "${HOME_DIR}/phpbb.json" \
    "${HOME_DIR}/filegator.json" \
    "${HOME_DIR}/realip-failed" \
    "${HOME_DIR}/hotpocket-site.json" \
    "${HOME_DIR}/terms.md"

# Remove the state directory only if no runtime/unknown files remain in it.
rmdir -- "$STATE_DIR" 2>/dev/null || true

echo "[Everlomp] Removing installer helper programs..."
INSTALLER_HELPERS=(
    /usr/local/sbin/everlomp-database
    /usr/local/sbin/everlomp-wordpress
    /usr/local/sbin/everlomp-phpbb
    /usr/local/sbin/everlomp-external-installer
    /usr/local/sbin/everlomp-filegator
    /usr/local/sbin/everlomp-phpmyadmin
    /usr/local/sbin/everlomp-realip
    /usr/local/sbin/everlomp-hotpocket
    /usr/local/sbin/everlomp-ssh
    /usr/local/sbin/everlomp-lsws-password
    /usr/local/sbin/everlomp-backup
    /usr/local/sbin/everlomp-drupal
    /usr/local/sbin/everlomp-drupal-git
    /usr/local/lib/everlomp-drupal-runner.php
)
for helper in "${INSTALLER_HELPERS[@]}"; do
    rm -f -- "$helper"
done

echo "[Everlomp] Removing installer sudoers rules..."
rm -f -- "$WEB_SUDOERS" "$DRUPAL_GIT_SUDOERS"

# primary-app is an installer completion marker; installed applications and their
# runtime secrets/configuration remain in their dedicated locations.
rm -f -- "$PRIMARY_APP_FILE"

if [ -e "$INSTALL_FILE" ] || [ -L "$INSTALL_FILE" ]; then
    echo "[Everlomp] WARNING: Final verification: $INSTALL_FILE still exists." >&2
else
    echo "[Everlomp] Final verification passed: installer file is absent."
fi

# Keep these deliberately: EverAdmin restart/recovery watcher + sudoers, WordPress
# migration runtime helper, Kopia/backup services, FileGator runtime, real-IP config,
# DB/application secrets, OpenLiteSpeed, MariaDB, SSH runtime, and HotPocket itself.
rm -f -- "$SELF"

echo "[Everlomp] Installer cleanup completed successfully."
echo "[Everlomp] Removed installer UI, bundled app archives, package libraries, installer metadata, installer-only helpers, and installer sudoers rules."
echo "[Everlomp] Kept runtime components/data, including the installed primary application, EverAdmin restart/recovery watcher, FileGator, Kopia, SQL backup scheduling/runtime, phpMyAdmin, MariaDB, OpenLiteSpeed, HotPocket, SSH when enabled, application files/secrets, real-IP runtime configuration, and the brute-force guard."
