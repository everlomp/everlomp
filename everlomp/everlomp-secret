#!/usr/bin/env python3
import base64
import json
import os
import re
import stat
import sys
import tempfile
from pathlib import Path

from cryptography.hazmat.primitives.ciphers.aead import AESGCM

KEY_PATH = Path('/run/secrets/key')
MODE_PATH = Path('/var/www/.everlomp/key-mode')
SECRET_ROOT = Path('/home/everlomp/secrets')
AAD = b'everlomp-secret-v1'


def mode():
    try:
        value = MODE_PATH.read_text(encoding='utf-8').strip()
    except OSError:
        value = 'undecided'
    if value not in {'enabled', 'disabled', 'pending', 'undecided'}:
        value = 'undecided'
    return value


def decode_key():
    raw = KEY_PATH.read_bytes().strip()
    if not raw or raw == b'placeholder-only':
        raise RuntimeError('Everlomp encryption is enabled but /run/secrets/key is not configured.')
    try:
        text = raw.decode('ascii')
    except UnicodeDecodeError:
        text = ''
    if re.fullmatch(r'[0-9A-Fa-f]{64}', text):
        key = bytes.fromhex(text)
    elif re.fullmatch(r'[A-Za-z0-9_-]{43}={0,1}', text):
        key = base64.urlsafe_b64decode(text + '=' * ((4 - len(text) % 4) % 4))
    elif len(raw) == 32:
        key = raw
    else:
        raise RuntimeError('Everlomp key must decode to exactly 32 bytes.')
    if len(key) != 32:
        raise RuntimeError('Everlomp key must decode to exactly 32 bytes.')
    return key


def encrypted_path(path):
    return Path(str(path) + '.enc')


def validate_secret_destination(path):
    path = Path(os.path.abspath(os.path.normpath(str(path))))
    root = Path(os.path.abspath(os.path.normpath(str(SECRET_ROOT))))

    try:
        if os.path.commonpath((str(root), str(path))) != str(root):
            raise ValueError
        relative = path.relative_to(root)
    except (ValueError, OSError) as exc:
        raise RuntimeError(
            f'Everlomp persistent secrets must be stored under {SECRET_ROOT}. '
            f'Attempted destination: {path}'
        ) from exc

    if not relative.parts:
        raise RuntimeError('Everlomp secret destination must be a file below the secret root.')

    current = root
    for part in relative.parts[:-1]:
        current = current / part
        try:
            mode_bits = current.lstat().st_mode
        except FileNotFoundError:
            continue
        if stat.S_ISLNK(mode_bits):
            raise RuntimeError(
                f'Everlomp persistent secret path contains a symlinked directory: {current}'
            )

    return path


def atomic_write(path, data, mode_bits=0o600):
    path.parent.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(path.parent, 0o700)
    except OSError:
        pass
    fd, tmp_name = tempfile.mkstemp(prefix='.' + path.name + '.', dir=str(path.parent))
    try:
        with os.fdopen(fd, 'wb') as f:
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp_name, mode_bits)
        os.replace(tmp_name, path)
        os.chmod(path, mode_bits)
    finally:
        try:
            os.unlink(tmp_name)
        except FileNotFoundError:
            pass


def encrypt(data):
    key = decode_key()
    nonce = os.urandom(12)
    ciphertext = AESGCM(key).encrypt(nonce, data, AAD)
    envelope = {
        'v': 1,
        'alg': 'AES-256-GCM',
        'nonce': base64.urlsafe_b64encode(nonce).decode('ascii').rstrip('='),
        'ciphertext': base64.urlsafe_b64encode(ciphertext).decode('ascii').rstrip('='),
    }
    return (json.dumps(envelope, separators=(',', ':')) + '\n').encode('ascii')


def b64decode(value):
    return base64.urlsafe_b64decode(value + '=' * ((4 - len(value) % 4) % 4))


def decrypt(blob):
    try:
        envelope = json.loads(blob.decode('ascii'))
        if envelope.get('v') != 1 or envelope.get('alg') != 'AES-256-GCM':
            raise ValueError
        nonce = b64decode(envelope['nonce'])
        ciphertext = b64decode(envelope['ciphertext'])
    except Exception as exc:
        raise RuntimeError('Encrypted Everlomp secret has an invalid format.') from exc
    return AESGCM(decode_key()).decrypt(nonce, ciphertext, AAD)


def read_secret(path):
    current_mode = mode()
    path = Path(path)
    enc = encrypted_path(path)
    if current_mode == 'enabled':
        if enc.is_file():
            return decrypt(enc.read_bytes())
        if path.is_file():
            data = path.read_bytes()
            atomic_write(enc, encrypt(data))
            path.unlink()
            return data
        raise FileNotFoundError(str(path))
    if current_mode == 'disabled':
        if path.is_file():
            return path.read_bytes()
        raise FileNotFoundError(str(path))
    raise RuntimeError('Everlomp key choice has not been finalized.')


def write_secret(path, data):
    current_mode = mode()
    path = validate_secret_destination(path)
    enc = encrypted_path(path)
    if current_mode == 'enabled':
        atomic_write(enc, encrypt(data))
        try:
            path.unlink()
        except FileNotFoundError:
            pass
        return
    if current_mode == 'disabled':
        atomic_write(path, data)
        try:
            enc.unlink()
        except FileNotFoundError:
            pass
        return
    raise RuntimeError('Everlomp key choice has not been finalized.')


def exists(path):
    path = Path(path)
    current_mode = mode()
    if current_mode == 'enabled':
        return encrypted_path(path).is_file() or path.is_file()
    if current_mode == 'disabled':
        return path.is_file()
    return False


def materialize(source, dest, web=False):
    data = read_secret(source)
    dest = Path(dest)
    atomic_write(dest, data, 0o640 if web else 0o600)
    if web:
        try:
            import grp
            gid = grp.getgrnam('nogroup').gr_gid
            os.chown(dest.parent, 0, gid)
            os.chmod(dest.parent, 0o750)
            os.chown(dest, 0, gid)
            os.chmod(dest, 0o640)
        except Exception:
            pass


def main():
    if len(sys.argv) < 3:
        print('Usage: everlomp-secret {read|write|exists|remove|materialize|materialize-web} PATH [DEST]', file=sys.stderr)
        return 2
    action = sys.argv[1]
    path = Path(sys.argv[2])
    try:
        if action == 'read':
            sys.stdout.buffer.write(read_secret(path))
        elif action == 'write':
            write_secret(path, sys.stdin.buffer.read())
        elif action == 'exists':
            return 0 if exists(path) else 1
        elif action == 'remove':
            for p in (path, encrypted_path(path)):
                try:
                    p.unlink()
                except FileNotFoundError:
                    pass
        elif action in {'materialize', 'materialize-web'}:
            if len(sys.argv) != 4:
                raise RuntimeError('materialize requires SOURCE and DEST.')
            materialize(path, Path(sys.argv[3]), web=(action == 'materialize-web'))
        else:
            raise RuntimeError('Unknown action.')
    except FileNotFoundError:
        return 1
    except Exception as exc:
        print(str(exc), file=sys.stderr)
        return 3
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
