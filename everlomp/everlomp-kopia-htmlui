#!/bin/bash
set -euo pipefail

ACTION="${1:-}"
BASE_URL="/kopia/"
PATCHER="/usr/local/sbin/kopia-htmlui-patch.py"
HTACCESS_SOURCE="/usr/local/share/everlomp/kopia.htaccess"
STAGED_UI="/usr/local/share/everlomp/kopia-htmlui"
LIVE_UI="/var/www/html/kopia"

log() {
    printf '[Kopia HTMLUI] %s\n' "$*" >&2
}

normalize_version() {
    local raw="$1"
    printf '%s\n' "$raw" \
        | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' \
        | head -n1
}

current_version() {
    local raw
    raw="$(/usr/bin/kopia --version 2>/dev/null | head -n1 || true)"
    normalize_version "$raw"
}

resolve_htmlui_source_sha() {
    local version="$1"
    local go_mod
    local build_commit
    local metadata
    local source_sha

    log "Resolving HTMLUI source for Kopia v${version}."

    go_mod="$(
        curl -fsSL \
            --retry 3 \
            --retry-delay 1 \
            "https://raw.githubusercontent.com/kopia/kopia/v${version}/go.mod"
    )"

    build_commit="$(
        printf '%s\n' "$go_mod" \
            | awk '$1 == "github.com/kopia/htmluibuild" {print $2; exit}' \
            | sed -nE 's/.*-([0-9a-f]{12,40})$/\1/p'
    )"

    if [ -z "$build_commit" ]; then
        log "Could not resolve htmluibuild commit from Kopia v${version} go.mod."
        return 1
    fi

    metadata="$(
        curl -fsSL \
            --retry 3 \
            --retry-delay 1 \
            -H 'Accept: application/vnd.github+json' \
            -H 'User-Agent: Everlomp-Kopia-HTMLUI-Builder' \
            "https://api.github.com/repos/kopia/htmluibuild/commits/${build_commit}"
    )"

    source_sha="$(
        printf '%s' "$metadata" \
            | python3 -c '
import json, re, sys
obj = json.load(sys.stdin)
message = obj.get("commit", {}).get("message", "")
m = re.search(r"github\.com/kopia/htmlui/commit/([0-9a-f]{40})", message)
if m:
    print(m.group(1))
'
    )"

    if [ -z "$source_sha" ]; then
        log "htmluibuild commit ${build_commit} did not identify its htmlui source commit."
        return 1
    fi

    log "Kopia v${version}: htmluibuild=${build_commit}, htmlui=${source_sha}."
    printf '%s\n' "$source_sha"
}

build_ui() {
    local requested_version="$1"
    local output="$2"
    local version
    local source_sha
    local work

    version="$(normalize_version "$requested_version")"
    if [ -z "$version" ]; then
        log "Invalid Kopia version: ${requested_version}"
        return 2
    fi

    [ -x "$PATCHER" ] || {
        log "Missing HTMLUI source patcher: $PATCHER"
        return 3
    }

    source_sha="${KOPIA_HTMLUI_SOURCE_SHA:-}"
    if [ -z "$source_sha" ]; then
        source_sha="$(resolve_htmlui_source_sha "$version")"
    else
        log "Using explicitly supplied HTMLUI source commit ${source_sha}."
    fi

    case "$source_sha" in
        [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]*) ;;
        *)
            log "Invalid HTMLUI source SHA: ${source_sha}"
            return 4
            ;;
    esac

    work="$(mktemp -d /tmp/everlomp-kopia-htmlui.XXXXXX)"

    mkdir -p "$work/source"

    log "Downloading official kopia/htmlui source ${source_sha}."
    curl -fsSL \
        --retry 3 \
        --retry-delay 1 \
        "https://codeload.github.com/kopia/htmlui/tar.gz/${source_sha}" \
        | tar -xz --strip-components=1 -C "$work/source"

    printf '%s\n' "$version" > "$work/source/EVERLOMP_KOPIA_VERSION"
    printf '%s\n' "$source_sha" > "$work/source/EVERLOMP_HTMLUI_SOURCE_SHA"

    python3 "$PATCHER" app "$work/source"

    log "Installing HTMLUI npm dependencies."
    (
        cd "$work/source"
        npm ci --no-audit --no-fund
    )

    python3 "$PATCHER" router-deps "$work/source/node_modules" "$BASE_URL"

    log "Building HTMLUI for ${BASE_URL}."
    (
        cd "$work/source"
        VITE_FULL_VERSION_INFO="v${version}" \
            npm run build -- --base="$BASE_URL"
    )

    local built=""
    if [ -f "$work/source/build/index.html" ]; then
        built="$work/source/build"
    elif [ -f "$work/source/dist/index.html" ]; then
        built="$work/source/dist"
    else
        log "Vite completed but no build/index.html or dist/index.html was found."
        return 5
    fi

    rm -rf "$output"
    mkdir -p "$output"
    cp -a "$built"/. "$output"/

    printf '%s\n' "$version" > "$output/EVERLOMP_KOPIA_VERSION"
    printf '%s\n' "$source_sha" > "$output/EVERLOMP_HTMLUI_SOURCE_SHA"

    if ! grep -q '/kopia/' "$output/index.html"; then
        log "Built index.html does not contain the expected /kopia/ public base."
        return 6
    fi

    if ! grep -Rqs --include='*.js' '/kopia/' "$output"; then
        log "Built JavaScript does not contain the expected /kopia/ base."
        return 7
    fi

    find "$output" -type d -exec chmod 0755 {} +
    find "$output" -type f -exec chmod 0644 {} +

    rm -rf "$work"

    log "Built Kopia HTMLUI v${version} for ${BASE_URL}."
}

replace_tree() {
    local source="$1"
    local target="$2"
    local parent
    local name
    local new
    local old

    [ -f "$source/index.html" ] || {
        log "Source UI has no index.html: $source"
        return 10
    }

    parent="$(dirname "$target")"
    name="$(basename "$target")"
    new="$parent/.${name}.new.$$"
    old="$parent/.${name}.old.$$"

    mkdir -p "$parent"
    rm -rf "$new" "$old"
    mkdir -p "$new"
    cp -a "$source"/. "$new"/

    if [ -f "$HTACCESS_SOURCE" ]; then
        cp -f "$HTACCESS_SOURCE" "$new/.htaccess"
    fi

    find "$new" -type d -exec chmod 0755 {} +
    find "$new" -type f -exec chmod 0644 {} +

    if [ -e "$target" ]; then
        mv "$target" "$old"
    fi

    if ! mv "$new" "$target"; then
        if [ -e "$old" ]; then
            mv "$old" "$target" || true
        fi
        return 11
    fi

    rm -rf "$old"
}

install_build() {
    local source="$1"

    [ -f "$HTACCESS_SOURCE" ] || {
        log "Missing SPA rewrite file: $HTACCESS_SOURCE"
        return 12
    }

    replace_tree "$source" "$STAGED_UI"
    replace_tree "$STAGED_UI" "$LIVE_UI"

    log "Installed static Kopia HTMLUI into $LIVE_UI."
}

sync_staged() {
    [ -f "$STAGED_UI/index.html" ] || {
        log "Staged HTMLUI is missing: $STAGED_UI"
        return 13
    }

    replace_tree "$STAGED_UI" "$LIVE_UI"
    log "Synced staged Kopia HTMLUI into persistent web root."
}

case "$ACTION" in
    build)
        version="${2:-}"
        output="${3:-}"
        [ -n "$version" ] && [ -n "$output" ] || {
            echo "usage: $0 build <kopia-version> <output-directory>" >&2
            exit 64
        }
        build_ui "$version" "$output"
        ;;

    install)
        source_dir="${2:-}"
        [ -n "$source_dir" ] || {
            echo "usage: $0 install <built-ui-directory>" >&2
            exit 64
        }
        install_build "$source_dir"
        ;;

    refresh)
        requested="${2:-}"
        if [ -z "$requested" ]; then
            requested="$(current_version)"
        fi
        [ -n "$requested" ] || {
            log "Could not determine installed Kopia version."
            exit 65
        }

        temp_build="$(mktemp -d /tmp/everlomp-kopia-htmlui-build.XXXXXX)"
        trap 'rm -rf "$temp_build"' EXIT
        build_ui "$requested" "$temp_build"
        install_build "$temp_build"
        ;;

    sync)
        sync_staged
        ;;

    *)
        echo "usage: $0 {build <version> <dir>|install <dir>|refresh [version]|sync}" >&2
        exit 64
        ;;
esac
