#!/bin/bash
set -euo pipefail

ACTION="${1:-}"

BASE="/home/everlomp/kopia"
SECRETS_ROOT="/home/everlomp/secrets"
KOPIA_SECRETS="$SECRETS_ROOT/kopia"
INFO="/home/everlomp/kopia.json"
BACKUP_CONFIG="/home/everlomp/backup.json"
EVERBACKUPS_DIR="/home/everlomp/everbackups"
SQL_BACKUP_DIR="$EVERBACKUPS_DIR/sql"
DEFAULT_WWW_SOURCE="/var/www"
OFFSITE_STORE="$KOPIA_SECRETS/offsite.json"
REPO_PASSWORD_STORE="$KOPIA_SECRETS/repository.password"
WEB_PASSWORD_STORE="$KOPIA_SECRETS/webui.password"
REPO_CONFIG="$KOPIA_SECRETS/repository.config"
OFFSITE_CONFIG="/run/everlomp-kopia-offsite.$$"
LEGACY_OFFSITE_S3_CONFIG="$BASE/offsite-s3.json"
OFFSITE_SYNC_LOCK="/run/everlomp-kopia-offsite-sync.lock"

SUPERVISOR_CONF="/etc/everlomp/supervisord.conf"
SUPERVISORCTL="/usr/bin/supervisorctl"
KOPIA="/usr/local/bin/kopia"
CUSTOM_KOPIA_HELPER="/usr/local/sbin/everlomp-kopia-custom"
REPLICATION_HELPER="/usr/local/sbin/everlomp-kopia-replication"
LOCAL_KOPIA_DIR="/usr/local/share/everlomp/kopia-local"
SECRET_HELPER="/usr/local/sbin/everlomp-secret"

OLS_VHCONF="/usr/local/lsws/conf/vhosts/GPTCP1/vhconf.conf"
OLS_BIN="/usr/local/lsws/bin/openlitespeed"
OLS_CTRL="/usr/local/lsws/bin/lswsctrl"

mkdir -p /home/everlomp /var/log/supervisor /var/log/everlomp
install -d -o root -g root -m 0700 "$SECRETS_ROOT" "$KOPIA_SECRETS"
install -d -o root -g nogroup -m 0750 /run/everlomp
trap 'rm -f "$OFFSITE_CONFIG"' EXIT

if "$SECRET_HELPER" exists "$OFFSITE_STORE"; then
    "$SECRET_HELPER" materialize "$OFFSITE_STORE" "$OFFSITE_CONFIG"
fi

ensure_kopia_build_environment() {
    local packages=()
    local cmd

    command -v git >/dev/null 2>&1 || packages+=(git)
    command -v go >/dev/null 2>&1 || packages+=(golang-go)

    if ((${#packages[@]})); then
        echo "Installing Kopia build dependencies: ${packages[*]}" >&2

        local apt_ubuntu_opts=(
            -o Dir::Etc::sourcelist=/etc/apt/sources.list.d/ubuntu.sources
            -o Dir::Etc::sourceparts=-
        )

        DEBIAN_FRONTEND=noninteractive \
        apt-get "${apt_ubuntu_opts[@]}" update 1>&2

        DEBIAN_FRONTEND=noninteractive \
        apt-get "${apt_ubuntu_opts[@]}" install -y \
            --no-install-recommends \
            "${packages[@]}" 1>&2

        rm -rf /var/lib/apt/lists/*
    fi

    for cmd in tar make node npm git go; do
        command -v "$cmd" >/dev/null 2>&1 || {
            echo "Required Kopia build command is unavailable: $cmd" >&2
            return 1
        }
    done
}

local_kopia_sources_available() {
    [ -s "$LOCAL_KOPIA_DIR/kopia_source.tar.gz" ] \
        && [ -s "$LOCAL_KOPIA_DIR/htmlui_source.tar.gz" ]
}

install_local_kopia_source() {
    local kopia_archive="$LOCAL_KOPIA_DIR/kopia_source.tar.gz"
    local htmlui_archive="$LOCAL_KOPIA_DIR/htmlui_source.tar.gz"
    local version
    local build_dir

    [ -x "$CUSTOM_KOPIA_HELPER" ] || {
        echo "Everlomp custom Kopia builder is missing: $CUSTOM_KOPIA_HELPER" >&2
        return 1
    }

    if ! local_kopia_sources_available; then
        echo "Local Kopia install requires BOTH everlomp/local-kopia/kopia_source.tar.gz and everlomp/local-kopia/htmlui_source.tar.gz in the image." >&2
        return 1
    fi

    ensure_kopia_build_environment

    version="$("$CUSTOM_KOPIA_HELPER" local-version "$kopia_archive" 2>/dev/null || true)"
    [ -n "$version" ] || {
        echo "Bundled Kopia source archive is invalid or its version could not be detected: $kopia_archive" >&2
        return 1
    }

    echo "Building bundled Kopia source v${version} with bundled HTMLUI and Everlomp's /kopia/ UI patch." >&2

    build_dir="$(mktemp -d /tmp/everlomp-kopia-local.XXXXXX)"
    if ! "$CUSTOM_KOPIA_HELPER" build-local \
        "$kopia_archive" \
        "$htmlui_archive" \
        "$build_dir/kopia" \
        1>&2; then
        rm -rf "$build_dir"
        return 1
    fi

    if ! "$CUSTOM_KOPIA_HELPER" install \
        "$build_dir/kopia" \
        "$version" \
        1>&2; then
        rm -rf "$build_dir"
        return 1
    fi

    rm -rf "$build_dir"

    "$CUSTOM_KOPIA_HELPER" verify \
        "$KOPIA" \
        "$version" \
        >/dev/null
}


ensure_custom_kopia_binary() {
    local mode="${1:-online}"
    local target_version

    if [ "$mode" = "local" ]; then
        install_local_kopia_source
        return
    fi

    [ "$mode" = "online" ] || {
        echo "Unknown Kopia installation source: $mode" >&2
        return 1
    }

    [ -x "$CUSTOM_KOPIA_HELPER" ] || {
        echo "Everlomp custom Kopia builder is missing: $CUSTOM_KOPIA_HELPER" >&2
        return 1
    }

    ensure_kopia_build_environment

    target_version="$(
        "$CUSTOM_KOPIA_HELPER" latest-version 2>/dev/null || true
    )"

    [ -n "$target_version" ] || {
        echo "Could not resolve the latest stable Kopia release." >&2
        return 1
    }

    if "$CUSTOM_KOPIA_HELPER" verify \
        "$KOPIA" \
        "$target_version" \
        >/dev/null 2>&1; then
        return 0
    fi

    echo "Building Everlomp's /kopia/-aware Kopia ${target_version}." >&2

    local build_dir
    build_dir="$(mktemp -d /tmp/everlomp-kopia-setup.XXXXXX)"
    if ! "$CUSTOM_KOPIA_HELPER" build \
        "$target_version" \
        "$build_dir/kopia" \
        1>&2; then
        rm -rf "$build_dir"
        return 1
    fi

    if ! "$CUSTOM_KOPIA_HELPER" install \
        "$build_dir/kopia" \
        "$target_version" \
        1>&2; then
        rm -rf "$build_dir"
        return 1
    fi
    rm -rf "$build_dir"

    "$CUSTOM_KOPIA_HELPER" verify \
        "$KOPIA" \
        "$target_version" \
        >/dev/null
}


set_web_state_permissions() {
    local file="$1"

    [ -e "$file" ] || return 0

    chown root:root "$file"
    chmod 0644 "$file"
}

repair_web_state_permissions() {
    set_web_state_permissions "$INFO"
    set_web_state_permissions "$BACKUP_CONFIG"
}


json_write_backup_settings() {
    local kind="$1"
    local payload="$2"

    python3 - "$BACKUP_CONFIG" "$kind" "$payload" <<'PY'
from pathlib import Path
import json
import os
import sys
import tempfile

path = Path(sys.argv[1])
kind = sys.argv[2]
payload = json.loads(sys.argv[3])

try:
    data = json.loads(path.read_text()) if path.exists() else {}
    if not isinstance(data, dict):
        data = {}
except Exception:
    data = {}

if kind == "sql":
    for key in (
        "sql_enabled",
        "sql_schedule",
        "sql_time",
        "sql_weekday",
        "sql_keep",
    ):
        data[key] = payload[key]

elif kind == "update":
    for key in (
        "kopia_auto_update",
        "kopia_update_schedule",
        "kopia_update_time",
        "kopia_update_weekday",
    ):
        data[key] = payload[key]

elif kind == "offsite":
    old_type = data.get("offsite_type", "")
    new_type = payload.get("offsite_type", "")
    identity_keys = (
        "offsite_host", "offsite_port", "offsite_username", "offsite_path",
        "offsite_url", "offsite_endpoint", "offsite_bucket",
        "offsite_region", "offsite_prefix", "offsite_rclone_remote_path",
    )
    target_changed = old_type != new_type or any(
        key in payload and data.get(key) != payload.get(key)
        for key in identity_keys
    )

    # Provider-specific values are public connection metadata only. Secrets
    # live under /home/everlomp/secrets/kopia/ and are protected by everlomp-secret. Remove stale
    # fields when changing providers so the UI cannot accidentally display
    # details from the previous target.
    for key in list(data):
        if key.startswith("offsite_") and key not in (
            "offsite_last_run",
            "offsite_last_status",
            "offsite_last_detail",
        ):
            data.pop(key, None)

    for key, value in payload.items():
        if key.startswith("offsite_"):
            data[key] = value

    if target_changed:
        data.pop("offsite_last_run", None)
        data.pop("offsite_last_status", None)
        data.pop("offsite_last_detail", None)

else:
    raise SystemExit("unknown settings kind")

fd, tmp = tempfile.mkstemp(prefix=".backup.", dir=str(path.parent))
os.close(fd)

Path(tmp).write_text(
    json.dumps(data, indent=2, sort_keys=True) + "\n"
)

os.replace(tmp, path)
PY

    set_web_state_permissions "$BACKUP_CONFIG"
}


write_offsite_secret_config() {
    local provider="$1"
    local payload="$2"

    install -d -o everlomp -g everlomp -m 0700 "$BASE"

    if [ ! -s "$OFFSITE_CONFIG" ] && [ "$provider" = "s3" ] \
        && [ -s "$LEGACY_OFFSITE_S3_CONFIG" ]; then
        python3 - "$LEGACY_OFFSITE_S3_CONFIG" "$OFFSITE_CONFIG" <<'PYMIGRATE'
from pathlib import Path
import json, os, sys
src, dst = map(Path, sys.argv[1:3])
try:
    old = json.loads(src.read_text())
except Exception:
    old = {}
old["type"] = "s3"
dst.write_text(json.dumps(old, indent=2, sort_keys=True) + "\n")
os.chmod(dst, 0o600)
PYMIGRATE
    fi

    python3 - "$OFFSITE_CONFIG" "$provider" "$payload" <<'PYOFFSITE'
from pathlib import Path
import json
import os
import sys
import tempfile

path = Path(sys.argv[1])
provider = sys.argv[2]
payload = json.loads(sys.argv[3])

try:
    existing = json.loads(path.read_text()) if path.exists() else {}
    if not isinstance(existing, dict) or existing.get("type") != provider:
        existing = {}
except Exception:
    existing = {}

secret = {"type": provider}
for key, value in existing.items():
    if key != "type":
        secret[key] = value

# Blank secret fields mean "keep the existing value". This makes it possible
# to change schedules or public connection details without retyping secrets.
for key, value in payload.items():
    if key.startswith("_"):
        continue
    if value is None:
        continue
    if isinstance(value, str) and value == "":
        continue
    secret[key] = value

# A newly supplied S3 key pair intentionally replaces an old session token
# with the submitted value (including blank), so temporary credentials can be
# converted back to long-lived credentials cleanly.
if provider == "s3" and payload.get("_replace_s3_credentials"):
    secret["session_token"] = payload.get("session_token", "")

fd, tmp = tempfile.mkstemp(prefix=".offsite.", dir=str(path.parent))
os.close(fd)
Path(tmp).write_text(json.dumps(secret, indent=2, sort_keys=True) + "\n")
os.chmod(tmp, 0o600)
os.replace(tmp, path)
os.chmod(path, 0o600)
PYOFFSITE

    chown root:root "$OFFSITE_CONFIG"
    chmod 0600 "$OFFSITE_CONFIG"
    "$SECRET_HELPER" write "$OFFSITE_STORE" < "$OFFSITE_CONFIG"
    rm -f "$LEGACY_OFFSITE_S3_CONFIG" 2>/dev/null || true
}


record_offsite_sync_result() {
    local status="$1"
    local detail="${2:-}"

    python3 - "$BACKUP_CONFIG" "$status" "$detail" <<'PYRESULT'
from pathlib import Path
from datetime import datetime, timezone
import json
import os
import sys
import tempfile

path = Path(sys.argv[1])
status = sys.argv[2]
detail = sys.argv[3]

try:
    data = json.loads(path.read_text()) if path.exists() else {}
    if not isinstance(data, dict):
        data = {}
except Exception:
    data = {}

data["offsite_last_run"] = datetime.now(timezone.utc).isoformat(timespec="seconds")
data["offsite_last_status"] = status
data["offsite_last_detail"] = detail[:240]

fd, tmp = tempfile.mkstemp(prefix=".backup.", dir=str(path.parent))
os.close(fd)
Path(tmp).write_text(json.dumps(data, indent=2, sort_keys=True) + "\n")
os.replace(tmp, path)
PYRESULT

    set_web_state_permissions "$BACKUP_CONFIG"
}


existing_offsite_secret() {
    local provider="$1" key="$2"
    [ -s "$OFFSITE_CONFIG" ] || return 0
    [ "$(jq -r '.type // ""' "$OFFSITE_CONFIG" 2>/dev/null)" = "$provider" ] || return 0
    jq -r --arg key "$key" '.[$key] // ""' "$OFFSITE_CONFIG" 2>/dev/null || true
}


validate_offsite_common() {
    local enabled="$1" provider="$2" schedule="$3" time="$4" weekday="$5"

    [[ "$enabled" == "true" || "$enabled" == "false" ]] || {
        echo "Invalid off-site enabled value." >&2
        return 1
    }

    case "$provider" in
        sftp|webdav|filesystem|s3|from-config|rclone) ;;
        *) echo "Unsupported off-site destination type." >&2; return 1 ;;
    esac

    [[ "$schedule" =~ ^(hourly|every6h|every12h|daily|weekly)$ ]] || {
        echo "Invalid off-site sync schedule." >&2
        return 1
    }
    if [[ "$schedule" == "daily" || "$schedule" == "weekly" ]]; then
        [[ "$time" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]] || {
            echo "Invalid off-site sync time." >&2
            return 1
        }
    fi
    if [ "$schedule" = "weekly" ]; then
        [[ "$weekday" =~ ^[0-6]$ ]] || {
            echo "Invalid off-site sync weekday." >&2
            return 1
        }
    fi
}


save_offsite_configuration() {
    local payload="$1"
    local enabled provider schedule time weekday

    enabled="$(jq -r '.enabled // false' <<<"$payload")"
    provider="$(jq -r '.type // "sftp"' <<<"$payload")"
    schedule="$(jq -r '.schedule // "every6h"' <<<"$payload")"
    time="$(jq -r '.time // "03:30"' <<<"$payload")"
    weekday="$(jq -r '.weekday // 0' <<<"$payload")"

    validate_offsite_common "$enabled" "$provider" "$schedule" "$time" "$weekday"

    local secret_payload='{}'
    local public_payload

    case "$provider" in
        sftp)
            local host port username remote_path auth_mode password private_key known_hosts
            host="$(jq -r '.sftp.host // ""' <<<"$payload")"
            port="$(jq -r '.sftp.port // 22' <<<"$payload")"
            username="$(jq -r '.sftp.username // ""' <<<"$payload")"
            remote_path="$(jq -r '.sftp.path // ""' <<<"$payload")"
            auth_mode="$(jq -r '.sftp.auth_mode // "key"' <<<"$payload")"
            password="$(jq -r '.sftp.password // ""' <<<"$payload")"
            private_key="$(jq -r '.sftp.private_key // ""' <<<"$payload")"
            known_hosts="$(jq -r '.sftp.known_hosts // ""' <<<"$payload")"

            if [ "$enabled" = "true" ]; then
                [ -n "$host" ] && [ "${#host}" -le 255 ] && [[ "$host" != *$'\n'* ]] || { echo "Enter a valid SFTP/SSH host." >&2; return 1; }
                [[ "$port" =~ ^[0-9]+$ ]] && [ "$port" -ge 1 ] && [ "$port" -le 65535 ] || { echo "SFTP port must be between 1 and 65535." >&2; return 1; }
                [ -n "$username" ] && [ "${#username}" -le 255 ] || { echo "Enter the SFTP/SSH username." >&2; return 1; }
                [ -n "$remote_path" ] && [ "${#remote_path}" -le 1024 ] || { echo "Enter the remote SFTP repository path." >&2; return 1; }
                [[ "$auth_mode" == "password" || "$auth_mode" == "key" ]] || { echo "SFTP authentication must use a password or private key." >&2; return 1; }
            fi

            local effective_password effective_private_key
            effective_password="$password"
            effective_private_key="$private_key"
            [ -n "$effective_password" ] || effective_password="$(existing_offsite_secret sftp password)"
            [ -n "$effective_private_key" ] || effective_private_key="$(existing_offsite_secret sftp private_key)"
            if [ "$enabled" = "true" ]; then
                if [ "$auth_mode" = "password" ]; then
                    [ -n "$effective_password" ] || { echo "SFTP password is required for password authentication." >&2; return 1; }
                else
                    [ -n "$effective_private_key" ] || { echo "Paste an SSH private key for key authentication." >&2; return 1; }
                fi
            fi
            secret_payload="$(jq -n --arg password "$password" --arg private_key "$private_key" --arg known_hosts "$known_hosts" '{password:$password,private_key:$private_key,known_hosts:$known_hosts}')"
            write_offsite_secret_config sftp "$secret_payload"

            public_payload="$(jq -n --argjson enabled "$enabled" --arg type "$provider" --arg host "$host" --argjson port "$port" --arg username "$username" --arg path "$remote_path" --arg auth "$auth_mode" --arg schedule "$schedule" --arg time "$time" --argjson weekday "$weekday" '{offsite_enabled:$enabled,offsite_type:$type,offsite_host:$host,offsite_port:$port,offsite_username:$username,offsite_path:$path,offsite_auth_mode:$auth,offsite_schedule:$schedule,offsite_time:$time,offsite_weekday:$weekday}')"
            ;;

        webdav)
            local url username password
            url="$(jq -r '.webdav.url // ""' <<<"$payload")"
            username="$(jq -r '.webdav.username // ""' <<<"$payload")"
            password="$(jq -r '.webdav.password // ""' <<<"$payload")"
            if [ "$enabled" = "true" ]; then
                [[ "$url" =~ ^https?:// ]] && [ "${#url}" -le 2048 ] || { echo "WebDAV URL must begin with http:// or https://." >&2; return 1; }
                [ -n "$username" ] && [ "${#username}" -le 512 ] || { echo "Enter the WebDAV username." >&2; return 1; }
            fi
            local effective_password
            effective_password="$password"
            [ -n "$effective_password" ] || effective_password="$(existing_offsite_secret webdav password)"
            if [ "$enabled" = "true" ]; then
                [ -n "$effective_password" ] || { echo "WebDAV password is required." >&2; return 1; }
            fi
            secret_payload="$(jq -n --arg password "$password" '{password:$password}')"
            write_offsite_secret_config webdav "$secret_payload"
            public_payload="$(jq -n --argjson enabled "$enabled" --arg type "$provider" --arg url "$url" --arg username "$username" --arg schedule "$schedule" --arg time "$time" --argjson weekday "$weekday" '{offsite_enabled:$enabled,offsite_type:$type,offsite_url:$url,offsite_username:$username,offsite_schedule:$schedule,offsite_time:$time,offsite_weekday:$weekday}')"
            ;;

        filesystem)
            local dest_path
            dest_path="$(jq -r '.filesystem.path // ""' <<<"$payload")"
            if [ "$enabled" = "true" ]; then
                [[ "$dest_path" = /* ]] && [ "${#dest_path}" -le 2048 ] && [[ "$dest_path" != *$'\n'* ]] || { echo "Mounted filesystem destination must be an absolute path." >&2; return 1; }
                local local_repo
                local_repo="$(jq -r '.repository_path // ""' "$INFO" 2>/dev/null || true)"
                [ "$dest_path" != "$local_repo" ] || { echo "Remote filesystem path cannot be the local Kopia repository itself." >&2; return 1; }
                [ -d "$dest_path" ] || { echo "Mounted filesystem destination does not exist inside the container. Mount the NAS/storage first." >&2; return 1; }
                [ -w "$dest_path" ] || { echo "Mounted filesystem destination is not writable." >&2; return 1; }
            fi
            rm -f "$OFFSITE_CONFIG"
            "$SECRET_HELPER" remove "$OFFSITE_STORE"
            public_payload="$(jq -n --argjson enabled "$enabled" --arg type "$provider" --arg path "$dest_path" --arg schedule "$schedule" --arg time "$time" --argjson weekday "$weekday" '{offsite_enabled:$enabled,offsite_type:$type,offsite_path:$path,offsite_schedule:$schedule,offsite_time:$time,offsite_weekday:$weekday}')"
            ;;

        s3)
            local endpoint bucket region prefix access_key secret_key session_token replace_creds=false
            endpoint="$(jq -r '.s3.endpoint // ""' <<<"$payload")"
            bucket="$(jq -r '.s3.bucket // ""' <<<"$payload")"
            region="$(jq -r '.s3.region // ""' <<<"$payload")"
            prefix="$(jq -r '.s3.prefix // ""' <<<"$payload")"
            access_key="$(jq -r '.s3.access_key // ""' <<<"$payload")"
            secret_key="$(jq -r '.s3.secret_access_key // ""' <<<"$payload")"
            session_token="$(jq -r '.s3.session_token // ""' <<<"$payload")"
            if [ "$enabled" = "true" ]; then
                [[ "$endpoint" =~ ^[^[:space:]/]+$ ]] || { echo "S3 endpoint must be a hostname, optionally with a port, without http:// or https://." >&2; return 1; }
                [ -n "$bucket" ] && [ "${#bucket}" -le 255 ] || { echo "Enter the S3/MinIO bucket." >&2; return 1; }
            fi
            if [ -n "$access_key" ] || [ -n "$secret_key" ]; then
                [ -n "$access_key" ] && [ -n "$secret_key" ] || { echo "Provide both S3 access key and secret key when changing credentials." >&2; return 1; }
                replace_creds=true
            fi
            local effective_access_key effective_secret_key
            effective_access_key="$access_key"
            effective_secret_key="$secret_key"
            [ -n "$effective_access_key" ] || effective_access_key="$(existing_offsite_secret s3 access_key)"
            [ -n "$effective_secret_key" ] || effective_secret_key="$(existing_offsite_secret s3 secret_access_key)"
            if [ "$enabled" = "true" ]; then
                [ -n "$effective_access_key" ] && [ -n "$effective_secret_key" ] || { echo "S3/MinIO access key and secret key are required." >&2; return 1; }
            fi
            secret_payload="$(jq -n --arg access "$access_key" --arg secret "$secret_key" --arg token "$session_token" --argjson replace "$replace_creds" '{access_key:$access,secret_access_key:$secret,session_token:$token,_replace_s3_credentials:$replace}')"
            write_offsite_secret_config s3 "$secret_payload"
            public_payload="$(jq -n --argjson enabled "$enabled" --arg type "$provider" --arg endpoint "$endpoint" --arg bucket "$bucket" --arg region "$region" --arg prefix "$prefix" --arg schedule "$schedule" --arg time "$time" --argjson weekday "$weekday" '{offsite_enabled:$enabled,offsite_type:$type,offsite_endpoint:$endpoint,offsite_bucket:$bucket,offsite_region:$region,offsite_prefix:$prefix,offsite_schedule:$schedule,offsite_time:$time,offsite_weekday:$weekday}')"
            ;;

        from-config)
            local token
            token="$(jq -r '.from_config.token // ""' <<<"$payload")"
            local effective_token
            effective_token="$token"
            [ -n "$effective_token" ] || effective_token="$(existing_offsite_secret from-config token)"
            if [ "$enabled" = "true" ]; then
                [ -n "$effective_token" ] || { echo "Paste a Kopia configuration token for this destination." >&2; return 1; }
            fi
            secret_payload="$(jq -n --arg token "$token" '{token:$token}')"
            write_offsite_secret_config from-config "$secret_payload"
            public_payload="$(jq -n --argjson enabled "$enabled" --arg type "$provider" --arg schedule "$schedule" --arg time "$time" --argjson weekday "$weekday" '{offsite_enabled:$enabled,offsite_type:$type,offsite_schedule:$schedule,offsite_time:$time,offsite_weekday:$weekday}')"
            ;;

        rclone)
            local remote_path rclone_config
            remote_path="$(jq -r '.rclone.remote_path // ""' <<<"$payload")"
            rclone_config="$(jq -r '.rclone.config // ""' <<<"$payload")"
            if [ "$enabled" = "true" ]; then
                [ -n "$remote_path" ] && [ "${#remote_path}" -le 2048 ] || { echo "Enter an Rclone remote path such as remote:backups/everlomp." >&2; return 1; }
                command -v rclone >/dev/null 2>&1 || { echo "Rclone is not installed in this image." >&2; return 1; }
            fi
            local effective_rclone_config
            effective_rclone_config="$rclone_config"
            [ -n "$effective_rclone_config" ] || effective_rclone_config="$(existing_offsite_secret rclone rclone_config)"
            if [ "$enabled" = "true" ]; then
                [ -n "$effective_rclone_config" ] || { echo "Paste the rclone.conf content for this remote." >&2; return 1; }
            fi
            secret_payload="$(jq -n --arg config "$rclone_config" '{rclone_config:$config}')"
            write_offsite_secret_config rclone "$secret_payload"
            public_payload="$(jq -n --argjson enabled "$enabled" --arg type "$provider" --arg path "$remote_path" --arg schedule "$schedule" --arg time "$time" --argjson weekday "$weekday" '{offsite_enabled:$enabled,offsite_type:$type,offsite_rclone_remote_path:$path,offsite_schedule:$schedule,offsite_time:$time,offsite_weekday:$weekday}')"
            ;;
    esac

    json_write_backup_settings offsite "$public_payload"
}


test_offsite_connection() {
    local payload="$1"
    local provider
    provider="$(jq -r '.type // "sftp"' <<<"$payload")"

    case "$provider" in
        filesystem)
            local dest_path test_file
            dest_path="$(jq -r '.filesystem.path // ""' <<<"$payload")"
            [[ "$dest_path" = /* ]] && [ "${#dest_path}" -le 2048 ] || {
                echo "Mounted filesystem destination must be an absolute path." >&2
                return 1
            }
            [ -d "$dest_path" ] || {
                echo "Destination does not exist inside the container. Mount the NAS/storage first." >&2
                return 1
            }
            [ -w "$dest_path" ] || {
                echo "Destination exists but is not writable." >&2
                return 1
            }
            test_file="$(mktemp "$dest_path/.everlomp-connection-test.XXXXXX")" || {
                echo "Destination is mounted but Everlomp could not write to it." >&2
                return 1
            }
            rm -f "$test_file"
            echo "Mounted filesystem connection succeeded and the destination is writable."
            ;;

        sftp)
            command -v sftp >/dev/null 2>&1 || {
                echo "The SFTP client is not installed in this image." >&2
                return 1
            }

            local host port username auth_mode password private_key known_hosts
            local effective_password effective_private_key tmp_dir
            host="$(jq -r '.sftp.host // ""' <<<"$payload")"
            port="$(jq -r '.sftp.port // 22' <<<"$payload")"
            username="$(jq -r '.sftp.username // ""' <<<"$payload")"
            auth_mode="$(jq -r '.sftp.auth_mode // "key"' <<<"$payload")"
            password="$(jq -r '.sftp.password // ""' <<<"$payload")"
            private_key="$(jq -r '.sftp.private_key // ""' <<<"$payload")"
            known_hosts="$(jq -r '.sftp.known_hosts // ""' <<<"$payload")"

            [ -n "$host" ] && [ "${#host}" -le 255 ] && [[ "$host" != *$'\n'* ]] || {
                echo "Enter a valid SFTP/SSH host." >&2
                return 1
            }
            [[ "$port" =~ ^[0-9]+$ ]] && [ "$port" -ge 1 ] && [ "$port" -le 65535 ] || {
                echo "SFTP port must be between 1 and 65535." >&2
                return 1
            }
            [ -n "$username" ] && [ "${#username}" -le 255 ] || {
                echo "Enter the SFTP/SSH username." >&2
                return 1
            }
            [[ "$auth_mode" == "password" || "$auth_mode" == "key" ]] || {
                echo "SFTP authentication must use a password or private key." >&2
                return 1
            }

            effective_password="$password"
            effective_private_key="$private_key"
            [ -n "$effective_password" ] || effective_password="$(existing_offsite_secret sftp password)"
            [ -n "$effective_private_key" ] || effective_private_key="$(existing_offsite_secret sftp private_key)"
            [ -n "$known_hosts" ] || known_hosts="$(existing_offsite_secret sftp known_hosts)"

            if [ "$auth_mode" = "password" ]; then
                [ -n "$effective_password" ] || {
                    echo "Enter the SFTP password." >&2
                    return 1
                }
            else
                [ -n "$effective_private_key" ] || {
                    echo "Paste an SSH private key." >&2
                    return 1
                }
            fi

            tmp_dir="$(mktemp -d /run/everlomp-sftp-test.XXXXXX)"
            chmod 0700 "$tmp_dir"
            : > "$tmp_dir/known_hosts"
            chmod 0600 "$tmp_dir/known_hosts"
            if [ -n "$known_hosts" ]; then
                printf '%s\n' "$known_hosts" > "$tmp_dir/known_hosts"
            fi

            local -a sftp_args=(
                -q
                -P "$port"
                -o "ConnectTimeout=12"
                -o "ConnectionAttempts=1"
                -o "UserKnownHostsFile=$tmp_dir/known_hosts"
            )

            if [ -n "$known_hosts" ]; then
                sftp_args+=(-o "StrictHostKeyChecking=yes")
            else
                sftp_args+=(-o "StrictHostKeyChecking=accept-new")
            fi

            local rc=0
            if [ "$auth_mode" = "key" ]; then
                printf '%s\n' "$effective_private_key" > "$tmp_dir/id_key"
                chmod 0600 "$tmp_dir/id_key"
                sftp_args+=(
                    -i "$tmp_dir/id_key"
                    -o "BatchMode=yes"
                    -o "IdentitiesOnly=yes"
                )
                printf 'pwd\nquit\n' | timeout --foreground 20 sftp "${sftp_args[@]}" "$username@$host" >/dev/null 2>"$tmp_dir/error" || rc=$?
            else
                cat > "$tmp_dir/askpass" <<'EOFASKPASS'
#!/bin/sh
printf '%s\n' "${EVERLOMP_TEST_PASSWORD:-}"
EOFASKPASS
                chmod 0700 "$tmp_dir/askpass"
                export EVERLOMP_TEST_PASSWORD="$effective_password"
                export SSH_ASKPASS="$tmp_dir/askpass"
                export SSH_ASKPASS_REQUIRE=force
                export DISPLAY=:0
                sftp_args+=(
                    -o "BatchMode=no"
                    -o "NumberOfPasswordPrompts=1"
                    -o "PreferredAuthentications=password,keyboard-interactive"
                )
                printf 'pwd\nquit\n' | timeout --foreground 20 sftp "${sftp_args[@]}" "$username@$host" >/dev/null 2>"$tmp_dir/error" || rc=$?
                unset EVERLOMP_TEST_PASSWORD SSH_ASKPASS SSH_ASKPASS_REQUIRE DISPLAY || true
            fi

            if [ "$rc" -ne 0 ]; then
                local err
                err="$(tail -n 2 "$tmp_dir/error" 2>/dev/null | tr '\n' ' ' | sed 's/[[:space:]]\+/ /g')"
                rm -rf "$tmp_dir"
                if [ "$rc" -eq 124 ]; then
                    echo "SFTP connection timed out." >&2
                elif printf '%s' "$err" | grep -qi 'connection closed'; then
                    echo "SFTP connection was closed by the remote server. The selected SSH credential may be valid, but this account/server must also allow the SFTP subsystem." >&2
                else
                    echo "SFTP connection failed${err:+: $err}" >&2
                fi
                return 1
            fi
            rm -rf "$tmp_dir"
            if [ "$auth_mode" = "key" ]; then
                echo "SFTP key connection succeeded."
            else
                echo "SFTP password connection succeeded."
            fi
            ;;

        webdav)
            command -v curl >/dev/null 2>&1 || {
                echo "curl is not installed in this image." >&2
                return 1
            }

            local url username password effective_password tmp_dir rc=0
            url="$(jq -r '.webdav.url // ""' <<<"$payload")"
            username="$(jq -r '.webdav.username // ""' <<<"$payload")"
            password="$(jq -r '.webdav.password // ""' <<<"$payload")"
            [[ "$url" =~ ^https?:// ]] && [ "${#url}" -le 2048 ] || {
                echo "WebDAV URL must begin with http:// or https://." >&2
                return 1
            }
            [ -n "$username" ] || {
                echo "Enter the WebDAV username." >&2
                return 1
            }
            effective_password="$password"
            [ -n "$effective_password" ] || effective_password="$(existing_offsite_secret webdav password)"
            [ -n "$effective_password" ] || {
                echo "Enter the WebDAV password." >&2
                return 1
            }

            tmp_dir="$(mktemp -d /run/everlomp-webdav-test.XXXXXX)"
            chmod 0700 "$tmp_dir"
            TEST_WEBDAV_USER="$username" TEST_WEBDAV_PASSWORD="$effective_password" python3 - "$tmp_dir/curl.conf" <<'PYWEBDAV'
from pathlib import Path
import os, sys

def esc(value: str) -> str:
    return value.replace('\\', '\\\\').replace('"', '\\"').replace('\r', '').replace('\n', '')

user = esc(os.environ.get('TEST_WEBDAV_USER', ''))
password = esc(os.environ.get('TEST_WEBDAV_PASSWORD', ''))
Path(sys.argv[1]).write_text(
    f'user = "{user}:{password}"\n'
    'silent\n'
    'show-error\n'
    'fail\n'
    'max-time = 15\n'
)
PYWEBDAV
            chmod 0600 "$tmp_dir/curl.conf"
            timeout --foreground 20 curl --config "$tmp_dir/curl.conf" --request PROPFIND --header 'Depth: 0' --output /dev/null "$url" 2>"$tmp_dir/error" || rc=$?
            if [ "$rc" -ne 0 ]; then
                local err
                err="$(tail -n 2 "$tmp_dir/error" 2>/dev/null | tr '\n' ' ' | sed 's/[[:space:]]\+/ /g')"
                rm -rf "$tmp_dir"
                [ "$rc" -eq 124 ] && echo "WebDAV connection timed out." >&2 || echo "WebDAV connection failed${err:+: $err}" >&2
                return 1
            fi
            rm -rf "$tmp_dir"
            echo "WebDAV authentication and endpoint access succeeded."
            ;;

        s3)
            command -v rclone >/dev/null 2>&1 || {
                echo "Rclone is required for the S3 connection test but is not installed." >&2
                return 1
            }

            local endpoint bucket region prefix access_key secret_key session_token
            local effective_access_key effective_secret_key effective_session_token endpoint_url target tmp_dir rc=0
            endpoint="$(jq -r '.s3.endpoint // ""' <<<"$payload")"
            bucket="$(jq -r '.s3.bucket // ""' <<<"$payload")"
            region="$(jq -r '.s3.region // ""' <<<"$payload")"
            prefix="$(jq -r '.s3.prefix // ""' <<<"$payload")"
            access_key="$(jq -r '.s3.access_key // ""' <<<"$payload")"
            secret_key="$(jq -r '.s3.secret_access_key // ""' <<<"$payload")"
            session_token="$(jq -r '.s3.session_token // ""' <<<"$payload")"

            [[ "$endpoint" =~ ^[^[:space:]/]+$ ]] || {
                echo "S3 endpoint must be a hostname, optionally with a port, without http:// or https://." >&2
                return 1
            }
            [ -n "$bucket" ] || {
                echo "Enter the S3/MinIO bucket." >&2
                return 1
            }
            effective_access_key="$access_key"
            effective_secret_key="$secret_key"
            effective_session_token="$session_token"
            [ -n "$effective_access_key" ] || effective_access_key="$(existing_offsite_secret s3 access_key)"
            [ -n "$effective_secret_key" ] || effective_secret_key="$(existing_offsite_secret s3 secret_access_key)"
            if [ -z "$effective_session_token" ] && [ -z "$access_key" ] && [ -z "$secret_key" ]; then
                effective_session_token="$(existing_offsite_secret s3 session_token)"
            fi
            [ -n "$effective_access_key" ] && [ -n "$effective_secret_key" ] || {
                echo "Enter the S3/MinIO access key and secret key." >&2
                return 1
            }

            [[ "$effective_access_key" != *$'\n'* && "$effective_secret_key" != *$'\n'* && "$effective_session_token" != *$'\n'* ]] || {
                echo "S3 credentials may not contain line breaks." >&2
                return 1
            }

            endpoint_url="https://$endpoint"
            target="everlomptest:$bucket"
            if [ -n "$prefix" ]; then
                prefix="${prefix#/}"
                prefix="${prefix%/}"
                [ -n "$prefix" ] && target="$target/$prefix"
            fi
            tmp_dir="$(mktemp -d /run/everlomp-s3-test.XXXXXX)"
            chmod 0700 "$tmp_dir"
            {
                printf '[everlomptest]\n'
                printf 'type = s3\n'
                printf 'provider = Other\n'
                printf 'access_key_id = %s\n' "$effective_access_key"
                printf 'secret_access_key = %s\n' "$effective_secret_key"
                printf 'endpoint = %s\n' "$endpoint_url"
                [ -n "$region" ] && printf 'region = %s\n' "$region"
                [ -n "$effective_session_token" ] && printf 'session_token = %s\n' "$effective_session_token"
            } > "$tmp_dir/rclone.conf"
            chmod 0600 "$tmp_dir/rclone.conf"
            timeout --foreground 20 rclone lsf "$target" --max-depth 1 --config "$tmp_dir/rclone.conf" >/dev/null 2>"$tmp_dir/error" || rc=$?
            if [ "$rc" -ne 0 ]; then
                local err
                err="$(tail -n 2 "$tmp_dir/error" 2>/dev/null | tr '\n' ' ' | sed 's/[[:space:]]\+/ /g')"
                rm -rf "$tmp_dir"
                [ "$rc" -eq 124 ] && echo "S3/MinIO connection timed out." >&2 || echo "S3/MinIO connection failed${err:+: $err}" >&2
                return 1
            fi
            rm -rf "$tmp_dir"
            echo "S3/MinIO credentials and bucket access succeeded."
            ;;

        from-config)
            local token effective_token tmp_dir rc=0
            token="$(jq -r '.from_config.token // ""' <<<"$payload")"
            effective_token="$token"
            [ -n "$effective_token" ] || effective_token="$(existing_offsite_secret from-config token)"
            [ -n "$effective_token" ] || {
                echo "Paste the Kopia configuration token." >&2
                return 1
            }
            tmp_dir="$(mktemp -d /run/everlomp-kopia-token-test.XXXXXX)"
            chmod 0700 "$tmp_dir"
            printf '%s' "$effective_token" > "$tmp_dir/token"
            chmod 0600 "$tmp_dir/token"
            KOPIA_CONFIG_PATH="$tmp_dir/repository.config" timeout --foreground 20 "$KOPIA" repository connect from-config --token-file="$tmp_dir/token" --readonly --no-check-for-updates --cache-directory="$tmp_dir/cache" >/dev/null 2>"$tmp_dir/error" || rc=$?
            if [ "$rc" -ne 0 ]; then
                local err
                err="$(tail -n 2 "$tmp_dir/error" 2>/dev/null | tr '\n' ' ' | sed 's/[[:space:]]\+/ /g')"
                rm -rf "$tmp_dir"
                [ "$rc" -eq 124 ] && echo "Kopia token connection timed out." >&2 || echo "Kopia token connection failed${err:+: $err}" >&2
                return 1
            fi
            rm -rf "$tmp_dir"
            echo "Kopia configuration token connected successfully."
            ;;

        rclone)
            command -v rclone >/dev/null 2>&1 || {
                echo "Rclone is not installed in this image." >&2
                return 1
            }
            local remote_path rclone_config effective_rclone_config tmp_dir rc=0
            remote_path="$(jq -r '.rclone.remote_path // ""' <<<"$payload")"
            rclone_config="$(jq -r '.rclone.config // ""' <<<"$payload")"
            [ -n "$remote_path" ] && [ "${#remote_path}" -le 2048 ] || {
                echo "Enter an Rclone remote path such as remote:backups/everlomp." >&2
                return 1
            }
            effective_rclone_config="$rclone_config"
            [ -n "$effective_rclone_config" ] || effective_rclone_config="$(existing_offsite_secret rclone rclone_config)"
            [ -n "$effective_rclone_config" ] || {
                echo "Paste the rclone.conf content." >&2
                return 1
            }
            tmp_dir="$(mktemp -d /run/everlomp-rclone-test.XXXXXX)"
            chmod 0700 "$tmp_dir"
            printf '%s\n' "$effective_rclone_config" > "$tmp_dir/rclone.conf"
            chmod 0600 "$tmp_dir/rclone.conf"
            timeout --foreground 20 rclone lsf "$remote_path" --max-depth 1 --config "$tmp_dir/rclone.conf" >/dev/null 2>"$tmp_dir/error" || rc=$?
            if [ "$rc" -ne 0 ]; then
                local err
                err="$(tail -n 2 "$tmp_dir/error" 2>/dev/null | tr '\n' ' ' | sed 's/[[:space:]]\+/ /g')"
                rm -rf "$tmp_dir"
                [ "$rc" -eq 124 ] && echo "Rclone connection timed out." >&2 || echo "Rclone connection failed${err:+: $err}" >&2
                return 1
            fi
            rm -rf "$tmp_dir"
            echo "Rclone remote access succeeded."
            ;;

        *)
            echo "Unsupported off-site destination type." >&2
            return 1
            ;;
    esac
}

sync_kopia_offsite() {
    local max_seconds="${1:-0}"

    [ -s "$REPO_CONFIG" ] || {
        echo "Kopia repository is disconnected; off-site sync skipped." >&2
        record_offsite_sync_result "failed" "Kopia repository is disconnected."
        return 1
    }
    "$SECRET_HELPER" exists "$REPO_PASSWORD_STORE" || {
        echo "Saved Kopia repository password is missing." >&2
        record_offsite_sync_result "failed" "Saved repository password is missing."
        return 1
    }
    [ -s "$BACKUP_CONFIG" ] || { echo "Backup settings are missing." >&2; return 1; }

    local enabled provider
    enabled="$(jq -r '.offsite_enabled // false' "$BACKUP_CONFIG")"
    provider="$(jq -r '.offsite_type // "sftp"' "$BACKUP_CONFIG")"
    [ "$enabled" = "true" ] || { echo "Off-site synchronization is disabled." >&2; return 2; }

    if [ "$provider" = "s3" ] && [ ! -s "$OFFSITE_CONFIG" ] \
        && [ -s "$LEGACY_OFFSITE_S3_CONFIG" ]; then
        write_offsite_secret_config s3 '{}'
    fi

    export KOPIA_CONFIG_PATH="$REPO_CONFIG"
    export KOPIA_PASSWORD="$("$SECRET_HELPER" read "$REPO_PASSWORD_STORE")"

    local -a args=(repository sync-to)
    local tmp_dir=""
    local detail="Remote repository synchronized successfully."

    case "$provider" in
        filesystem)
            local dest_path marker
            dest_path="$(jq -r '.offsite_path // ""' "$BACKUP_CONFIG")"
            [ -n "$dest_path" ] || { record_offsite_sync_result failed "Mounted filesystem path is missing."; return 1; }
            [ -d "$dest_path" ] && [ -w "$dest_path" ] || { record_offsite_sync_result failed "Mounted filesystem destination is unavailable or not writable."; return 1; }
            marker="$dest_path/.everlomp-kopia-mirror"
            args+=(filesystem "--path=$dest_path")
            if [ -e "$marker" ]; then
                args+=(--must-exist)
            elif [ "$(jq -r '.offsite_last_status // ""' "$BACKUP_CONFIG")" = "success" ]; then
                echo "Mounted filesystem marker disappeared; refusing to write in case the NAS mount is missing." >&2
                record_offsite_sync_result failed "Mounted filesystem marker disappeared; refusing to write in case the NAS mount is missing."
                return 1
            fi
            ;;

        sftp)
            [ -s "$OFFSITE_CONFIG" ] || { record_offsite_sync_result failed "SFTP credentials are not configured."; return 1; }
            local host port username remote_path auth_mode password private_key known_hosts
            host="$(jq -r '.offsite_host // ""' "$BACKUP_CONFIG")"
            port="$(jq -r '.offsite_port // 22' "$BACKUP_CONFIG")"
            username="$(jq -r '.offsite_username // ""' "$BACKUP_CONFIG")"
            remote_path="$(jq -r '.offsite_path // ""' "$BACKUP_CONFIG")"
            auth_mode="$(jq -r '.offsite_auth_mode // "key"' "$BACKUP_CONFIG")"
            password="$(jq -r '.password // ""' "$OFFSITE_CONFIG")"
            private_key="$(jq -r '.private_key // ""' "$OFFSITE_CONFIG")"
            known_hosts="$(jq -r '.known_hosts // ""' "$OFFSITE_CONFIG")"
            args+=(sftp "--host=$host" "--port=$port" "--username=$username" "--path=$remote_path")
            tmp_dir="$(mktemp -d /run/everlomp-kopia-sftp.XXXXXX)"
            chmod 0700 "$tmp_dir"
            if [ -n "$known_hosts" ]; then
                printf '%s\n' "$known_hosts" > "$tmp_dir/known_hosts"
                chmod 0600 "$tmp_dir/known_hosts"
                args+=("--known-hosts=$tmp_dir/known_hosts")
            fi
            if [ "$auth_mode" = "key" ]; then
                printf '%s\n' "$private_key" > "$tmp_dir/id_backup"
                chmod 0600 "$tmp_dir/id_backup"
                args+=("--keyfile=$tmp_dir/id_backup")
            else
                args+=("--sftp-password=$password")
            fi
            ;;

        webdav)
            [ -s "$OFFSITE_CONFIG" ] || { record_offsite_sync_result failed "WebDAV credentials are not configured."; return 1; }
            local url username password
            url="$(jq -r '.offsite_url // ""' "$BACKUP_CONFIG")"
            username="$(jq -r '.offsite_username // ""' "$BACKUP_CONFIG")"
            password="$(jq -r '.password // ""' "$OFFSITE_CONFIG")"
            export KOPIA_WEBDAV_USERNAME="$username" KOPIA_WEBDAV_PASSWORD="$password"
            args+=(webdav "--url=$url")
            ;;

        s3)
            [ -s "$OFFSITE_CONFIG" ] || { record_offsite_sync_result failed "S3/MinIO credentials are not configured."; return 1; }
            local endpoint bucket region prefix access_key secret_key session_token
            endpoint="$(jq -r '.offsite_endpoint // ""' "$BACKUP_CONFIG")"
            bucket="$(jq -r '.offsite_bucket // ""' "$BACKUP_CONFIG")"
            region="$(jq -r '.offsite_region // ""' "$BACKUP_CONFIG")"
            prefix="$(jq -r '.offsite_prefix // ""' "$BACKUP_CONFIG")"
            access_key="$(jq -r '.access_key // ""' "$OFFSITE_CONFIG")"
            secret_key="$(jq -r '.secret_access_key // ""' "$OFFSITE_CONFIG")"
            session_token="$(jq -r '.session_token // ""' "$OFFSITE_CONFIG")"
            export AWS_ACCESS_KEY_ID="$access_key" AWS_SECRET_ACCESS_KEY="$secret_key"
            if [ -n "$session_token" ]; then export AWS_SESSION_TOKEN="$session_token"; else unset AWS_SESSION_TOKEN || true; fi
            args+=(s3 "--bucket=$bucket" "--endpoint=$endpoint")
            [ -n "$region" ] && args+=("--region=$region")
            [ -n "$prefix" ] && args+=("--prefix=$prefix")
            ;;

        from-config)
            [ -s "$OFFSITE_CONFIG" ] || { record_offsite_sync_result failed "Kopia destination token is not configured."; return 1; }
            local token
            token="$(jq -r '.token // ""' "$OFFSITE_CONFIG")"
            tmp_dir="$(mktemp -d /run/everlomp-kopia-token.XXXXXX)"
            chmod 0700 "$tmp_dir"
            printf '%s' "$token" > "$tmp_dir/token"
            chmod 0600 "$tmp_dir/token"
            args+=(from-config "--token-file=$tmp_dir/token")
            ;;

        rclone)
            [ -s "$OFFSITE_CONFIG" ] || { record_offsite_sync_result failed "Rclone configuration is not configured."; return 1; }
            command -v rclone >/dev/null 2>&1 || { record_offsite_sync_result failed "Rclone is not installed."; return 1; }
            local remote_path rclone_config
            remote_path="$(jq -r '.offsite_rclone_remote_path // ""' "$BACKUP_CONFIG")"
            rclone_config="$(jq -r '.rclone_config // ""' "$OFFSITE_CONFIG")"
            tmp_dir="$(mktemp -d /run/everlomp-kopia-rclone.XXXXXX)"
            chmod 0700 "$tmp_dir"
            printf '%s\n' "$rclone_config" > "$tmp_dir/rclone.conf"
            chmod 0600 "$tmp_dir/rclone.conf"
            export RCLONE_CONFIG="$tmp_dir/rclone.conf"
            args+=(rclone "--remote-path=$remote_path" "--rclone-exe=$(command -v rclone)")
            detail="Remote repository synchronized through Rclone."
            ;;

        *)
            record_offsite_sync_result failed "Unsupported off-site destination type."
            return 1
            ;;
    esac

    args+=(--no-progress)

    local rc=0
    if [ "$max_seconds" -gt 0 ]; then
        timeout --foreground "$max_seconds" "$KOPIA" "${args[@]}" || rc=$?
    else
        "$KOPIA" "${args[@]}" || rc=$?
    fi

    [ -n "$tmp_dir" ] && rm -rf "$tmp_dir"
    unset AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN RCLONE_CONFIG KOPIA_WEBDAV_USERNAME KOPIA_WEBDAV_PASSWORD 2>/dev/null || true

    if [ "$rc" -eq 0 ]; then
        if [ "$provider" = "filesystem" ]; then
            printf 'Everlomp Kopia mirror marker\n' > "$dest_path/.everlomp-kopia-mirror"
            chmod 0600 "$dest_path/.everlomp-kopia-mirror" || true
        fi
        record_offsite_sync_result "success" "$detail"
        return 0
    fi

    if [ "$max_seconds" -gt 0 ] && [ "$rc" -eq 124 ]; then
        record_offsite_sync_result "failed" "Initial remote synchronization timed out."
    else
        record_offsite_sync_result "failed" "Kopia could not synchronize to the configured remote destination."
    fi
    return 1
}


