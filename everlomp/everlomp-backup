# Kopia
# ------------------------------------------------------------

[program:kopia]
command=/usr/local/bin/run-kopia.sh
autostart=false
autorestart=true
startretries=100
startsecs=5
stopsignal=TERM
stopwaitsecs=30
stderr_logfile=/var/log/supervisor/kopia.err.log
stdout_logfile=/var/log/supervisor/kopia.out.log
priority=45
EOF
