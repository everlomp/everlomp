ensure_cron_supervisor_program() {
    [ -f "$SUPERVISOR_CONF" ] || {
        echo "Supervisor configuration is missing: $SUPERVISOR_CONF" >&2
        return 1
    }

    if ! grep -q '^\[program:cron\][[:space:]]*$' "$SUPERVISOR_CONF"; then
        cat >> "$SUPERVISOR_CONF" <<'EOF'

# ------------------------------------------------------------
# Cron scheduler
# ------------------------------------------------------------

[program:cron]
command=/usr/sbin/cron -f
autostart=true
autorestart=true
startretries=100
startsecs=3
stopsignal=TERM
stderr_logfile=/var/log/supervisor/cron.err.log
stdout_logfile=/var/log/supervisor/cron.out.log
priority=35
EOF
    fi

    "$SUPERVISORCTL" -c "$SUPERVISOR_CONF" reread >/dev/null
    "$SUPERVISORCTL" -c "$SUPERVISOR_CONF" update >/dev/null

    "$SUPERVISORCTL" -c "$SUPERVISOR_CONF" start cron \
        >/dev/null 2>&1 || true
}


set_kopia_autostart() {
    local desired="$1"

    ensure_kopia_supervisor_program

    python3 - "$SUPERVISOR_CONF" "$desired" <<'PY'
from pathlib import Path
import re
import sys

path = Path(sys.argv[1])
desired = sys.argv[2]
text = path.read_text()

match = re.search(
    r'(?ms)^\[program:kopia\]\s*$.*?(?=^\[|\Z)',
    text,
)

if not match:
    print(
        "Supervisor [program:kopia] section was not found.",
        file=sys.stderr,
    )
    raise SystemExit(1)

section = match.group(0)

if re.search(r'(?m)^\s*autostart\s*=', section):
    section = re.sub(
        r'(?m)^\s*autostart\s*=.*$',
        f'autostart={desired}',
        section,
        count=1,
    )
else:
    pos = section.find("\n")
    section = (
        section[:pos + 1]
        + f"autostart={desired}\n"
        + section[pos + 1:]
    )

path.write_text(
    text[:match.start()]
    + section
    + text[match.end():]
)
PY

    "$SUPERVISORCTL" -c "$SUPERVISOR_CONF" reread >/dev/null
    "$SUPERVISORCTL" -c "$SUPERVISOR_CONF" update >/dev/null
}


start_kopia_and_verify() {
    local web_password="$1"
    local status=""
    local curl_config
    curl_config="$(mktemp /run/everlomp-kopia-curl.XXXXXX)"
    chmod 0600 "$curl_config"
    printf 'user = "admin:%s"\n' "$web_password" > "$curl_config"

    "$SUPERVISORCTL" -c "$SUPERVISOR_CONF" start kopia \
        >/dev/null 2>&1 || true

    for _ in $(seq 1 30); do
        if curl -fsS \
            --max-time 2 \
            --config "$curl_config" \
            http://127.0.0.1:51515/ \
            >/dev/null 2>&1; then
            rm -f "$curl_config"
            return 0
        fi

        status="$(
            "$SUPERVISORCTL" \
                -c "$SUPERVISOR_CONF" \
                status kopia 2>&1 || true
        )"

        case "$status" in
            *FATAL*|*BACKOFF*|*EXITED*)
                break
                ;;
        esac

        sleep 0.25
    done

    echo \
        "Kopia Web UI did not become healthy on 127.0.0.1:51515." \
        >&2

    echo "Supervisor status: ${status:-unknown}" >&2

    if [ -f /var/log/supervisor/kopia.err.log ]; then
        echo "--- Kopia stderr (last 60 lines) ---" >&2
        tail -n 60 /var/log/supervisor/kopia.err.log >&2 || true
    fi

    if [ -f /var/log/supervisor/kopia.out.log ]; then
        echo "--- Kopia stdout (last 60 lines) ---" >&2
        tail -n 60 /var/log/supervisor/kopia.out.log >&2 || true
    fi

    rm -f "$curl_config"
    return 1
}


test_and_restart_ols() {
    local backup="$1"

    set +e
    local test_output
    local test_rc
    test_output="$("$OLS_BIN" -t 2>&1)"
    test_rc=$?
    set -e

    printf '%s\n' "$test_output" >&2
    echo \
        "[Everlomp] OpenLiteSpeed config-test exit status: ${test_rc}" \
        >&2

    if printf '%s\n' "$test_output" \
        | grep -Eiq \
            '\[(ERROR|FATAL)\]|syntax[[:space:]]+error|configuration[[:space:]]+error|failed[[:space:]]+to[[:space:]]+(load|parse|read)[[:space:]]+config'; then

        echo \
            "OpenLiteSpeed reported a configuration error. Restoring backup." \
            >&2

        cp -f "$backup" "$OLS_VHCONF"
        return 1
    fi

    set +e
    local restart_output
    local restart_rc
    restart_output="$("$OLS_CTRL" restart 2>&1)"
    restart_rc=$?
    set -e

    printf '%s\n' "$restart_output" >&2

    if [ "$restart_rc" -ne 0 ]; then
        echo \
            "OpenLiteSpeed restart failed. Restoring backup." \
            >&2

        cp -f "$backup" "$OLS_VHCONF"
        "$OLS_CTRL" restart >/dev/null 2>&1 || true
        return 1
    fi

    sleep 2

    local status_output
    status_output="$("$OLS_CTRL" status 2>&1 || true)"
    printf '%s\n' "$status_output" >&2

    if ! printf '%s\n' "$status_output" \
        | grep -q 'litespeed is running with PID'; then

        echo \
            "OpenLiteSpeed did not come back healthy. Restoring backup." \
            >&2

        cp -f "$backup" "$OLS_VHCONF"
        "$OLS_CTRL" restart >/dev/null 2>&1 || true
        return 1
    fi
}


ensure_kopia_subpath_routing() {
    [ -f "$OLS_VHCONF" ] || {
        echo \
            "Missing OpenLiteSpeed vhost config: $OLS_VHCONF" \
            >&2
        return 1
    }

    local backup="${OLS_VHCONF}.everlomp-kopia-backup"
    cp -f "$OLS_VHCONF" "$backup"

    python3 - "$OLS_VHCONF" <<'PYROUTE'
from pathlib import Path
import re
import sys

path = Path(sys.argv[1])
text = path.read_text()

# Remove obsolete restore/hostname compatibility blocks from persistent configs.
text = re.sub(
    r'(?ms)^[ \t]*# BEGIN everlomp kopia escaped routes\s*$.*?'
    r'^[ \t]*# END everlomp kopia escaped routes\s*$\n?',
    '',
    text,
)
text = re.sub(
    r'(?ms)^[ \t]*# BEGIN everlomp kopia host\s*$.*?'
    r'^[ \t]*# END everlomp kopia host\s*$\n?',
    '',
    text,
)
text = re.sub(
    r'(?ms)^# Kopia hostname backend\s*\n'
    r'extprocessor kopia-backend\s*\{.*?^\}\s*',
    '',
    text,
)

# Remove all previous Kopia contexts, then install the clean pair below.
text = re.sub(
    r'(?m)^# Kopia[^\n]*\n(?=context /kopia(?:/api)?/)',
    '',
    text,
)
text = re.sub(
    r'(?ms)^context /kopia/api/\s*\{.*?^\}\s*',
    '',
    text,
)
text = re.sub(
    r'(?ms)^context /kopia/\s*\{.*?^\}\s*',
    '',
    text,
)

if not re.search(r'(?m)^extprocessor ols-admin-adapter\s*\{', text):
    raise SystemExit("OpenLiteSpeed nginx adapter was not found.")

contexts = r"""# Kopia Web UI + API.
# nginx strips /kopia/ before forwarding. Kopia itself serves its custom
# embedded HTMLUI, including native authentication/session/CSRF handling.
context /kopia/ {
    type                    proxy
    handler                 ols-admin-adapter
    addDefaultCharset       off
}
"""

anchor = re.search(
    r'(?ms)^context /openlitespeed/\s*\{.*?^\}\s*',
    text,
)
if anchor:
    pos = anchor.end()
    text = text[:pos].rstrip() + "\n\n" + contexts + "\n" + text[pos:].lstrip("\n")
else:
    text = text.rstrip() + "\n\n" + contexts

path.write_text(text)
PYROUTE

    if ! test_and_restart_ols "$backup"; then
        return 1
    fi

    rm -f "$backup"
}

is_kopia_configured() {
    if [ -s "$INFO" ] && jq -e '.configured == true' "$INFO" >/dev/null 2>&1; then
        return 0
    fi

    if [ -s "$INFO" ] && jq -e '(.repository_type == "filesystem") and ((.repository_path // "") | length > 0)' "$INFO" >/dev/null 2>&1; then
        return 0
    fi

    if [ -f "$BASE/enabled" ] && [ -s "$REPO_CONFIG" ]; then
        return 0
    fi

    return 1
}


write_kopia_info() {
    local enabled="$1"
    local repo_path="$2"
    local version="$3"
    local encryption="${4:-}"
    local install_source="${5:-}"

    python3 \
        - "$INFO" \
        "$enabled" \
        "$repo_path" \
        "$version" \
        "$encryption" \
        "$install_source" <<'PY'
from pathlib import Path
import json
import sys

path = Path(sys.argv[1])

repo_path = sys.argv[3]
install_source = sys.argv[6]
if not install_source and path.is_file():
    try:
        previous = json.loads(path.read_text())
        install_source = str(previous.get("install_source", ""))
    except (OSError, ValueError, TypeError):
        install_source = ""

data = {
    "configured": True,
    "enabled": sys.argv[2] == "true",
    "repository_type": "filesystem" if repo_path else "kopia-ui",
    "repository_path": repo_path,
    "version": sys.argv[4],
    "encryption": sys.argv[5],
    "install_source": install_source,
    "web_path": "/kopia/",
}

path.write_text(
    json.dumps(data, indent=2, sort_keys=True) + "\n"
)
PY

    set_web_state_permissions "$INFO"
}


case "$ACTION" in

    repair-state-permissions)
        repair_web_state_permissions
        ;;

    configure-kopia)
        if is_kopia_configured; then
            echo "Kopia is already configured. Use Enable or Reconnect instead of running first-time configuration again." >&2
            exit 3
        fi

        payload="$(cat)"

        repo_mode="$(
            jq -r '.repository_mode // "create"' <<<"$payload"
        )"

        repo_path="$(
            jq -r '.repository_path // "/home/everlomp/kopiasnapshots"' <<<"$payload"
        )"

        repo_password="$(
            jq -r '.repository_password // ""' <<<"$payload"
        )"

        encryption="$(
            jq -r '.encryption // "AES256-GCM-HMAC-SHA256"' <<<"$payload"
        )"

        install_local_version="$(
            jq -r '.install_local_version // false' <<<"$payload"
        )"

        default_snapshots_enabled="$(
            jq -r '.default_snapshots.enabled // false' <<<"$payload"
        )"

        default_snapshot_time="$(
            jq -r '.default_snapshots.time // "03:00"' <<<"$payload"
        )"

        case "$default_snapshots_enabled" in
            true|false) ;;
            *) echo "default_snapshots.enabled must be true or false." >&2; exit 28 ;;
        esac

        if [ "$default_snapshots_enabled" = "true" ] \
            && ! [[ "$default_snapshot_time" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]]; then
            echo "Default Kopia snapshot time must be HH:MM." >&2
            exit 29
        fi

        case "$install_local_version" in
            true) kopia_install_source="local" ;;
            false) kopia_install_source="online" ;;
            *) echo "install_local_version must be true or false." >&2; exit 27 ;;
        esac

        offsite_payload="$(jq -c '.offsite // {enabled:false,type:"sftp",schedule:"every6h",time:"03:30",weekday:0}' <<<"$payload")"

        if [ "$repo_mode" != "create" ] && [ "$repo_mode" != "connect" ] && [ "$repo_mode" != "ui" ]; then
            echo "Repository mode must be create, connect, or ui." >&2
            exit 4
        fi

        if [ "$repo_mode" != "ui" ]; then
            if [[ ! "$repo_path" =~ ^/home/everlomp/kopiasnapshots(/.*)?$ ]] \
                || [[ "$repo_path" == *"/../"* ]] \
                || [[ "$repo_path" == *"/.." ]]; then
                echo "Kopia repository path must be /home/everlomp/kopiasnapshots or a directory below it." >&2
                exit 5
            fi
        else
            repo_path=""
        fi

        if [ "$default_snapshots_enabled" = "true" ] && [ "$repo_mode" = "ui" ]; then
            echo "Default snapshot sources can only be enabled when creating the local primary repository during installation. If you choose the primary repository later, configure snapshot sources in Kopia after connecting it." >&2
            exit 30
        fi

        if [ "$repo_mode" != "ui" ] && [ "${#repo_password}" -lt 12 ]; then
            echo "Kopia repository password must be at least 12 characters." >&2
            exit 6
        fi

        case "$encryption" in
            AES256-GCM-HMAC-SHA256|CHACHA20-POLY1305-HMAC-SHA256) ;;
            *) echo "Unsupported Kopia encryption algorithm." >&2; exit 18 ;;
        esac

        offsite_enabled="$(jq -r '.enabled // false' <<<"$offsite_payload")"
        if [ "$offsite_enabled" = "true" ]; then
            [ -x "$REPLICATION_HELPER" ] || {
                echo "Kopia replication helper is missing: $REPLICATION_HELPER" >&2
                exit 26
            }
            if ! printf '%s' "$offsite_payload" | /usr/sbin/runuser -u everlomp -- "$REPLICATION_HELPER" validate-offsite >/dev/null; then
                echo "Remote backup destination configuration is invalid." >&2
                exit 26
            fi
        fi

        ensure_custom_kopia_binary "$kopia_install_source"

        install -d -o everlomp -g everlomp -m 0700 "$BASE"
        mkdir -p "$EVERBACKUPS_DIR" "$SQL_BACKUP_DIR"

        if [ "$repo_mode" = "create" ]; then
            mkdir -p "$repo_path"
            chmod 0700 "$repo_path" || true
        elif [ "$repo_mode" = "connect" ] && [ ! -d "$repo_path" ]; then
            echo \
                "Existing Kopia repository directory does not exist: $repo_path" \
                >&2
            exit 7
        fi

        if [ "$repo_mode" != "ui" ]; then
            printf '%s' "$repo_password" | "$SECRET_HELPER" write "$REPO_PASSWORD_STORE"
        else
            "$SECRET_HELPER" remove "$REPO_PASSWORD_STORE"
        fi

        web_password="$(openssl rand -hex 16)"
        printf '%s' "$web_password" | "$SECRET_HELPER" write "$WEB_PASSWORD_STORE"

        export KOPIA_CONFIG_PATH="$REPO_CONFIG"
        export KOPIA_PASSWORD="$repo_password"

        if [ "$repo_mode" = "create" ]; then
            "$KOPIA" repository create filesystem \
                --path="$repo_path" \
                --encryption="$encryption" \
                --no-check-for-updates \
                1>&2
        elif [ "$repo_mode" = "connect" ]; then
            "$KOPIA" repository connect filesystem \
                --path="$repo_path" \
                --no-check-for-updates \
                1>&2
            encryption="existing-repository"
        else
            rm -f "$REPO_CONFIG"
            encryption="kopia-ui-managed"
        fi

        if [ "$default_snapshots_enabled" = "true" ]; then
            mkdir -p "$SQL_BACKUP_DIR"
            chmod 0700 "$EVERBACKUPS_DIR" "$SQL_BACKUP_DIR" 2>/dev/null || true

            for snapshot_source in "$DEFAULT_WWW_SOURCE" "$SQL_BACKUP_DIR"; do
                [ -d "$snapshot_source" ] || {
                    echo "Default snapshot source does not exist: $snapshot_source" >&2
                    exit 31
                }

                "$KOPIA" policy set "$snapshot_source" \
                    --snapshot-time="$default_snapshot_time" \
                    --run-missed=true \
                    --no-manual \
                    1>&2

                "$KOPIA" snapshot create "$snapshot_source" \
                    --description="Everlomp initial snapshot" \
                    1>&2
            done
        fi

        if [ -s "$REPO_CONFIG" ]; then
            chmod 0600 "$REPO_CONFIG"
        fi

        version="$(
            "$KOPIA" --version 2>/dev/null \
                | head -n1 \
                | tr -d '\r'
        )"

        initial_offsite_status="disabled"
        initial_replica_id=""

        if [ "$offsite_enabled" = "true" ]; then
            if initial_replica_id="$(printf '%s' "$offsite_payload" | /usr/sbin/runuser -u everlomp -- "$REPLICATION_HELPER" import-offsite 2>/dev/null)" \
                && [ -n "$initial_replica_id" ]; then
                if [ "$repo_mode" = "ui" ]; then
                    initial_offsite_status="pending-primary"
                elif /usr/sbin/runuser -u everlomp -- "$REPLICATION_HELPER" sync "$initial_replica_id" 1>&2; then
                    initial_offsite_status="success"
                else
                    initial_offsite_status="failed"
                fi
            else
                echo "Could not save the initial Kopia replica." >&2
                exit 26
            fi
        fi

        set_kopia_autostart true
        start_kopia_and_verify "$web_password"
        ensure_kopia_subpath_routing

        write_kopia_info \
            true \
            "$repo_path" \
            "$version" \
            "$encryption" \
            "$kopia_install_source"
        touch "$BASE/enabled"
        chmod 0600 "$BASE/enabled"

        jq -n \
            --arg username admin \
            --arg password "$web_password" \
            --arg path "$repo_path" \
            --arg version "$version" \
            --arg repository_mode "$repo_mode" \
            --arg offsite_status "$initial_offsite_status" \
            '{
                configured:true,
                enabled:true,
                username:$username,
                password:$password,
                repository_path:$path,
                repository_mode:$repository_mode,
                version:$version,
                offsite_status:$offsite_status,
                web_path:"/kopia/"
            }'
        ;;


    prepare-kopia-build)
        ensure_custom_kopia_binary

        echo "Kopia build/update tools are installed and the custom /kopia/ binary is ready."
        ;;


    reconnect-kopia)

        [ -s "$INFO" ] || {
            echo \
                "Kopia metadata is missing: $INFO" \
                >&2
            exit 19
        }

        "$SECRET_HELPER" exists "$REPO_PASSWORD_STORE" || {
            echo \
                "Saved Kopia repository password is missing." \
                >&2
            exit 20
        }

        repo_type="$(
            jq -r '.repository_type // ""' \
                "$INFO" 2>/dev/null || true
        )"

        repo_path="$(
            jq -r '.repository_path // ""' \
                "$INFO" 2>/dev/null || true
        )"

        if [ "$repo_type" != "filesystem" ]; then
            echo \
                "Automatic Everlomp reconnect currently supports only filesystem repositories." \
                >&2
            exit 21
        fi

        if { [[ ! "$repo_path" =~ ^/home/everlomp/kopiasnapshots(/.*)?$ ]] \
                && [[ ! "$repo_path" =~ ^/backup(/.*)?$ ]]; } \
            || [[ "$repo_path" == *"/../"* ]] \
            || [[ "$repo_path" == *"/.." ]]; then

            echo \
                "Refusing unsafe Kopia repository path: $repo_path" \
                >&2
            exit 22
        fi

        [ -d "$repo_path" ] || {
            echo \
                "Kopia repository directory does not exist: $repo_path" \
                >&2
            exit 23
        }

        # If a repository config already exists, do not overwrite it.
        if [ -s "$REPO_CONFIG" ]; then
            echo \
                "Kopia repository.config already exists; refusing to overwrite an active connection." \
                >&2
            exit 24
        fi

        export KOPIA_CONFIG_PATH="$REPO_CONFIG"
        export KOPIA_PASSWORD="$(
            "$SECRET_HELPER" read "$REPO_PASSWORD_STORE"
        )"

        "$SUPERVISORCTL" \
            -c "$SUPERVISOR_CONF" \
            stop kopia \
            >/dev/null 2>&1 || true

        if ! "$KOPIA" repository connect filesystem \
            --path="$repo_path" \
            --no-check-for-updates; then

            echo \
                "Kopia repository reconnect failed. The Web UI will be started in disconnected mode." \
                >&2

            "$SUPERVISORCTL" \
                -c "$SUPERVISOR_CONF" \
                start kopia \
                >/dev/null 2>&1 || true

            exit 25
        fi

        chmod 0600 "$REPO_CONFIG"

        if [ -f "$BASE/enabled" ]; then
            set_kopia_autostart true

            start_kopia_and_verify "$(
                "$SECRET_HELPER" read "$WEB_PASSWORD_STORE"
            )"
        fi

        echo \
            "Kopia reconnected to the Everlomp filesystem repository: $repo_path"
        ;;


    repair-kopia-route)
        ensure_kopia_subpath_routing
        echo "Kopia native /kopia/ UI/API proxy route repaired."
        ;;


    enable-kopia)

        "$SECRET_HELPER" exists "$WEB_PASSWORD_STORE" || {
            echo \
                "Kopia Web UI credentials are missing; configure Kopia first." \
                >&2
            exit 8
        }

        repo_path="$(
            jq -r '.repository_path // ""' \
                "$INFO" 2>/dev/null || true
        )"

        encryption="$(
            jq -r '.encryption // ""' \
                "$INFO" 2>/dev/null || true
        )"

        version="$(
            "$KOPIA" --version 2>/dev/null \
                | head -n1 \
                | tr -d '\r'
        )"

        write_kopia_info \
            true \
            "$repo_path" \
            "$version" \
            "$encryption"

        touch "$BASE/enabled"
        chmod 0600 "$BASE/enabled"

        set_kopia_autostart true

        start_kopia_and_verify "$(
            "$SECRET_HELPER" read "$WEB_PASSWORD_STORE"
        )"

        ensure_kopia_subpath_routing

        echo "Kopia enabled."
        ;;


    disable-kopia)
        "$SUPERVISORCTL" \
            -c "$SUPERVISOR_CONF" \
            stop kopia \
            >/dev/null 2>&1 || true

        set_kopia_autostart false

        rm -f "$BASE/enabled"

        if [ -f "$INFO" ]; then
            python3 - "$INFO" <<'PY'
from pathlib import Path
import json
import sys

path = Path(sys.argv[1])

try:
    data = json.loads(path.read_text())
except Exception:
    data = {}

data["enabled"] = False
# Disabling is not the same as undoing first-time configuration. Backfill the
# v21 persistent marker for metadata created by v19/v20.
data["configured"] = bool(data.get("repository_path"))
data["web_path"] = "/kopia/"
data.pop("hostname", None)

path.write_text(
    json.dumps(data, indent=2, sort_keys=True) + "\n"
)
PY
            set_web_state_permissions "$INFO"
        fi

        echo \
            "Kopia disabled. Repository configuration was preserved."
        ;;


    test-offsite-connection)
        payload="$(cat)"
        test_offsite_connection "$payload"
        ;;


    save-offsite-settings)
        payload="$(cat)"
        save_offsite_configuration "$payload"
        echo "Remote backup destination settings saved."
        ;;


    sync-kopia-now)
        exec 8>"$OFFSITE_SYNC_LOCK"
        flock -n 8 || {
            echo "An off-site Kopia synchronization is already running." >&2
            exit 44
        }

        sync_kopia_offsite
        echo "Off-site Kopia synchronization completed."
        ;;


    save-sql-settings)
        payload="$(cat)"

        enabled="$(
            jq -r '.sql_enabled // false' <<<"$payload"
        )"

        schedule="$(
            jq -r '.sql_schedule // "daily"' <<<"$payload"
        )"

        time="$(
            jq -r '.sql_time // "02:30"' <<<"$payload"
        )"

        weekday="$(
            jq -r '.sql_weekday // 0' <<<"$payload"
        )"

        keep="$(
            jq -r '.sql_keep // 7' <<<"$payload"
        )"

        [[ "$enabled" == "true" \
            || "$enabled" == "false" ]] || {

            echo \
                "Invalid SQL enabled value." \
                >&2
            exit 9
        }

        [[ "$schedule" =~ ^(hourly|every6h|every12h|daily|weekly)$ ]] || {
            echo \
                "Invalid SQL schedule." \
                >&2
            exit 10
        }

        if [[ "$schedule" == "daily" || "$schedule" == "weekly" ]]; then
            [[ "$time" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]] || {
                echo \
                    "Invalid SQL backup time." \
                    >&2
                exit 11
            }
        fi

        if [ "$schedule" = "weekly" ]; then
            [[ "$weekday" =~ ^[0-6]$ ]] || {
                echo "Invalid weekday." >&2
                exit 12
            }
        fi

        [[ "$keep" =~ ^[0-9]+$ ]] \
            && [ "$keep" -ge 1 ] \
            && [ "$keep" -le 365 ] || {

            echo \
                "Keep count must be 1-365." \
                >&2
            exit 13
        }

        clean="$(
            jq -n \
                --argjson e "$enabled" \
                --arg s "$schedule" \
                --arg t "$time" \
                --argjson w "$weekday" \
                --argjson k "$keep" \
                '{
                    sql_enabled:$e,
                    sql_schedule:$s,
                    sql_time:$t,
                    sql_weekday:$w,
                    sql_keep:$k
                }'
        )"

        was_enabled="false"
        if [ -f "$BACKUP_CONFIG" ]; then
            was_enabled="$(jq -r '.sql_enabled // false' "$BACKUP_CONFIG" 2>/dev/null || echo false)"
        fi

        json_write_backup_settings sql "$clean"

        if [ "$enabled" = "true" ] && [ "$was_enabled" != "true" ]; then
            python3 - "$BACKUP_CONFIG" <<'PYBASE'
from pathlib import Path
import datetime, json, os, sys, tempfile
path = Path(sys.argv[1])
try:
    data = json.loads(path.read_text()) if path.exists() else {}
    if not isinstance(data, dict):
        data = {}
except Exception:
    data = {}
data['sql_last_run'] = datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0).isoformat().replace('+00:00','Z')
data['sql_last_status'] = 'scheduled'
data['sql_last_detail'] = 'Schedule enabled; first automatic backup will run at the next scheduled interval.'
fd, tmp = tempfile.mkstemp(prefix='.backup.', dir=str(path.parent))
os.close(fd)
Path(tmp).write_text(json.dumps(data, indent=2, sort_keys=True) + '\n')
os.replace(tmp, path)
os.chown(path, 0, 0)
os.chmod(path, 0o644)
PYBASE
        fi

        echo "SQL backup settings saved."
        ;;


    save-update-settings)
        payload="$(cat)"

        enabled="$(
            jq -r '.kopia_auto_update // false' <<<"$payload"
        )"

        schedule="$(
            jq -r '.kopia_update_schedule // "weekly"' <<<"$payload"
        )"

        time="$(
            jq -r '.kopia_update_time // "04:30"' <<<"$payload"
        )"

        weekday="$(
            jq -r '.kopia_update_weekday // 0' <<<"$payload"
        )"

        [[ "$enabled" == "true" \
            || "$enabled" == "false" ]] || {

            echo \
                "Invalid update enabled value." \
                >&2
            exit 14
        }

        [[ "$schedule" =~ ^(daily|weekly)$ ]] || {
            echo \
                "Invalid Kopia update schedule." \
                >&2
            exit 15
        }

        [[ "$time" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]] || {
            echo \
                "Invalid Kopia update time." \
                >&2
            exit 16
        }

        if [ "$schedule" = "weekly" ]; then
            [[ "$weekday" =~ ^[0-6]$ ]] || {
                echo "Invalid weekday." >&2
                exit 17
            }
        fi

        clean="$(
            jq -n \
                --argjson e "$enabled" \
                --arg s "$schedule" \
                --arg t "$time" \
                --argjson w "$weekday" \
                '{
                    kopia_auto_update:$e,
                    kopia_update_schedule:$s,
                    kopia_update_time:$t,
                    kopia_update_weekday:$w
                }'
        )"

        json_write_backup_settings update "$clean"

        echo "Kopia update settings saved."
        ;;


    sql-backup-now)
        exec /usr/local/sbin/everlomp-sql-backup
        ;;


    *)
        echo \
            "Usage: everlomp-backup {repair-state-permissions|configure-kopia|prepare-kopia-build|reconnect-kopia|repair-kopia-route|enable-kopia|disable-kopia|test-offsite-connection|save-offsite-settings|sync-kopia-now|save-sql-settings|save-update-settings|sql-backup-now}" \
            >&2
        exit 64
        ;;
esac
