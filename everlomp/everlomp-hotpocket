def action_finalize_site() -> None:
    current_primary = PRIMARY_APP_FILE.read_text(encoding='utf-8').strip() if PRIMARY_APP_FILE.is_file() else ''
    if current_primary != 'hotpocket-folder':
        fail('HotPocket-folder website finalization requires the hotpocket-folder primary-app selection.', 66)

    info = load_site_info()
    scope, root, subfolder, indexes, host, port = validate_site_payload({
        'scope': info.get('scope', ''),
        'subfolder': info.get('subfolder', ''),
        'index_files': info.get('index_files', []),
        'host': info.get('host', ''),
        'port': info.get('port', 0),
    }, require_root_exists=True)

    vhost_name, vhost_conf = resolve_vhost(host, port)
    server_original = read_text(SERVER_CONF)
    vhost_original = read_text(vhost_conf)
    server_new = set_vhost_restrained(server_original, vhost_name, 0)
    vhost_new = rewrite_site_vhost(vhost_original, root, indexes)
    try:
        write_preserving(SERVER_CONF, server_new)
        write_preserving(vhost_conf, vhost_new)
        ok, detail, code = ols_test()
        if detail:
            print(detail, file=sys.stderr)
        if not ok:
            raise RuntimeError(f'OpenLiteSpeed rejected the HotPocket website root (test exit {code}).')
        ok, detail = ols_restart()
        if not ok:
            raise RuntimeError('OpenLiteSpeed could not restart with the HotPocket website root' + (f': {detail}' if detail else '.'))
    except BaseException as exc:
        try:
            write_preserving(SERVER_CONF, server_original)
            write_preserving(vhost_conf, vhost_original)
            ols_restart()
        except BaseException:
            pass
        fail(str(exc), 75)

    info.update({
        'configured': True,
        'staged': False,
        'scope': scope,
        'subfolder': subfolder,
        'document_root': str(root),
        'index_files': indexes,
        'vhost': vhost_name,
        'vhost_config': str(vhost_conf),
        'applied_at_unix': int(time.time()),
    })
    atomic_write(SITE_INFO_FILE, json.dumps(info, indent=2, sort_keys=True) + '\n', mode=0o644)

    # The stock cleanup helper only accepts built-in/external primary-app markers.
    # It deletes this marker during cleanup anyway, so switch to a validated
    # external-style marker only at the final cleanup boundary.
    atomic_write(PRIMARY_APP_FILE, 'external:hotpocket-folder\n', mode=0o644)
    print(f'Website now serves {root} with index files: {", ".join(indexes)}')




def load_hp_config() -> dict:
    if not HP_CONFIG_FILE.is_file() or HP_CONFIG_FILE.is_symlink():
        fail(f'HotPocket configuration is missing or unsafe: {HP_CONFIG_FILE}', 67)
    try:
        raw = HP_CONFIG_FILE.read_text(encoding='utf-8')
    except OSError as exc:
        fail(f'Could not read {HP_CONFIG_FILE}: {exc}', 67)
    if len(raw.encode('utf-8')) > MAX_JSON_STDIN:
        fail('HotPocket configuration is too large for the installer editor.', 65)
    try:
        value = json.loads(raw)
    except json.JSONDecodeError as exc:
        fail(f'HotPocket configuration is not valid JSON: line {exc.lineno}, column {exc.colno}.', 65)
    if not isinstance(value, dict):
        fail('HotPocket configuration root must be a JSON object.', 65)
    return value


def action_read_config() -> None:
    value = load_hp_config()
    sys.stdout.write(json.dumps(value, ensure_ascii=False, separators=(',', ':')))
    sys.stdout.write('\n')


def action_write_config() -> None:
    if ENABLED_FILE.exists():
        fail('HotPocket is already enabled. This installer only edits hp.cfg before HotPocket starts.', 66)
    payload = read_json_stdin()

    # HotPocket's schema requires contract.environment to be a JSON object.
    # This also protects installations that encounter an older Everlomp editor
    # which accidentally serialized an empty object {} as an empty array [].
    contract = payload.get('contract')
    if not isinstance(contract, dict):
        fail("HotPocket configuration requires 'contract' to be a JSON object.", 65)
    environment = contract.get('environment')
    if isinstance(environment, list) and len(environment) == 0:
        contract['environment'] = {}
        environment = contract['environment']
    if not isinstance(environment, dict):
        fail("HotPocket configuration requires 'contract.environment' to be a JSON object.", 65)

    # Round-trip through the JSON encoder so only valid JSON values are written.
    encoded = json.dumps(payload, ensure_ascii=False, indent=2) + '\n'
    if len(encoded.encode('utf-8')) > MAX_JSON_STDIN:
        fail('HotPocket configuration is too large.', 65)
    if not HP_CONFIG_FILE.is_file() or HP_CONFIG_FILE.is_symlink():
        fail(f'HotPocket configuration is missing or unsafe: {HP_CONFIG_FILE}', 67)
    try:
        write_preserving(HP_CONFIG_FILE, encoded)
    except OSError as exc:
        fail(f'Could not save {HP_CONFIG_FILE}: {exc}', 75)
    # Re-read the file after replacement to ensure the on-disk document is valid JSON.
    load_hp_config()
    print(f'Saved HotPocket configuration to {HP_CONFIG_FILE}.')


def safe_zip_parts(name: str) -> tuple[str, ...]:
    if not name or '\x00' in name or '\\' in name or name.startswith('/'):
        fail(f'Unsafe ZIP entry path: {name!r}', 65)
    cleaned = name[:-1] if name.endswith('/') else name
    if not cleaned:
        return ()
    if len(cleaned) > MAX_ZIP_PATH:
        fail('A ZIP entry path is too long.', 65)
    parts = tuple(cleaned.split('/'))
    if any(part in ('', '.', '..') or len(part.encode('utf-8')) > 255 for part in parts):
        fail(f'Unsafe ZIP entry path: {name!r}', 65)
    return parts


def replace_state_from_data(data: bytes, source_label: str) -> None:
    if ENABLED_FILE.exists():
        fail('HotPocket is already enabled. Use evdevkit for normal smart-contract deployment instead of this installer upload.', 66)
    if not data:
        fail(f'No smart contract ZIP data was received from {source_label}.', 65)
    if len(data) > MAX_ZIP_COMPRESSED:
        fail('Smart contract ZIP exceeds the 100 MiB compressed-size limit.', 65)
    parent = STATE_DIR.parent
    if not parent.is_dir() or parent.is_symlink():
        fail(f'HotPocket seed directory does not exist or is unsafe: {parent}', 67)
    if STATE_DIR.exists() and (STATE_DIR.is_symlink() or not STATE_DIR.is_dir()):
        fail(f'Refusing to replace non-directory HotPocket state path: {STATE_DIR}', 67)

    source = STATE_DIR if STATE_DIR.exists() else parent
    st = source.stat()
    uid, gid = st.st_uid, st.st_gid
    root_mode = stat.S_IMODE(st.st_mode) or 0o755
    staging: Path | None = None
    entries_count = 0
    try:
        with zipfile.ZipFile(io.BytesIO(data), 'r') as zf:
            infos = zf.infolist()
            if not infos:
                fail('The smart contract ZIP is empty.', 65)
            if len(infos) > MAX_ZIP_ENTRIES:
                fail(f'The smart contract ZIP contains too many entries (maximum {MAX_ZIP_ENTRIES}).', 65)
            validated: list[tuple[zipfile.ZipInfo, tuple[str, ...], bool]] = []
            expanded = 0
            files = 0
            for info in infos:
                if info.flag_bits & 0x1:
                    fail(f'Encrypted ZIP entries are not supported: {info.filename!r}', 65)
                parts = safe_zip_parts(info.filename)
                if not parts:
                    continue
                unix_mode = (info.external_attr >> 16) & 0xFFFF
                file_type = stat.S_IFMT(unix_mode)
                is_dir = info.is_dir() or file_type == stat.S_IFDIR
                if file_type not in (0, stat.S_IFREG, stat.S_IFDIR):
                    fail(f'Symlinks and special files are not allowed in the smart contract ZIP: {info.filename!r}', 65)
                if not is_dir:
                    files += 1
                    if info.file_size < 0 or info.file_size > MAX_ZIP_SINGLE_FILE:
                        fail(f'ZIP entry is too large: {info.filename!r}', 65)
                    expanded += info.file_size
                    if expanded > MAX_ZIP_EXPANDED:
                        fail('The expanded smart contract ZIP is too large (maximum 512 MiB).', 65)
                validated.append((info, parts, is_dir))
            if files == 0:
                fail('The smart contract ZIP does not contain any files.', 65)
            entries_count = len(validated)
            staging = Path(tempfile.mkdtemp(prefix='.state-upload-', dir=parent))
            os.chmod(staging, 0o700)
            for info, parts, is_dir in validated:
                dest = staging.joinpath(*parts)
                if is_dir:
                    dest.mkdir(parents=True, exist_ok=True)
                    continue
                dest.parent.mkdir(parents=True, exist_ok=True)
                written = 0
                with zf.open(info, 'r') as src, open(dest, 'xb') as dst:
                    while True:
                        chunk = src.read(1024 * 1024)
                        if not chunk:
                            break
                        written += len(chunk)
                        if written > info.file_size or written > MAX_ZIP_SINGLE_FILE:
                            fail(f'ZIP entry expanded beyond its declared safe size: {info.filename!r}', 65)
                        dst.write(chunk)
                if written != info.file_size:
                    fail(f'ZIP entry size did not match its declared size: {info.filename!r}', 65)
                archived = (info.external_attr >> 16) & 0o777
                os.chmod(dest, 0o755 if archived & 0o111 else 0o644)
            for current, dirs, files_list in os.walk(staging):
                current_path = Path(current)
                os.chown(current_path, uid, gid)
                if current_path == staging:
                    os.chmod(current_path, root_mode)
                else:
                    os.chmod(current_path, 0o755)
                for name in files_list:
                    path = current_path / name
                    os.chown(path, uid, gid)
    except zipfile.BadZipFile:
        if staging is not None:
            shutil.rmtree(staging, ignore_errors=True)
        fail(f'The selected smart contract file from {source_label} is not a valid ZIP archive.', 65)
    except BaseException:
        if staging is not None:
            shutil.rmtree(staging, ignore_errors=True)
        raise

    assert staging is not None
    backup = parent / f'.state-backup-{uuid.uuid4().hex}'
    had_target = STATE_DIR.exists()
    try:
        if had_target:
            os.rename(STATE_DIR, backup)
        os.rename(staging, STATE_DIR)
    except BaseException as exc:
        if STATE_DIR.exists() and not had_target:
            shutil.rmtree(STATE_DIR, ignore_errors=True)
        if had_target and backup.exists() and not STATE_DIR.exists():
            os.rename(backup, STATE_DIR)
        if staging.exists():
            shutil.rmtree(staging, ignore_errors=True)
        fail(f'Could not activate the uploaded smart contract state: {exc}', 75)
    if backup.exists():
        shutil.rmtree(backup)
    print(f'Replaced {STATE_DIR} with {entries_count} validated ZIP entries from {source_label}.')



def action_replace_state() -> None:
    data = sys.stdin.buffer.read(MAX_ZIP_COMPRESSED + 1)
    replace_state_from_data(data, 'browser upload')


def ensure_contract_zip_dir() -> None:
    if CONTRACT_ZIP_DIR.exists():
        if CONTRACT_ZIP_DIR.is_symlink() or not CONTRACT_ZIP_DIR.is_dir():
            fail(f'Contract ZIP library path is unsafe: {CONTRACT_ZIP_DIR}', 67)
        return
    try:
        CONTRACT_ZIP_DIR.mkdir(parents=True, mode=0o755)
        try:
            account = pwd.getpwnam('everlomp')
            os.chown(CONTRACT_ZIP_DIR, account.pw_uid, account.pw_gid)
        except KeyError:
            pass
        os.chmod(CONTRACT_ZIP_DIR, 0o755)
    except OSError as exc:
        fail(f'Could not create contract ZIP library {CONTRACT_ZIP_DIR}: {exc}', 75)


def safe_contract_zip_file(name: str) -> Path:
    name = name.strip()
    if not name or len(name.encode('utf-8')) > 255 or '\x00' in name or '/' in name or '\\' in name:
        fail('Choose a valid contract ZIP filename.', 65)
    if name in ('.', '..') or not name.lower().endswith('.zip'):
        fail('Saved smart contracts must be .zip files.', 65)
    ensure_contract_zip_dir()
    path = CONTRACT_ZIP_DIR / name
    try:
        st = path.lstat()
    except FileNotFoundError:
        fail(f'The saved contract ZIP no longer exists: {name}', 66)
    except OSError as exc:
        fail(f'Could not inspect saved contract ZIP {name}: {exc}', 75)
    if stat.S_ISLNK(st.st_mode) or not stat.S_ISREG(st.st_mode):
        fail(f'Refusing unsafe saved contract ZIP: {name}', 67)
    if st.st_size < 1 or st.st_size > MAX_ZIP_COMPRESSED:
        fail(f'Saved contract ZIP must be between 1 byte and 100 MiB: {name}', 65)
    return path


def action_list_contract_zips() -> None:
    ensure_contract_zip_dir()
    files: list[dict[str, int | str]] = []
    try:
        for entry in CONTRACT_ZIP_DIR.iterdir():
            try:
                st = entry.lstat()
            except OSError:
                continue
            if stat.S_ISLNK(st.st_mode) or not stat.S_ISREG(st.st_mode):
                continue
            if not entry.name.lower().endswith('.zip'):
                continue
            if st.st_size < 1 or st.st_size > MAX_ZIP_COMPRESSED:
                continue
            files.append({'name': entry.name, 'size': st.st_size, 'mtime': int(st.st_mtime)})
    except OSError as exc:
        fail(f'Could not read contract ZIP library {CONTRACT_ZIP_DIR}: {exc}', 75)
    files.sort(key=lambda item: (-int(item['mtime']), str(item['name']).lower()))
    print(json.dumps({'directory': str(CONTRACT_ZIP_DIR), 'files': files}, ensure_ascii=False))


def action_deploy_contract_zip() -> None:
    if ENABLED_FILE.exists():
        fail('HotPocket is already enabled. Use evdevkit for normal smart-contract deployment instead of this installer library.', 66)
    payload = read_json_stdin()
    name = payload.get('name')
    if not isinstance(name, str):
        fail('Choose a saved contract ZIP to deploy.', 65)
    path = safe_contract_zip_file(name)
    try:
        with path.open('rb') as handle:
            data = handle.read(MAX_ZIP_COMPRESSED + 1)
    except OSError as exc:
        fail(f'Could not read saved contract ZIP {name}: {exc}', 75)
    if len(data) > MAX_ZIP_COMPRESSED:
        fail('Smart contract ZIP exceeds the 100 MiB compressed-size limit.', 65)
    replace_state_from_data(data, f'saved ZIP {name}')


def supervisor(*args: str, check: bool = False) -> subprocess.CompletedProcess[str]:
    return subprocess.run([str(SUPERVISORCTL), '-c', str(SUPERVISOR_CONF), *args], text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, check=check)


def action_enable() -> None:
    ENABLED_FILE.parent.mkdir(parents=True, exist_ok=True)
    if not SUPERVISOR_CONF.is_file() or SUPERVISOR_CONF.is_symlink():
        fail(f'Supervisor configuration is missing: {SUPERVISOR_CONF}', 2)
    if not SUPERVISORCTL.is_file() or not os.access(SUPERVISORCTL, os.X_OK):
        fail(f'supervisorctl is unavailable: {SUPERVISORCTL}', 3)
    original = read_text(SUPERVISOR_CONF)
    match = re.search(r'(?ms)^\[program:hotpocket\]\s*$.*?(?=^\[|\Z)', original)
    if not match:
        fail('Supervisor [program:hotpocket] section was not found.', 4)
    section = match.group(0)
    if re.search(r'(?m)^\s*autostart\s*=', section):
        section = re.sub(r'(?m)^\s*autostart\s*=.*$', 'autostart=true', section, count=1)
    else:
        nl = section.find('\n')
        section = section[:nl + 1] + 'autostart=true\n' + section[nl + 1:]
    updated = original[:match.start()] + section + original[match.end():]
    write_preserving(SUPERVISOR_CONF, updated)

    def rollback() -> None:
        try:
            write_preserving(SUPERVISOR_CONF, original)
            supervisor('reread')
            supervisor('update')
        except BaseException:
            pass

    try:
        for command in ('reread', 'update'):
            result = supervisor(command)
            if result.stdout:
                print(result.stdout.rstrip())
            if result.returncode != 0:
                raise RuntimeError(f'Supervisor {command} failed.')
    except BaseException as exc:
        rollback()
        fail(str(exc), 5)

    atomic_write(ENABLED_FILE, 'enabled\n', mode=0o644)
    status = supervisor('status', 'hotpocket').stdout
    if 'STOPPED' in status:
        result = supervisor('start', 'hotpocket')
        if result.stdout:
            print(result.stdout.rstrip())
        if result.returncode != 0:
            fail('HotPocket is enabled for autostart, but the immediate start command failed.', 7)
    for _ in range(45):
        status = supervisor('status', 'hotpocket').stdout.strip()
        print(f'[Everlomp] {status}')
        if 'RUNNING' in status:
            print('[Everlomp] HotPocket is enabled, autostart=true, and RUNNING.')
            return
        if re.search(r'BACKOFF|FATAL|EXITED', status):
            fail('HotPocket is enabled for autostart, but the process failed before reaching RUNNING.', 8)
        time.sleep(1)
    fail('HotPocket is enabled for autostart, but did not reach RUNNING within 45 seconds.', 9)


def main() -> None:
    require_root()
    action = sys.argv[1] if len(sys.argv) > 1 else ''
    if len(sys.argv) != 2:
        fail('Usage: everlomp-hotpocket enable|add-listener|replace-state|list-contract-zips|deploy-contract-zip|configure-site|list-site-dirs|finalize-site|read-config|write-config', 64)
    if action == 'enable':
        action_enable()
    elif action == 'add-listener':
        action_add_listener()
    elif action == 'replace-state':
        action_replace_state()
    elif action == 'list-contract-zips':
        action_list_contract_zips()
    elif action == 'deploy-contract-zip':
        action_deploy_contract_zip()
    elif action == 'configure-site':
        action_configure_site()
    elif action == 'list-site-dirs':
        action_list_site_dirs()
    elif action == 'finalize-site':
        action_finalize_site()
    elif action == 'read-config':
        action_read_config()
    elif action == 'write-config':
        action_write_config()
    else:
        fail('Usage: everlomp-hotpocket enable|add-listener|replace-state|list-contract-zips|deploy-contract-zip|configure-site|list-site-dirs|finalize-site|read-config|write-config', 64)


if __name__ == '__main__':
    main()
