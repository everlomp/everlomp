raw = config_match.group(1).strip().strip("\"'")
raw = raw.replace("$SERVER_ROOT", str(server_root))
raw = raw.replace("$VH_NAME", vhost_name)

candidate = Path(raw)
if not candidate.is_absolute():
    candidate = server_root / candidate

try:
    vhost_conf = candidate.resolve()
except Exception:
    vhost_conf = Path(os.path.normpath(str(candidate)))

if not vhost_conf.is_file():
    print(
        f"OpenLiteSpeed vhost configuration does not exist: {vhost_conf}",
        file=sys.stderr,
    )
    raise SystemExit(1)

print(vhost_name)
print(vhost_conf)
