def block_ranges(kind):
    result = []
    i = 0
    opener = re.compile(r"^\s*" + re.escape(kind) + r"\s+([^\s{]+)\s*\{\s*(?:#.*)?$")
    while i < len(lines):
        match = opener.match(lines[i])
        if not match:
            i += 1
            continue

        name = match.group(1)
        start = i
        depth = 0
        opened = False
        j = i

        while j < len(lines):
            code = lines[j].split("#", 1)[0]
            if "{" in code:
                opened = True
            depth += code.count("{")
            depth -= code.count("}")

            if opened and depth == 0:
                break
            j += 1

        if j >= len(lines):
            print(f"Unterminated OpenLiteSpeed {kind} block: {name}", file=sys.stderr)
            raise SystemExit(1)

        result.append((name, start, j))
        i = j + 1

    return result


def domain_score(pattern, candidate_host):
    pattern = pattern.strip().lower().rstrip(".")
    if not pattern:
        return 0

    if pattern == candidate_host:
        return 300

    if pattern == "*":
        return 100

    if "*" in pattern and fnmatch.fnmatchcase(candidate_host, pattern):
        # Prefer more specific wildcard mappings.
        return 200 + min(len(pattern.replace("*", "")), 90)

    return 0



def configured_listener_port(start, end):
    for line in lines[start + 1:end]:
        match = re.match(r"^\s*address\s+([^\s#]+)", line)
        if not match:
            continue

        address = match.group(1).strip().strip('"\'')

        # OLS normally uses forms such as *:8088, 0.0.0.0:443 or [::]:443.
        port_match = re.search(r":([0-9]{1,5})$", address)
        if port_match:
            port = int(port_match.group(1))
            if 1 <= port <= 65535:
                return port

        # Be conservative if a config contains only a numeric port.
        if address.isdigit():
            port = int(address)
            if 1 <= port <= 65535:
                return port

    return None


matches = []

for listener_name, start, end in block_ranges("listener"):
    listener_port = configured_listener_port(start, end)
    for line in lines[start + 1:end]:
        match = re.match(r"^\s*map\s+([^\s]+)\s+(.+?)\s*(?:#.*)?$", line)
        if not match:
            continue

        vhost_name = match.group(1)
        domain_text = match.group(2)
        domains = [
            item.strip()
            for item in re.split(r"[\s,]+", domain_text)
            if item.strip()
        ]

        best = max((domain_score(domain, host) for domain in domains), default=0)
        if best:
            matches.append((listener_port == request_port, best, vhost_name, listener_name, listener_port))

