block_text = "".join(lines[start:end + 1])
config_match = re.search(r"(?m)^\s*configFile\s+([^\s#]+)", block_text)

if not config_match:
    print(
        f"virtualHost {vhost_name} has no configFile directive.",
        file=sys.stderr,
    )
