from pathlib import Path
import re
import sys

path = Path(sys.argv[1])
uri = sys.argv[2]
text = path.read_text(encoding="utf-8")
lines = text.splitlines(keepends=True)

marker = f"# Everlomp listener rewrite bypass: {uri}"
if marker in text:
    raise SystemExit(0)

# OLS vhost-level rewrite rules match the URL path including an optional
# leading slash.
relative = uri.strip("/")
pattern = "^/?" + re.escape(relative)
if uri.endswith("/"):
    pattern += "(?:/|$)"
else:
    pattern += "(?:/|$)"

# Find a top-level rewrite block. Do not manufacture one if the vhost has none;
# the static context's rewrite disable is sufficient in that case.
depth = 0
rewrite_start = None
rewrite_end = None

for i, line in enumerate(lines):
    code = line.split("#", 1)[0]
    stripped = code.strip()

    if depth == 0 and re.match(r"^rewrite\s*\{\s*$", stripped):
        rewrite_start = i
        local_depth = code.count("{") - code.count("}")
        j = i + 1
        while j < len(lines):
            next_code = lines[j].split("#", 1)[0]
            local_depth += next_code.count("{") - next_code.count("}")
            if local_depth == 0:
                rewrite_end = j
                break
            j += 1
        break

    depth += code.count("{") - code.count("}")

if rewrite_start is None or rewrite_end is None:
    raise SystemExit(0)

indent = re.match(r"^(\s*)", lines[rewrite_start]).group(1) + "  "
newline = "\r\n" if lines[rewrite_start].endswith("\r\n") else "\n"

insert_at = rewrite_end
for line_no in range(rewrite_start + 1, rewrite_end):
    stripped = lines[line_no].strip()
    if re.match(r"^(?:RewriteRule|RewriteCond|RewriteFile)\b", stripped, re.IGNORECASE):
        insert_at = line_no
        break

lines[insert_at:insert_at] = [
    f"{indent}{marker}{newline}",
    f"{indent}RewriteRule {pattern} - [L]{newline}",
]

path.write_text("".join(lines), encoding="utf-8")
