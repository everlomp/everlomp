#!/usr/bin/env python3
"""Everlomp HotPocket privileged helper.

Actions:
  enable          Enable/autostart HotPocket under Supervisor and start it.
  add-listener    Add a smart-contract listenerURL to the active OLS vhost.
  replace-state   Safely replace /contract/contract_fs/seed/state from ZIP stdin.
  list-contract-zips List deployable ZIP files from /home/everlomp/hotpocket-contracts.
  deploy-contract-zip Deploy one saved ZIP from /home/everlomp/hotpocket-contracts.
  configure-site  Save the future website root/subfolder/index selection without switching OLS yet.
  list-site-dirs List safe existing subfolders under seed/state and seed.
  finalize-site   Apply the saved website root at final installer cleanup.
  read-config     Read /contract/cfg/hp.cfg as JSON.
  write-config    Atomically replace /contract/cfg/hp.cfg from JSON stdin before startup.
"""

