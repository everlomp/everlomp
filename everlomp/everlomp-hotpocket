def fail(message: str, code: int = 1) -> NoReturn:
    print(message, file=sys.stderr)
    raise SystemExit(code)


def require_root() -> None:
    if os.geteuid() != 0:
        fail('This helper must run as root through sudo.', 77)


def read_text(path: Path) -> str:
    try:
        return path.read_text(encoding='utf-8')
    except OSError as exc:
        fail(f'Could not read {path}: {exc}')


def atomic_write(path: Path, data: str, *, mode: int | None = None, uid: int | None = None, gid: int | None = None) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temp_name = tempfile.mkstemp(prefix='.' + path.name + '.', dir=path.parent)
    temp = Path(temp_name)
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as handle:
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())
        if mode is not None:
            os.chmod(temp, mode)
        if uid is not None or gid is not None:
            os.chown(temp, -1 if uid is None else uid, -1 if gid is None else gid)
        os.replace(temp, path)
    except BaseException:
        try:
            temp.unlink(missing_ok=True)
        except OSError:
            pass
        raise


def read_json_stdin() -> dict:
    raw = sys.stdin.buffer.read(MAX_JSON_STDIN + 1)
    if not raw:
        fail('No configuration payload was received.', 65)
    if len(raw) > MAX_JSON_STDIN:
        fail('Configuration payload is too large.', 65)
    try:
        value = json.loads(raw.decode('utf-8'))
    except (UnicodeDecodeError, json.JSONDecodeError):
        fail('Configuration payload is not valid JSON.', 65)
    if not isinstance(value, dict):
        fail('Configuration payload must be a JSON object.', 65)
    return value


def block_ranges(lines: list[str], kind: str) -> list[tuple[str, int, int]]:
    opener = re.compile(r'^\s*' + re.escape(kind) + r'\s+([^\s{]+)\s*\{\s*(?:#.*)?$')
    result: list[tuple[str, int, int]] = []
    i = 0
    while i < len(lines):
        match = opener.match(lines[i])
        if not match:
            i += 1
            continue
        name = match.group(1)
        start = i
        depth = 0
        opened = False
        j = i
        while j < len(lines):
            code = lines[j].split('#', 1)[0]
            if '{' in code:
                opened = True
            depth += code.count('{')
            depth -= code.count('}')
            if opened and depth == 0:
                break
            j += 1
        if j >= len(lines):
            fail(f'Unterminated OpenLiteSpeed {kind} block: {name}', 69)
        result.append((name, start, j))
        i = j + 1
    return result


def listener_port(lines: list[str], start: int, end: int) -> int | None:
    for line in lines[start + 1:end]:
        match = re.match(r'^\s*address\s+([^\s#]+)', line)
        if not match:
            continue
        address = match.group(1).strip().strip('"\'')
        found = re.search(r':([0-9]{1,5})$', address)
        if found:
            port = int(found.group(1))
            return port if 1 <= port <= 65535 else None
        if address.isdigit():
            port = int(address)
            return port if 1 <= port <= 65535 else None
    return None


def domain_score(pattern: str, host: str) -> int:
    pattern = pattern.strip().lower().rstrip('.')
    if pattern == host:
        return 300
    if pattern == '*':
        return 100
    if '*' in pattern and fnmatch.fnmatchcase(host, pattern):
        return 200 + min(len(pattern.replace('*', '')), 90)
    return 0


def resolve_vhost(host: str, request_port: int) -> tuple[str, Path]:
    host = host.strip().lower().rstrip('.')
    if not host or len(host) > 253 or not re.fullmatch(r'[a-z0-9.-]+', host):
        fail('A valid current domain is required to identify the OpenLiteSpeed vhost.', 69)
    if request_port < 1 or request_port > 65535:
        fail('A valid current listener port is required to identify the OpenLiteSpeed vhost.', 69)
    if not SERVER_CONF.is_file() or SERVER_CONF.is_symlink():
        fail(f'OpenLiteSpeed server configuration is missing: {SERVER_CONF}', 68)

    text = read_text(SERVER_CONF)
    lines = text.splitlines(keepends=True)
    matches: list[tuple[bool, int, str, str, int | None]] = []
    for listener_name, start, end in block_ranges(lines, 'listener'):
        port = listener_port(lines, start, end)
        for line in lines[start + 1:end]:
            match = re.match(r'^\s*map\s+([^\s]+)\s+(.+?)\s*(?:#.*)?$', line)
            if not match:
                continue
            vhost_name = match.group(1)
            domains = [item.strip() for item in re.split(r'[\s,]+', match.group(2)) if item.strip()]
            score = max((domain_score(item, host) for item in domains), default=0)
            if score:
                matches.append((port == request_port, score, vhost_name, listener_name, port))

    if not matches:
        fail(f'No OpenLiteSpeed listener mapping matches host {host}.', 69)
    port_matches = [item for item in matches if item[0]]
    candidates = port_matches if port_matches else matches
    best_score = max(item[1] for item in candidates)
    top = [item for item in candidates if item[1] == best_score]
    names = sorted({item[2] for item in top})
    if len(names) != 1:
        detail = ', '.join(sorted(f'{item[2]} via {item[3]}:{item[4] or "?"}' for item in top))
        fail(f'OpenLiteSpeed host mapping is ambiguous for {host} on request port {request_port}: {detail}', 69)
    vhost_name = names[0]

    blocks = [(name, start, end) for name, start, end in block_ranges(lines, 'virtualHost') if name == vhost_name]
    if len(blocks) != 1:
        fail(f'Could not uniquely find virtualHost {vhost_name} in {SERVER_CONF}.', 69)
    _, start, end = blocks[0]
    block = ''.join(lines[start:end + 1])
    found = re.search(r'(?m)^\s*configFile\s+([^\s#]+)', block)
    if not found:
        fail(f'virtualHost {vhost_name} has no configFile directive.', 69)
    raw = found.group(1).strip().strip('"\'')
    raw = raw.replace('$SERVER_ROOT', str(SERVER_ROOT)).replace('$VH_NAME', vhost_name)
    path = Path(raw)
    if not path.is_absolute():
        path = SERVER_ROOT / path
    path = Path(os.path.normpath(str(path)))
    if not path.is_file() or path.is_symlink():
        fail(f'OpenLiteSpeed vhost configuration does not exist or is unsafe: {path}', 69)
    return vhost_name, path


def set_vhost_restrained(text: str, vhost_name: str, value: int = 0) -> str:
    lines = text.splitlines(keepends=True)
    matches = [(start, end) for name, start, end in block_ranges(lines, 'virtualHost') if name == vhost_name]
    if len(matches) != 1:
        fail(f'Could not uniquely identify virtualHost {vhost_name}.', 71)
    start, end = matches[0]
    restrained = None
    for n in range(start + 1, end):
        if re.match(r'^\s*restrained\s+\S+', lines[n]):
            restrained = n
            break
    if restrained is not None:
        indent = re.match(r'^(\s*)', lines[restrained]).group(1)
        newline = '\r\n' if lines[restrained].endswith('\r\n') else '\n'
        lines[restrained] = f'{indent}restrained              {value}{newline}'
    else:
        indent = '    '
        for n in range(start + 1, end):
            if re.match(r'^\s*(?:vhRoot|configFile|allowSymbolLink|enableScript)\s+', lines[n]):
                indent = re.match(r'^(\s*)', lines[n]).group(1)
                break
        newline = '\r\n' if lines[end].endswith('\r\n') else '\n'
        lines.insert(end, f'{indent}restrained              {value}{newline}')
    return ''.join(lines)


def add_rewrite_bypass(text: str, uri: str) -> str:
    marker = f'# Everlomp listener rewrite bypass: {uri}'
    if marker in text:
        return text
    lines = text.splitlines(keepends=True)
    depth = 0
    rewrite_start = rewrite_end = None
    for i, line in enumerate(lines):
        code = line.split('#', 1)[0]
        stripped = code.strip()
        if depth == 0 and re.match(r'^rewrite\s*\{\s*$', stripped):
            rewrite_start = i
            local_depth = code.count('{') - code.count('}')
            j = i + 1
            while j < len(lines):
                next_code = lines[j].split('#', 1)[0]
                local_depth += next_code.count('{') - next_code.count('}')
                if local_depth == 0:
                    rewrite_end = j
                    break
                j += 1
            break
        depth += code.count('{') - code.count('}')
    if rewrite_start is None or rewrite_end is None:
        return text
    indent = re.match(r'^(\s*)', lines[rewrite_start]).group(1) + '  '
    newline = '\r\n' if lines[rewrite_start].endswith('\r\n') else '\n'
    relative = uri.strip('/')
    pattern = '^/?' + re.escape(relative) + '(?:/|$)'
    insert_at = rewrite_end
    for n in range(rewrite_start + 1, rewrite_end):
        if re.match(r'^(?:RewriteRule|RewriteCond|RewriteFile)\b', lines[n].strip(), re.I):
            insert_at = n
            break
    lines[insert_at:insert_at] = [f'{indent}{marker}{newline}', f'{indent}RewriteRule {pattern} - [L]{newline}']
    return ''.join(lines)


def ols_test() -> tuple[bool, str, int]:
    if not OPENLITESPEED.is_file() or not os.access(OPENLITESPEED, os.X_OK):
        return False, 'OpenLiteSpeed binary is unavailable.', 127
    result = subprocess.run([str(OPENLITESPEED), '-t'], text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=30)
    # Existing Everlomp behavior accepts 0 and 1; OLS may use 1 for warnings.
    return result.returncode in (0, 1), result.stdout.strip(), result.returncode


def ols_restart() -> tuple[bool, str]:
    if not LSWSCTRL.is_file() or not os.access(LSWSCTRL, os.X_OK):
        return False, 'OpenLiteSpeed control utility is unavailable.'
    result = subprocess.run([str(LSWSCTRL), 'restart'], text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=60)
    return result.returncode == 0, result.stdout.strip()


def write_preserving(path: Path, text: str) -> None:
    st = path.stat()
    atomic_write(path, text, mode=stat.S_IMODE(st.st_mode), uid=st.st_uid, gid=st.st_gid)


def validate_relative_path(value: str, label: str) -> str:
    value = value.strip().strip('/')
    if len(value) > 240:
        fail(f'{label} is too long.', 65)
    if not value:
        return ''
    for part in value.split('/'):
        if not part or part in ('.', '..') or not PATH_COMPONENT_RE.fullmatch(part):
            fail(f'{label} contains an invalid path component.', 65)
    return value


def action_add_listener() -> None:
    payload = read_json_stdin()
    namespace = str(payload.get('namespace', 'evernode')).strip().lower()
    path = validate_relative_path(str(payload.get('path', payload.get('url_suffix', ''))), 'listenerURL path')
    scope = str(payload.get('scope', '')).strip()
    index_file = str(payload.get('index_file', 'index.html')).strip() or 'index.html'
    host = str(payload.get('host', '')).strip().lower()
    try:
        port = int(payload.get('port', 0))
    except (TypeError, ValueError):
        port = 0
    if namespace not in ('evernode', 'hotpocket'):
        fail('Listener namespace must be evernode or hotpocket.', 65)
    if scope not in ('state', 'seed'):
        fail('Listener scope must be state or seed.', 65)
    if not INDEX_RE.fullmatch(index_file):
        fail('Invalid index filename. Example: index.html', 65)
    if scope == 'seed' and (path == 'state' or path.startswith('state/')):
        fail('A seed listener may not target state/. Choose the state scope instead.', 65)

    base = STATE_DIR if scope == 'state' else SEED_DIR
    if not base.is_dir() or base.is_symlink():
        fail(f'Contract directory does not exist or is unsafe: {base}', 67)
    target = base.joinpath(*path.split('/')) if path else base
    if target != base:
        source = base.stat()
        target.mkdir(parents=True, exist_ok=True)
        os.chown(target, source.st_uid, source.st_gid)
        os.chmod(target, stat.S_IMODE(source.st_mode))
    uri = f'/{namespace}/' + (path + '/' if path else '')
    location = str(target) + '/'

    vhost_name, vhost_conf = resolve_vhost(host, port)
    vhost_text = read_text(vhost_conf)
    if re.search(r'(?m)^\s*context\s+' + re.escape(uri) + r'\s*\{', vhost_text):
        fail(f'listenerURL already exists: {uri}', 70)
    server_original = read_text(SERVER_CONF)
    vhost_original = vhost_text
    server_new = set_vhost_restrained(server_original, vhost_name, 0)
    vhost_new = add_rewrite_bypass(vhost_original, uri)
    if not vhost_new.endswith('\n'):
        vhost_new += '\n'
    vhost_new += (
        f'# Everlomp smart-contract listenerURL\n'
        f'context {uri} {{\n'
        f'    location                {location}\n'
        f'    allowBrowse             1\n'
        f'    indexFiles              {index_file}\n\n'
        f'    rewrite  {{\n'
        f'        enable              0\n'
        f'        inherit             0\n'
        f'    }}\n'
        f'}}\n'
    )
    try:
        write_preserving(SERVER_CONF, server_new)
        write_preserving(vhost_conf, vhost_new)
        ok, detail, code = ols_test()
        if detail:
            print(detail, file=sys.stderr)
        if not ok:
            raise RuntimeError(f'OpenLiteSpeed rejected the listenerURL configuration (test exit {code}).')
        ok, detail = ols_restart()
        if not ok:
            raise RuntimeError('OpenLiteSpeed restart failed' + (f': {detail}' if detail else '.'))
    except BaseException as exc:
        try:
            write_preserving(SERVER_CONF, server_original)
            write_preserving(vhost_conf, vhost_original)
            ols_restart()
        except BaseException:
            pass
        fail(str(exc), 75)

    print('[Everlomp] listenerURL added successfully.')
    print(f'{uri} -> {location} (index: {index_file})')


def rewrite_site_vhost(text: str, document_root: Path, indexes: list[str]) -> str:
    lines = text.splitlines(keepends=True)
    roots = [i for i, line in enumerate(lines) if re.match(r'^\s*docRoot\s+', line)]
    if len(roots) != 1:
        fail(f'Expected exactly one docRoot directive in the selected OpenLiteSpeed vhost, found {len(roots)}.', 71)
    pos = roots[0]
    indent = re.match(r'^(\s*)', lines[pos]).group(1)
    newline = '\r\n' if lines[pos].endswith('\r\n') else '\n'
    lines[pos] = f'{indent}docRoot                   {document_root}/{newline}'

    index_start = index_end = None
    for i, line in enumerate(lines):
        match = re.match(r'^(\s*)index\s*\{\s*(?:\r?\n)?$', line)
        if not match:
            continue
        block_indent = match.group(1)
        depth = line.count('{') - line.count('}')
        j = i + 1
        while j < len(lines):
            depth += lines[j].split('#', 1)[0].count('{') - lines[j].split('#', 1)[0].count('}')
            if depth == 0:
                index_start, index_end = i, j
                break
            j += 1
        if index_start is not None:
            break
    value = ','.join(indexes)
    if index_start is None or index_end is None:
        if lines and not lines[-1].endswith('\n'):
            lines[-1] += '\n'
        lines.extend(['\n', 'index  {\n', '  useServer               0\n', f'  indexFiles              {value}\n', '}\n'])
    else:
        found = [i for i in range(index_start + 1, index_end) if re.match(r'^\s*indexFiles\s+', lines[i])]
        if len(found) > 1:
            fail('The OpenLiteSpeed index block contains multiple indexFiles directives; refusing an ambiguous edit.', 71)
        if found:
            i = found[0]
            child_indent = re.match(r'^(\s*)', lines[i]).group(1)
            newline = '\r\n' if lines[i].endswith('\r\n') else '\n'
            lines[i] = f'{child_indent}indexFiles              {value}{newline}'
        else:
            block_indent = re.match(r'^(\s*)', lines[index_start]).group(1)
            lines.insert(index_end, f'{block_indent}  indexFiles              {value}\n')
    return ''.join(lines)


def normalize_site_subfolder(value: object) -> tuple[str, list[str]]:
    if value is None:
        return '', []
    if not isinstance(value, str):
        fail('subfolder must be text.', 65)
    raw = value.strip()
    if raw == '':
        return '', []
    if len(raw) > MAX_SUBFOLDER_PATH or raw.startswith('/') or '\\' in raw or '//' in raw:
        fail('Subfolder must be a relative path such as public or public/html.', 65)
    parts = raw.split('/')
    for part in parts:
        if part in ('', '.', '..') or len(part) > 128 or not PATH_COMPONENT_RE.fullmatch(part):
            fail('Subfolder contains an invalid path component.', 65)
    return '/'.join(parts), parts


def site_root(scope: str, subfolder: object, *, require_exists: bool) -> tuple[Path, str]:
    base = STATE_DIR if scope == 'state' else SEED_DIR
    if not base.is_dir() or base.is_symlink():
        fail(f'Refusing unavailable or symlinked website base: {base}', 67)
    normalized, parts = normalize_site_subfolder(subfolder)
    current = base
    missing_seen = False
    for part in parts:
        current = current / part
        if missing_seen:
            continue
        if current.exists():
            if current.is_symlink():
                fail(f'Refusing symlinked website path component: {current}', 67)
            if not current.is_dir():
                fail(f'Website path component is not a directory: {current}', 67)
        else:
            missing_seen = True
            if require_exists:
                fail(f'The selected website directory does not exist: {current}', 67)
    if require_exists and (not current.is_dir() or current.is_symlink()):
        fail(f'The selected website directory is unavailable or unsafe: {current}', 67)
    return current, normalized


def validate_site_payload(payload: dict, *, require_root_exists: bool = False) -> tuple[str, Path, str, list[str], str, int]:
    scope = str(payload.get('scope', '')).strip()
    if scope not in ('state', 'seed'):
        fail('Website root must be exactly seed/state or seed.', 65)
    root, subfolder = site_root(scope, payload.get('subfolder', ''), require_exists=require_root_exists)
    raw_indexes = payload.get('index_files')
    if not isinstance(raw_indexes, list):
        fail('index_files must be a list.', 65)
    indexes: list[str] = []
    for value in raw_indexes:
        if not isinstance(value, str):
            fail('Every index filename must be text.', 65)
        name = value.strip()
        if not INDEX_RE.fullmatch(name):
            fail(f'Invalid index filename: {name!r}', 65)
        if name not in indexes:
            indexes.append(name)
    if not indexes:
        fail('At least one index filename is required.', 65)
    if len(indexes) > MAX_INDEX_FILES:
        fail(f'Use no more than {MAX_INDEX_FILES} index filenames.', 65)
    host = str(payload.get('host', '')).strip().lower()
    try:
        port = int(payload.get('port', 0))
    except (TypeError, ValueError):
        port = 0
    return scope, root, subfolder, indexes, host, port


def safe_site_subdirectories(base: Path) -> list[str]:
    if not base.is_dir() or base.is_symlink():
        return []
    results: list[str] = []
    stack: list[tuple[Path, int]] = [(base, 0)]
    while stack and len(results) < MAX_SITE_DIRS:
        current, depth = stack.pop()
        if depth >= MAX_SITE_DEPTH:
            continue
        try:
            children = sorted(current.iterdir(), key=lambda item: item.name.lower(), reverse=True)
        except OSError:
            continue
        for child in children:
            if len(results) >= MAX_SITE_DIRS:
                break
            try:
                if child.is_symlink() or not child.is_dir():
                    continue
            except OSError:
                continue
            try:
                relative = child.relative_to(base).as_posix()
            except ValueError:
                continue
            if len(relative) > MAX_SUBFOLDER_PATH:
                continue
            parts = relative.split('/')
            if any(part in ('', '.', '..') or len(part) > 128 or not PATH_COMPONENT_RE.fullmatch(part) for part in parts):
                continue
            results.append(relative)
            stack.append((child, depth + 1))
    return sorted(set(results), key=lambda value: (value.count('/'), value.lower()))


def action_list_site_dirs() -> None:
    print(json.dumps({
        'state': safe_site_subdirectories(STATE_DIR),
        'seed': safe_site_subdirectories(SEED_DIR),
    }, separators=(',', ':')))


def action_configure_site() -> None:
    payload = read_json_stdin()
    scope, root, subfolder, indexes, host, port = validate_site_payload(payload)

    current_primary = PRIMARY_APP_FILE.read_text(encoding='utf-8').strip() if PRIMARY_APP_FILE.is_file() else ''
    if current_primary not in ('', 'hotpocket-folder'):
        fail(f'A different primary application is already configured: {current_primary}', 66)

    # Resolve and parse the vhost now so a bad/ambiguous setup is rejected while
    # the installer is still reachable, but DO NOT modify or restart OLS here.
    vhost_name, vhost_conf = resolve_vhost(host, port)
    server_original = read_text(SERVER_CONF)
    vhost_original = read_text(vhost_conf)
    set_vhost_restrained(server_original, vhost_name, 0)
    rewrite_site_vhost(vhost_original, root, indexes)

    info = {
        'configured': False,
        'staged': True,
        'scope': scope,
        'subfolder': subfolder,
        'document_root': str(root),
        'index_files': indexes,
        'host': host,
        'port': port,
        'vhost': vhost_name,
        'vhost_config': str(vhost_conf),
    }
    atomic_write(SITE_INFO_FILE, json.dumps(info, indent=2, sort_keys=True) + '\n', mode=0o644)
    atomic_write(PRIMARY_APP_FILE, 'hotpocket-folder\n', mode=0o644)
    print(f'HotPocket website selection saved for {root}. It will be activated when the Everlomp installer is removed.')


def load_site_info() -> dict:
    if not SITE_INFO_FILE.is_file() or SITE_INFO_FILE.is_symlink():
        fail('The saved HotPocket website selection is missing or unsafe.', 67)
    try:
        value = json.loads(SITE_INFO_FILE.read_text(encoding='utf-8'))
    except (OSError, json.JSONDecodeError) as exc:
