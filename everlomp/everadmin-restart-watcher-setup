def atomic_json(path: Path, value: dict, mode: int = 0o644, preserve_owner_from: Path | None = None) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temp_name = tempfile.mkstemp(prefix='.' + path.name + '.', dir=path.parent)
    tmp = Path(temp_name)
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as handle:
            handle.write(json.dumps(value, indent=2, sort_keys=True) + '\n')
            handle.flush()
            os.fsync(handle.fileno())
        target_mode = mode
        uid = gid = None
        source = preserve_owner_from if preserve_owner_from and preserve_owner_from.exists() else (path if path.exists() else None)
        if source is not None:
            st = source.stat()
            target_mode = stat.S_IMODE(st.st_mode) if preserve_owner_from else mode
            uid, gid = st.st_uid, st.st_gid
        os.chmod(tmp, target_mode)
        if uid is not None and gid is not None:
            os.chown(tmp, uid, gid)
        os.replace(tmp, path)
    except BaseException:
        try:
            tmp.unlink(missing_ok=True)
        except OSError:
            pass
        raise


def queue_writer_info() -> list[dict]:
    out = []
    seen = set()
    for path in QUEUE_DIRS:
        try:
            if not path.is_dir() or path.is_symlink():
                continue
            real = str(path.resolve())
            if real in seen:
                continue
            seen.add(real)
            st = path.stat()
            try:
                owner = pwd.getpwuid(st.st_uid).pw_name
            except Exception:
                owner = str(st.st_uid)
            out.append({'path': str(path), 'owner': owner, 'uid': st.st_uid, 'gid': st.st_gid, 'mode': oct(stat.S_IMODE(st.st_mode))})
        except OSError:
            continue
    return out


def write_status(value: dict) -> None:
    value = dict(value)
    value.setdefault('schemaVersion', 2)
    value['protocolVersion'] = PROTOCOL_VERSION
    value['capabilities'] = ['restart-hotpocket', 'recover-hotpocket', 'status-heartbeat', 'audit-trail', 'queued-requests', 'web-owned-queue']
    value['watcherPid'] = os.getpid()
    value['queueWriters'] = queue_writer_info()
    for path in STATUS_PATHS:
        try:
            atomic_json(path, value, 0o644)
        except OSError as exc:
            log(f'could not write status {path}: {exc}')


def write_alias_json(paths: list[Path], value: dict) -> None:
    for path in paths:
        try:
            atomic_json(path, value, 0o644)
        except OSError as exc:
            log(f'could not write audit {path}: {exc}')


def write_received_audit(request: dict, request_path: Path) -> None:
    write_alias_json(LAST_REQUEST_PATHS, {
        'schemaVersion': 1,
        'phase': 'request-received',
        'receivedAt': int(time.time() * 1000),
        'requestId': request.get('requestId'),
        'requestPath': str(request_path),
        'request': request,
    })


def write_consumed_audit(request: dict, request_path: Path) -> None:
